<!-- Forteller at dette er et ASP.NET Core webprosjekt -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>

    <!-- Prosjektet bruker .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Hjelper med å unngå feil med null-verdier -->
    <Nullable>enable</Nullable>

    <!-- Gjør at vanlige using-linjer legges til automatisk -->
    <ImplicitUsings>enable</ImplicitUsings>

    <UserSecretsId>17684ef3-fdb8-44ef-a662-7b7398a77623</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>

    <!-- Gjør at filer i testmappen ikke blir en del av hovedprosjektet -->
    <Compile Remove="FirstWebAppInDocker.Tests/**" />

  </ItemGroup>


  <ItemGroup>

    <!-- EF Core-verktøy for blant annet migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>
        runtime; build; native; contentfiles; analyzers; buildtransitive
      </IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Gjør at EF Core kan kommunisere med MariaDB/MySQL -->
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.11" />

  </ItemGroup>

</Project>