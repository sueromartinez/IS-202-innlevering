<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>

    <!-- Prosjektet bruker .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Håndtering av null-verdier -->
    <Nullable>enable</Nullable>

    <!-- Automatiske using-direktiver -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- User Secrets -->
    <UserSecretsId>17684ef3-fdb8-44ef-a662-7b7398a77623</UserSecretsId>

    <!--
      Viktig:
      Ekskluder hele testprosjektet fra
      hovedprosjektets automatiske filinkludering.

      Hindrer at testprosjektets bin/obj-filer
      kopieres rekursivt under bygging.
    -->
    <DefaultItemExcludes>
      $(DefaultItemExcludes);FirstWebAppInDocker.Tests/**
    </DefaultItemExcludes>

  </PropertyGroup>


  <ItemGroup>

    <!--
      Testprosjektet skal bygges separat.
      Ingen filer fra testmappen skal inkluderes
      som kode, innhold eller ressurser i webappen.
    -->

    <Compile Remove="FirstWebAppInDocker.Tests/**" />

    <Content Remove="FirstWebAppInDocker.Tests/**" />

    <None Remove="FirstWebAppInDocker.Tests/**" />

    <EmbeddedResource Remove="FirstWebAppInDocker.Tests/**" />

  </ItemGroup>


  <ItemGroup>

    <!-- ASP.NET Core Identity -->
    <PackageReference
      Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"
      Version="10.0.14" />

    <!-- Entity Framework Core Design -->
    <PackageReference
      Include="Microsoft.EntityFrameworkCore.Design"
      Version="10.0.11">

      <IncludeAssets>
        runtime; build; native; contentfiles; analyzers; buildtransitive
      </IncludeAssets>

      <PrivateAssets>all</PrivateAssets>

    </PackageReference>

    <!-- MariaDB / MySQL -->
    <PackageReference
      Include="Microting.EntityFrameworkCore.MySql"
      Version="10.0.11" />

  </ItemGroup>

</Project>