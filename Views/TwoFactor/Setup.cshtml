
@model FirstWebAppInDocker.ViewModels.TwoFactorSetupViewModel

@{
    Layout = null;
    ViewData["Title"] = "Aktiver tofaktorautentisering";
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>
        Aktiver tofaktor - Beredskapsportalen
    </title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f6f7;
            color: #17212b;
            font-family: Inter, -apple-system,
                BlinkMacSystemFont, "Segoe UI",
                sans-serif;
        }

        .site-header {
            background: white;
            border-bottom: 1px solid #e3e8eb;
        }

        .header-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 22px 30px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            text-decoration: none;
            color: #123047;
            font-size: 19px;
            font-weight: 800;
        }

        .back-link {
            text-decoration: none;
            color: #123047;
            font-size: 14px;
            font-weight: 700;
        }

        .back-link:hover {
            color: #168169;
        }

        .page {
            max-width: 850px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .hero {
            padding: 38px 40px;
            border-radius: 20px;

            background: linear-gradient(
                135deg,
                #102d43 0%,
                #123b50 55%,
                #12636c 100%
            );

            color: white;
        }

        .hero-label {
            color: #7fe0c1;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .hero h1 {
            margin: 12px 0;
            font-size: 34px;
            line-height: 1.15;
        }

        .hero p {
            margin: 0;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.7;
        }

        .setup-card {
            margin-top: 25px;
            padding: 35px 40px;

            background: white;
            border: 1px solid #e0e6e9;
            border-radius: 16px;

            box-shadow:
                0 8px 25px rgba(18, 48, 71, 0.04);
        }

        .section-label {
            display: block;
            margin-bottom: 8px;
            color: #168169;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.8px;
        }

        h2 {
            margin: 0 0 12px;
            color: #123047;
            font-size: 23px;
        }

        .description {
            color: #66737c;
            line-height: 1.7;
        }

        .steps {
            margin: 26px 0;
            padding-left: 24px;
        }

        .steps li {
            margin-bottom: 18px;
            padding-left: 5px;
            line-height: 1.7;
        }

        .steps li::marker {
            color: #168169;
            font-weight: 800;
        }

        .secret-section {
            margin: 28px 0;
            padding: 23px;

            background: #f5f8f8;
            border: 1px solid #dce8e4;
            border-radius: 12px;
        }

        .secret-label {
            display: block;
            margin-bottom: 12px;
            color: #123047;
            font-size: 14px;
            font-weight: 800;
        }

        .secret-key {
            display: block;
            width: 100%;
            padding: 15px;

            border: 1px solid #d4dde1;
            border-radius: 8px;

            background: white;
            color: #123047;

            font-family: Consolas, monospace;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 1px;

            overflow-wrap: anywhere;
            word-break: break-word;
            user-select: all;
        }

        .help-text {
            margin: 12px 0 0;
            color: #66737c;
            font-size: 13px;
            line-height: 1.6;
        }

        .warning {
            margin: 22px 0;
            padding: 16px 18px;

            background: #fff8e9;
            border: 1px solid #f0d7a4;
            border-radius: 10px;

            color: #805a20;
            font-size: 13px;
            line-height: 1.6;
        }

        .form-label {
            display: block;
            margin: 25px 0 10px;
            color: #123047;
            font-size: 14px;
            font-weight: 800;
        }

        .code-input {
            width: 100%;
            padding: 14px 16px;

            border: 1px solid #d4dde1;
            border-radius: 8px;

            font-size: 20px;
            letter-spacing: 5px;
            outline: none;
        }

        .code-input:focus {
            border-color: #168169;
            box-shadow:
                0 0 0 3px rgba(22, 129, 105, 0.12);
        }

        .validation {
            display: block;
            margin-top: 8px;
            color: #b42318;
            font-size: 13px;
            font-weight: 600;
        }

        .validation-summary {
            margin-bottom: 15px;
            color: #b42318;
            font-size: 13px;
        }

        .validation-summary:empty {
            display: none;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 28px;
        }

        .primary-button {
            padding: 13px 20px;
            border: none;
            border-radius: 8px;

            background: #168169;
            color: white;

            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
        }

        .primary-button:hover {
            background: #106d59;
        }

        .secondary-button {
            display: inline-flex;
            align-items: center;

            padding: 13px 20px;

            border: 1px solid #d9e0e4;
            border-radius: 8px;

            color: #123047;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
        }

        .secondary-button:hover {
            background: #f4f6f7;
        }

        @@media (max-width: 600px) {
            .header-inner {
                padding: 20px 16px;
            }

            .page {
                padding: 25px 16px 50px;
            }

            .hero {
                padding: 30px 24px;
            }

            .hero h1 {
                font-size: 28px;
            }

            .setup-card {
                padding: 25px 20px;
            }

            .actions {
                flex-direction: column;
            }

            .primary-button,
            .secondary-button {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>

<partial name="_PortalHeader" />

<main class="page">

    <section class="hero">

        <span class="hero-label">
            KONTOSIKKERHET
        </span>

        <h1>
            Aktiver tofaktorautentisering
        </h1>

        <p>
            Beskytt brukerkontoen din med en ekstra
            sikkerhetskode ved innlogging.
        </p>

    </section>

    <section class="setup-card">

        <span class="section-label">
            STEG 1
        </span>

        <h2>
            Koble til en autentiseringsapp
        </h2>

        <p class="description">
            Du trenger en autentiseringsapp på
            mobiltelefonen din.
        </p>

        <ol class="steps">

            <li>
                Åpne Microsoft Authenticator,
                Google Authenticator eller en
                annen TOTP-kompatibel app.
            </li>

            <li>
                Velg å legge til en ny konto.
            </li>

            <li>
                Velg å skrive inn en
                oppsettsnøkkel manuelt.
            </li>

            <li>
                Bruk navnet
                <strong>Beredskapsportalen</strong>
                og oppsettsnøkkelen nedenfor.
                Velg tidsbasert kode (TOTP)
                dersom appen spør.
            </li>

        </ol>

        <div class="secret-section">

            <label class="secret-label">
                Din oppsettsnøkkel
            </label>

            <code class="secret-key">
                @Model.SharedKey
            </code>

            <p class="help-text">
                Kopier nøkkelen nøyaktig slik den vises
                og legg den inn i autentiseringsappen.
            </p>

        </div>

        <div class="warning">
            <strong>Viktig:</strong>
            Ikke del oppsettsnøkkelen med andre.
            Den kan brukes til å generere
            innloggingskoder for kontoen din.
        </div>

        <span class="section-label">
            STEG 2
        </span>

        <h2>
            Bekreft oppsettet
        </h2>

        <p class="description">
            Når kontoen er lagt til i appen,
            får du en sekssifret engangskode.
            Skriv inn koden for å aktivere tofaktor.
        </p>

        <form
            asp-controller="TwoFactor"
            asp-action="Enable"
            method="post">

            @Html.AntiForgeryToken()

            <input
                asp-for="SharedKey"
                type="hidden" />

            <input
                asp-for="AuthenticatorUri"
                type="hidden" />

            <div
                asp-validation-summary="ModelOnly"
                class="validation-summary">
            </div>

            <label
                asp-for="Code"
                class="form-label">
                Sekssifret engangskode
            </label>

            <input
                asp-for="Code"
                class="code-input"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                placeholder="000000"
                required />

            <span
                asp-validation-for="Code"
                class="validation">
            </span>

            <div class="actions">

                <button
                    type="submit"
                    class="primary-button">
                    Aktiver tofaktor
                </button>

                <a
                    asp-controller="Account"
                    asp-action="Profile"
                    class="secondary-button">
                    Avbryt
                </a>

            </div>

        </form>

    </section>

</main>

</body>
</html>
