
@using FirstWebAppInDocker.Models
@model FirstWebAppInDocker.ViewModels.RegisterResourceViewModel

@{
    Layout = null;
    ViewData["Title"] = "Registrer ressurs";
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrer ressurs - Beredskapsportal</title>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            background: var(--background);
            color: #17212b;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                         BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        /* ==========================================
           SIDE OG OVERSKRIFT
        ========================================== */

        .resource-page {
            width: min(1500px, calc(100% - 40px));
            margin: 0 auto;
            padding: 18px 0 12px;
        }

        .resource-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 16px;
        }

        .resource-eyebrow {
            display: inline-block;
            margin-bottom: 10px;
            color: #187052;
            font-size: .75rem;
            font-weight: 850;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .resource-top h1 {
            margin: 0 0 8px;
            color: #102d42;
            font-size: clamp(1.8rem, 2.7vw, 2.5rem);
            line-height: 1.02;
        }

        .resource-top p {
            max-width: 700px;
            margin: 0;
            color: #667085;
            font-size: 1rem;
            line-height: 1.65;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 17px;
            border: 1px solid #d5dce1;
            border-radius: 10px;
            background: var(--surface);
            color: #344054;
            text-decoration: none;
            font-weight: 750;
            white-space: nowrap;
        }

        .back-button:hover {
            background: var(--surface-soft);
        }

        /* ==========================================
           KORT OG RUTENETT
        ========================================== */

        .resource-grid {
            display: grid;
            grid-template-columns: minmax(420px, .8fr) minmax(600px, 1.35fr);
            gap: 18px;
            align-items: start;
        }

        .resource-card {
            min-width: 0;
            border: 1px solid #dfe5e9;
            border-radius: 18px;
            background: var(--surface);
            box-shadow: 0 12px 35px rgba(16, 45, 66, .05);
        }

        .form-card {
            padding: 28px;
        }

        .map-card {
            padding: 14px 18px 18px 14px;
        }

        .card-heading {
            margin-bottom: 24px;
        }

        .card-heading span {
            display: inline-block;
            margin-bottom: 7px;
            color: #23855b;
            font-size: .72rem;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .card-heading h2 {
            margin: 0 0 6px;
            color: #123047;
            font-size: 1.35rem;
        }

        .card-heading p {
            margin: 0;
            color: #667085;
            line-height: 1.55;
        }

        /* ==========================================
           SKJEMA
        ========================================== */

        .form-section {
            padding-bottom: 24px;
            margin-bottom: 24px;
            border-bottom: 1px solid #edf0f2;
        }

        .form-section:last-of-type {
            margin-bottom: 20px;
        }

        .form-section-title {
            margin: 0 0 18px;
            color: #123047;
            font-size: .95rem;
            font-weight: 800;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #27364a;
            font-size: .88rem;
            font-weight: 750;
        }

        .required-mark {
            color: #b42318;
        }

        .form-control,
        .country-code {
            width: 100%;
            min-width: 0;
            min-height: 48px;
            border: 1px solid #ccd5dc;
            border-radius: 10px;
            padding: 11px 13px;
            background: var(--surface);
            color: #17212b;
            outline: none;
        }

        textarea.form-control {
            min-height: 115px;
            resize: vertical;
        }

        .form-control:focus,
        .country-code:focus {
            border-color: #23855b;
            box-shadow: 0 0 0 3px rgba(35, 133, 91, .11);
        }

        .form-control::placeholder {
            color: #98a2b3;
        }

        .field-note {
            display: block;
            margin-top: 6px;
            color: #7a8695;
            font-size: .78rem;
            line-height: 1.4;
        }

        .validation-message {
            display: block;
            margin-top: 6px;
            color: #b42318;
            font-size: .82rem;
            font-weight: 600;
        }

        .validation-summary {
            margin-bottom: 20px;
            color: #b42318;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        .phone-row {
            display: grid;
            grid-template-columns: 105px 1fr;
            gap: 10px;
        }

        .selected-position {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-top: 16px;
            padding: 13px 14px;
            border-radius: 10px;
            background: #f4f7f6;
            color: #344054;
        }

        .selected-position strong {
            color: #123047;
            font-size: .82rem;
        }

        .selected-position span {
            font-size: .88rem;
        }

        .submit-button {
            width: 100%;
            min-height: 52px;
            border: 0;
            border-radius: 11px;
            background: #23855b;
            color: var(--surface);
            cursor: pointer;
            font-weight: 800;
        }

        .submit-button:hover {
            background: #1d704d;
        }

        /* ==========================================
           KART
        ========================================== */

        .map-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 10px;
        }

        .map-card-header h2 {
            margin: 0 0 6px;
            color: #123047;
            font-size: 1.35rem;
        }

        .map-card-header p {
            margin: 0;
            color: #667085;
            line-height: 1.5;
        }

        .map-badge {
            flex: 0 0 auto;
            padding: 7px 10px;
            border-radius: 999px;
            background: #e8f5ef;
            color: #187052;
            font-size: .72rem;
            font-weight: 800;
        }

        #resourceMap {
            width: 100%;
            height: 650px;
            border: 1px solid #d8e0e5;
            border-radius: 14px;
            overflow: hidden;
        }

        .map-help {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .map-help-item {
            padding: 12px;
            border-radius: 10px;
            background: #f7f9fa;
        }

        .map-help-item strong {
            display: block;
            margin-bottom: 4px;
            color: #123047;
            font-size: .8rem;
        }

        .map-help-item span {
            color: #667085;
            font-size: .75rem;
            line-height: 1.4;
        }

        /* ==========================================
           FULLSKJERM
        ========================================== */

        .resource-fullscreen-control button {
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            padding: 8px;
            border: 0;
            background: white;
            color: var(--text);
            cursor: pointer;
        }

        .resource-fullscreen-control button:hover {
            background: #f4f4f4;
        }

        .resource-fullscreen-control button:focus-visible {
            outline: 3px solid #176b87;
            outline-offset: -3px;
        }

        .resource-fullscreen-control svg {
            width: 22px;
            height: 22px;
        }

        #resourceMap:fullscreen,
        .resource-fullscreen-dialog #resourceMap {
            width: 100% !important;
            height: 100dvh !important;
            min-height: 0 !important;
            border: 0;
            border-radius: 0;
        }

        .resource-fullscreen-dialog {
            width: 100vw;
            max-width: none;
            height: 100dvh;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            overflow: hidden;
        }

        .resource-fullscreen-dialog::backdrop {
            background: #17212b;
        }

        /* ==========================================
           ADRESSEFELT OG ADRESSEFORSLAG
        ========================================== */

        .address-detail-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            row-gap: 0;
            margin-bottom: 18px;
        }

        .address-detail-row .form-group {
            display: grid;
            grid-template-rows: subgrid;
            grid-row: span 3;
            margin-bottom: 0;
            min-width: 0;
        }

        .address-detail-row input {
            min-width: 0;
        }

        .resource-address-suggestions {
            max-height: 250px;
            overflow-y: auto;
            border: 1px solid #dfe5e9;
            border-radius: 8px;
            margin-top: 6px;
        }

        .resource-address-option {
            display: block;
            width: 100%;
            padding: 12px;
            text-align: left;
            border: 0;
            border-bottom: 1px solid #dfe5e9;
            background: var(--surface, white);
            color: var(--text, #17212b);
            font: inherit;
            cursor: pointer;
            overflow-wrap: anywhere;
        }

        .resource-address-option:hover,
        .resource-address-option:focus-visible {
            background: var(--surface-soft, #eef5f8);
            outline: 2px solid #176b87;
            outline-offset: -2px;
        }

        [hidden] {
            display: none !important;
        }

        /* ==========================================
           PC: INTERN SCROLLING I SKJEMAET
        ========================================== */

        @@media (min-width: 951px) {

            /*
              Litt større kartområde.
              Kartet begynner lenger til venstre.
            */
            .resource-grid {
                grid-template-columns: minmax(0, .33fr) minmax(0, .67fr);
                align-items: start;
                min-height: 0;
                height: auto;
                overflow: visible;
            }

            /*
              Venstre boks får nøyaktig samme
              høyde som høyre kartboks.

              Høyden beregnes automatisk
              av JavaScript.
            */
            .resource-grid > .form-card {
                display: flex;
                flex-direction: column;
                height: var(--register-map-card-height, 780px);
                min-height: 0;
                overflow: hidden;
            }

            /*
              Kartet står normalt på siden.
              Ingen ekstra plass under kartboksen.
            */
            .resource-grid > .map-card {
                height: auto;
                position: static;
                align-self: start;
            }

            /*
              Overskriften er alltid synlig
              øverst i venstre boks.
            */
            .form-card > .card-heading {
                flex: 0 0 auto;
            }

            /*
              Kun skjemainnholdet scroller.
              Kartet påvirkes ikke av scrollingen.
            */
            .form-card > form {
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
                overscroll-behavior-y: contain;
                scrollbar-gutter: stable;
                padding-right: 10px;
            }

            .form-card .form-row {
                grid-template-columns: minmax(0, 1fr);
            }

            .form-card .phone-row {
                grid-template-columns: 90px minmax(0, 1fr);
            }

            .form-card .form-group,
            .form-card .form-control {
                min-width: 0;
                max-width: 100%;
            }

            /*
              Kartet er litt høyere enn tidligere.
              Dette gir bedre utnyttelse av plassen.
            */
            .map-card > #resourceMap {
                height: clamp(470px, 68dvh, 740px);
            }
        }

        /* ==========================================
           NETTBRETT OG MOBIL
        ========================================== */

        @@media (max-width: 950px) {

            .resource-grid {
                grid-template-columns: 1fr;
                min-height: 0;
            }

            .resource-grid > .form-card {
                height: auto;
                overflow: visible;
            }

            .form-card > form {
                max-height: none;
                overflow: visible;
            }

            .resource-grid > .map-card {
                position: static;
            }

            #resourceMap {
                height: 460px;
            }
        }

        @@media (max-width: 700px) {

            .resource-page {
                width: calc(100% - 28px);
                padding-top: 28px;
            }

            .resource-top {
                flex-direction: column;
            }

            .form-card,
            .map-card {
                padding: 19px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .map-help {
                grid-template-columns: 1fr;
            }

            #resourceMap {
                height: 420px;
            }
        }

        @@media (max-width: 600px) {
            .address-detail-row {
                grid-template-columns: minmax(0, 1fr);
            }
        }

    </style>

    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>

<body>

<partial name="_PortalHeader" />

<main class="resource-page">

    <section class="resource-top">
        <div>
            <span class="resource-eyebrow">Mine ressurser</span>
            <h1>Registrer ny ressurs</h1>
            <p>
                Registrer utstyr, kapasitet eller andre ressurser
                som kan stilles til disposisjon ved en
                beredskapssituasjon.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="back-button">
            ← Tilbake til oversikt
        </a>
    </section>

    <div class="resource-grid">

        <!-- ==========================================
             RESSURSSKJEMA
        =========================================== -->

        <section class="resource-card form-card">

            <div class="card-heading">
                <span>Ressursinformasjon</span>
                <h2>Hva kan du bidra med?</h2>
                <p>Fyll inn informasjonen så presist som mulig.</p>
            </div>

            <form asp-controller="Resource"
                  asp-action="RegisterResource"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <!-- GRUNNINFORMASJON -->

                <div class="form-section">

                    <h3 class="form-section-title">Grunninformasjon</h3>

                    <div class="form-group">
                        <label asp-for="ResourceType">
                            Ressurstype
                            <span class="required-mark">*</span>
                        </label>

                        <select asp-for="ResourceType"
                                asp-items="Html.GetEnumSelectList<ResourceType>()"
                                class="form-control">
                            <option value="">Velg type ressurs</option>
                        </select>

                        <span asp-validation-for="ResourceType"
                              class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ResourceName">
                            Navn på ressurs
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="ResourceName"
                               class="form-control"
                               maxlength="100"
                               placeholder="F.eks. Volvo lastebil, aggregat 15 kW eller møterom" />

                        <span asp-validation-for="ResourceName"
                              class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">
                            Beskrivelse
                            <span class="required-mark">*</span>
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  maxlength="500"
                                  placeholder="Beskriv ressursen, egenskaper og hva den kan brukes til"></textarea>

                        <span asp-validation-for="Description"
                              class="validation-message"></span>
                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label asp-for="Quantity">Antall</label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   max="100000" />

                            <span asp-validation-for="Quantity"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Capacity">Kapasitet</label>

                            <input asp-for="Capacity"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="F.eks. 10 tonn / 15 kW" />

                            <span asp-validation-for="Capacity"
                                  class="validation-message"></span>
                        </div>

                    </div>

                    <div class="form-group">
                        <label asp-for="AvailabilityMonths">
                            Hvor lenge skal ressursen være tilgjengelig?
                            <span class="required-mark">*</span>
                        </label>

                        <select asp-for="AvailabilityMonths"
                                id="availabilityDuration"
                                class="form-control"
                                required
                                aria-describedby="availabilityExpiryPreview">
                            <option value="">Velg periode</option>

                            @foreach (var period in FirstWebAppInDocker.Services.ResourceAvailability.Periods)
                            {
                                <option value="@period.Key">@period.Value</option>
                            }
                        </select>

                        <span asp-validation-for="AvailabilityMonths"
                              class="validation-message"></span>

                        <small class="field-note"
                               id="availabilityExpiryPreview">
                            Velg en periode for å se når tilgjengeligheten utløper.
                        </small>
                    </div>

                </div>

                <!-- PLASSERING -->

                <div class="form-section">

                    <h3 class="form-section-title">Plassering</h3>

                    <input asp-for="Address" type="hidden" />

                    <div class="form-group resource-address-search">
                        <label asp-for="StreetAddress">Adresse</label>

                        <input asp-for="StreetAddress"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="Gatenavn og husnummer"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-controls="addressSuggestions"
                               aria-expanded="false"
                               aria-describedby="addressLookupStatus" />

                        <span asp-validation-for="StreetAddress"
                              class="validation-message"></span>

                        <div id="addressSuggestions"
                             class="resource-address-suggestions"
                             role="listbox"
                             aria-label="Adresseforslag"
                             hidden></div>
                    </div>

                    <div class="address-detail-row">

                        <div class="form-group">
                            <label asp-for="PostalLocation">
                                Postnummer og poststed
                            </label>

                            <input asp-for="PostalLocation"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="4629, Kristiansand S" />

                            <span asp-validation-for="PostalLocation"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Municipality">Kommune</label>

                            <input asp-for="Municipality"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Kristiansand" />

                            <span asp-validation-for="Municipality"
                                  class="validation-message"></span>
                        </div>

                    </div>

                    <span asp-validation-for="Address"
                          class="validation-message"></span>

                    <small id="addressLookupStatus"
                           class="field-note"
                           role="status"
                           aria-live="polite"></small>

                    <small class="field-note">
                        Velg et adresseforslag eller plasser markøren selv.
                        Adressen kan korrigeres manuelt.
                    </small>

                    <input asp-for="Latitude"
                           type="hidden"
                           id="Latitude" />

                    <input asp-for="Longitude"
                           type="hidden"
                           id="Longitude" />

                    <div class="selected-position">
                        <strong>Valgt kartposisjon</strong>
                        <span id="positionText">
                            Ingen plassering valgt
                        </span>
                    </div>

                    <span asp-validation-for="Latitude"
                          class="validation-message"></span>

                    <span asp-validation-for="Longitude"
                          class="validation-message"></span>

                </div>

                <button type="submit" class="submit-button">
                    Registrer ressurs
                </button>

            </form>

        </section>

        <!-- ==========================================
             KART
        =========================================== -->

        <section class="resource-card map-card">

            <div class="map-card-header">
                <div>
                    <h2>Velg plassering</h2>
                    <p>Klikk i kartet der ressursen befinner seg.</p>
                </div>

                <span class="map-badge">Leaflet</span>
            </div>

            <div id="resourceMap"></div>

            <div class="map-help">

                <div class="map-help-item">
                    <strong>1. Finn området</strong>
                    <span>Zoom og flytt kartet til riktig sted.</span>
                </div>

                <div class="map-help-item">
                    <strong>2. Klikk i kartet</strong>
                    <span>En markør viser den valgte posisjonen.</span>
                </div>

                <div class="map-help-item">
                    <strong>3. Registrer</strong>
                    <span>Koordinatene lagres sammen med ressursen.</span>
                </div>

            </div>

        </section>

    </div>

</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/kartverket.js" asp-append-version="true"></script>
<script src="~/js/resource-address.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const latitudeInput = document.getElementById("Latitude");
        const longitudeInput = document.getElementById("Longitude");
        const positionText = document.getElementById("positionText");

        const defaultLatitude = 58.1467;
        const defaultLongitude = 7.9956;

        const map = L.map("resourceMap").setView(
            [defaultLatitude, defaultLongitude],
            10
        );

        const mapElement = document.getElementById("resourceMap");

        /* ==========================================
           FULLSKJERM
        ========================================== */

        const fullscreenDialog = document.createElement("dialog");
        fullscreenDialog.className = "resource-fullscreen-dialog";
        fullscreenDialog.setAttribute(
            "aria-label",
            "Ressurskart i fullskjerm"
        );

        document.body.appendChild(fullscreenDialog);

        let mapPlaceholder;
        let fullscreenButton;

        const expandIcon =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>';

        const collapseIcon =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6"/></svg>';

        function isMapFullscreen() {
            return document.fullscreenElement === mapElement
                || fullscreenDialog.open;
        }

        function refreshMapSize() {
            const center = map.getCenter();
            const zoom = map.getZoom();

            map.invalidateSize({ pan: false });
            map.setView(center, zoom, {
                animate: false,
                reset: true
            });
        }

        function updateFullscreenControl() {
            const expanded = isMapFullscreen();

            const label = expanded
                ? "Avslutt fullskjerm"
                : "Vis i fullskjerm";

            fullscreenButton.title = label;

            fullscreenButton.setAttribute(
                "aria-label",
                label
            );

            fullscreenButton.setAttribute(
                "aria-pressed",
                String(expanded)
            );

            fullscreenButton.innerHTML = expanded
                ? collapseIcon
                : expandIcon;

            requestAnimationFrame(refreshMapSize);
        }

        function openFullscreenDialog() {
            mapPlaceholder = document.createComment(
                "Original resource map position"
            );

            mapElement.before(mapPlaceholder);

            fullscreenDialog.appendChild(mapElement);
            fullscreenDialog.showModal();

            updateFullscreenControl();
            fullscreenButton.focus();
        }

        fullscreenDialog.addEventListener("close", function () {

            if (mapPlaceholder) {
                mapPlaceholder.replaceWith(mapElement);
                mapPlaceholder = null;
            }

            updateFullscreenControl();

            fullscreenButton.focus({
                preventScroll: true
            });
        });

        document.addEventListener(
            "fullscreenchange",
            updateFullscreenControl
        );

        document.addEventListener("keydown", function (event) {

            if (event.key !== "Escape" || !isMapFullscreen()) {
                return;
            }

            event.preventDefault();

            if (fullscreenDialog.open) {
                fullscreenDialog.close();
            } else {
                document.exitFullscreen();
            }
        });

        const FullscreenControl = L.Control.extend({

            options: {
                position: "topright"
            },

            onAdd: function () {

                const control = L.DomUtil.create(
                    "div",
                    "leaflet-bar resource-fullscreen-control"
                );

                fullscreenButton = L.DomUtil.create(
                    "button",
                    "",
                    control
                );

                fullscreenButton.type = "button";

                L.DomEvent.disableClickPropagation(control);
                L.DomEvent.disableScrollPropagation(control);

                fullscreenButton.addEventListener(
                    "click",
                    async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        if (fullscreenDialog.open) {

                            fullscreenDialog.close();

                        } else if (
                            document.fullscreenElement === mapElement
                        ) {

                            await document.exitFullscreen();

                        } else if (
                            mapElement.requestFullscreen &&
                            document.fullscreenEnabled
                        ) {

                            try {
                                await mapElement.requestFullscreen();
                            } catch {
                                openFullscreenDialog();
                            }

                        } else {

                            openFullscreenDialog();

                        }
                    }
                );

                return control;
            }
        });

        addKartverketLayers(map);

        new FullscreenControl().addTo(map);
        updateFullscreenControl();

        /* ==========================================
           KARTLAG OG ADRESSESØK
        ========================================== */

    

        const addressLookup = setupResourceAddress(
            map,
            function (latitude, longitude) {

                updateResourcePosition(
                    latitude,
                    longitude,
                    false
                );

                map.setView(
                    [latitude, longitude],
                    16,
                    { animate: false }
                );
            }
        );

        /* ==========================================
           KARTMARKØR
        ========================================== */

        function createResourceMarker(latitude, longitude) {

            return L.marker(
                [latitude, longitude],
                { draggable: true }
            )
            .addTo(map)
            .on("dragend", function (event) {

                const position = event.target.getLatLng();

                updateResourcePosition(
                    position.lat,
                    position.lng
                );
            });
        }

        let marker = null;

        const existingLatitude = parseFloat(latitudeInput.value);
        const existingLongitude = parseFloat(longitudeInput.value);

        if (
            !Number.isNaN(existingLatitude) &&
            !Number.isNaN(existingLongitude) &&
            (existingLatitude !== 0 || existingLongitude !== 0)
        ) {

            marker = createResourceMarker(
                existingLatitude,
                existingLongitude
            );

            map.setView(
                [existingLatitude, existingLongitude],
                14
            );

            updatePositionText(
                existingLatitude,
                existingLongitude
            );
        }

        function updateResourcePosition(
            latitude,
            longitude,
            resolveAddress = true
        ) {

            latitudeInput.value = latitude;
            longitudeInput.value = longitude;

            if (marker === null) {

                marker = createResourceMarker(
                    latitude,
                    longitude
                );

            } else {

                marker.setLatLng([latitude, longitude]);

            }

            updatePositionText(latitude, longitude);

            if (resolveAddress) {
                addressLookup.lookup(latitude, longitude);
            }
        }

        map.on("click", function (event) {

            updateResourcePosition(
                event.latlng.lat,
                event.latlng.lng
            );
        });

        function updatePositionText(latitude, longitude) {

            positionText.textContent =
                latitude.toFixed(5) +
                ", " +
                longitude.toFixed(5);
        }

        /* ==========================================
           SYNKRONISER HØYDEN PÅ SKJEMA OG KART
        ========================================== */

        const registerGrid =
            document.querySelector(".resource-grid");

        const registerMapCard =
            document.querySelector(".map-card");

        /*
          Venstre kort skal alltid ha samme
          høyde som hele høyre kartkort.

          Hvis kartet endrer høyde, oppdateres
          skjemahøyden automatisk.

          Dokumentet får ikke ekstra høyde
          for å holde kartet sticky.
        */

        function syncFormHeight() {

            if (isMapFullscreen()) {
                return;
            }

            const mapCardHeight =
                registerMapCard.getBoundingClientRect().height;

            registerGrid.style.setProperty(
                "--register-map-card-height",
                mapCardHeight + "px"
            );
        }

        syncFormHeight();

        window.addEventListener(
            "resize",
            syncFormHeight
        );

        if (typeof ResizeObserver !== "undefined") {

            const mapCardObserver =
                new ResizeObserver(syncFormHeight);

            mapCardObserver.observe(registerMapCard);
        }

        /*
          Leaflet oppdateres automatisk når
          kartets størrelse endres.
        */

        if (typeof ResizeObserver !== "undefined") {

            const mapSizeObserver =
                new ResizeObserver(function () {
                    refreshMapSize();
                });

            mapSizeObserver.observe(mapElement);
        }

        window.setTimeout(function () {

            map.invalidateSize();
            syncFormHeight();

        }, 100);

    });
</script>

<!-- ==========================================
     TILGJENGELIGHETSPERIODE
=========================================== -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const durationSelect =
            document.getElementById("availabilityDuration");

        const expiryPreview =
            document.getElementById("availabilityExpiryPreview");

        if (!durationSelect || !expiryPreview) {
            return;
        }

        function updateExpiryPreview() {

            const months = Number(durationSelect.value);

            if (!months) {

                expiryPreview.textContent =
                    "Velg en periode for å se når tilgjengeligheten utløper.";

                return;
            }

            const today = new Date();
            const expiry = new Date(today);

            expiry.setDate(1);

            expiry.setMonth(
                expiry.getMonth() + months
            );

            expiry.setDate(
                Math.min(
                    today.getDate(),
                    new Date(
                        expiry.getFullYear(),
                        expiry.getMonth() + 1,
                        0
                    ).getDate()
                )
            );

            expiryPreview.textContent =
                "Tilgjengeligheten utløper: " +
                expiry.toLocaleDateString("nb-NO", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                });
        }

        durationSelect.addEventListener(
            "change",
            updateExpiryPreview
        );

        updateExpiryPreview();

    });
</script>

<partial name="_Sami" />

</body>
