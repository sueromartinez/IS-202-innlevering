<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

<script src="~/js/kartverket.js"></script>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function ()
        {
            const latitudeInput =
                document.getElementById(
                    "Latitude"
                );


            const longitudeInput =
                document.getElementById(
                    "Longitude"
                );


            const positionText =
                document.getElementById(
                    "positionText"
                );


            const defaultLatitude =
                58.1467;


            const defaultLongitude =
                7.9956;


            const map =
                L.map(
                    "resourceMap"
                )
                .setView(
                    [
                        defaultLatitude,
                        defaultLongitude
                    ],
                    10
                );


            addKartverketLayers(map);

            let marker =
                null;


            // Dersom skjemaet returneres etter
            // valideringsfeil, behold valgt posisjon.

            const existingLatitude =
                parseFloat(
                    latitudeInput.value
                );


            const existingLongitude =
                parseFloat(
                    longitudeInput.value
                );


            if (
                !Number.isNaN(
                    existingLatitude
                )
                &&
                !Number.isNaN(
                    existingLongitude
                )
                &&
                (
                    existingLatitude !== 0
                    ||
                    existingLongitude !== 0
                )
            )
            {
                marker =
                    L.marker(
                        [
                            existingLatitude,
                            existingLongitude
                        ]
                    )
                    .addTo(
                        map
                    );


                map.setView(
                    [
                        existingLatitude,
                        existingLongitude
                    ],
                    14
                );


                updatePositionText(
                    existingLatitude,
                    existingLongitude
                );
            }


            map.on(
                "click",
                function (event)
                {
                    const latitude =
                        event.latlng.lat;


                    const longitude =
                        event.latlng.lng;


                    latitudeInput.value =
                        latitude;


                    longitudeInput.value =
                        longitude;


                    if (marker === null)
                    {
                        marker =
                            L.marker(
                                [
                                    latitude,
                                    longitude
                                ]
                            )
                            .addTo(
                                map
                            );
                    }
                    else
                    {
                        marker.setLatLng(
                            [
                                latitude,
                                longitude
                            ]
                        );
                    }


                    updatePositionText(
                        latitude,
                        longitude
                    );
                }
            );


            function updatePositionText(
                latitude,
                longitude
            )
            {
                positionText.textContent =
                    latitude.toFixed(5)
                    +
                    ", "
                    +
                    longitude.toFixed(5);
            }


            // Leaflet trenger noen ganger dette
            // etter at layouten er ferdig rendret.

            window.setTimeout(
                function ()
                {
                    map.invalidateSize();
                },
                100
            );
        }
    );

</script>


