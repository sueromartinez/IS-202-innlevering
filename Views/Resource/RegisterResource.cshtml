<script>

    document.addEventListener(
        "DOMContentLoaded",
        function ()
        {
            const latitudeInput =
                document.getElementById(
                    "Latitude"
                );


            const longitudeInput =
                document.getElementById(
                    "Longitude"
                );


            const positionText =
                document.getElementById(
                    "positionText"
                );


            const defaultLatitude =
                58.1467;


            const defaultLongitude =
                7.9956;


            const map =
                L.map(
                    "resourceMap"
                )
                .setView(
                    [
                        defaultLatitude,
                        defaultLongitude
                    ],
                    10
                );


            // Reuses one Leaflet map so fullscreen never rebuilds layers or selected coordinates.
            const mapElement = document.getElementById("resourceMap");
            const fullscreenDialog = document.createElement("dialog");
            fullscreenDialog.className = "resource-fullscreen-dialog";
            fullscreenDialog.setAttribute("aria-label", "Ressurskart i fullskjerm");
            document.body.appendChild(fullscreenDialog);
            let mapPlaceholder;
            let fullscreenButton;
            const expandIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>';
            const collapseIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6"/></svg>';

            function isMapFullscreen() {
                return document.fullscreenElement === mapElement || fullscreenDialog.open;
            }

            // Refreshes the viewport while explicitly retaining the current map center and zoom.
            function refreshMapSize() {
                const center = map.getCenter();
                const zoom = map.getZoom();
                map.invalidateSize({ pan: false });
                map.setView(center, zoom, { animate: false, reset: true });
            }

            function updateFullscreenControl() {
                const expanded = isMapFullscreen();
                const label = expanded ? "Avslutt fullskjerm" : "Vis i fullskjerm";
                fullscreenButton.title = label;
                fullscreenButton.setAttribute("aria-label", label);
                fullscreenButton.setAttribute("aria-pressed", String(expanded));
                fullscreenButton.innerHTML = expanded ? collapseIcon : expandIcon;
                requestAnimationFrame(refreshMapSize);
            }

            // Uses a top-layer dialog on browsers that cannot fullscreen arbitrary elements.
            function openFullscreenDialog() {
                mapPlaceholder = document.createComment("Original resource map position");
                mapElement.before(mapPlaceholder);
                fullscreenDialog.appendChild(mapElement);
                fullscreenDialog.showModal();
                updateFullscreenControl();
                fullscreenButton.focus();
            }

            fullscreenDialog.addEventListener("close", function () {
                if (mapPlaceholder) {
                    mapPlaceholder.replaceWith(mapElement);
                    mapPlaceholder = null;
                }
                updateFullscreenControl();
                fullscreenButton.focus({ preventScroll: true });
            });
            // Escape closes the dialog automatically; native fullscreen emits fullscreenchange.
            document.addEventListener("fullscreenchange", updateFullscreenControl);
            // Also handles Escape explicitly where browser fullscreen keys are not forwarded.
            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape" || !isMapFullscreen()) return;
                event.preventDefault();
                if (fullscreenDialog.open) fullscreenDialog.close();
                else document.exitFullscreen();
            });

            const FullscreenControl = L.Control.extend({
                options: { position: "topright" },
                onAdd: function () {
                    const control = L.DomUtil.create("div", "leaflet-bar resource-fullscreen-control");
                    fullscreenButton = L.DomUtil.create("button", "", control);
                    fullscreenButton.type = "button";
                    L.DomEvent.disableClickPropagation(control);
                    L.DomEvent.disableScrollPropagation(control);
                    fullscreenButton.addEventListener("click", async function (event) {
                        // Prevents the same click from selecting coordinates after moving the map.
                        event.preventDefault();
                        event.stopPropagation();
                        if (fullscreenDialog.open) {
                            fullscreenDialog.close();
                        } else if (document.fullscreenElement === mapElement) {
                            await document.exitFullscreen();
                        } else if (mapElement.requestFullscreen && document.fullscreenEnabled) {
                            try {
                                await mapElement.requestFullscreen();
                            } catch {
                                openFullscreenDialog();
                            }
                        } else {
                            openFullscreenDialog();
                        }
                    });
                    return control;
                }
            });
            new FullscreenControl().addTo(map);
            updateFullscreenControl();

            addKartverketLayers(map);

            let marker =
                null;


            // Dersom skjemaet returneres etter
            // valideringsfeil, behold valgt posisjon.

            const existingLatitude =
                parseFloat(
                    latitudeInput.value
                );


            const existingLongitude =
                parseFloat(
                    longitudeInput.value
                );


            if (
                !Number.isNaN(
                    existingLatitude
                )
                &&
                !Number.isNaN(
                    existingLongitude
                )
                &&
                (
                    existingLatitude !== 0
                    ||
                    existingLongitude !== 0
                )
            )
            {
                marker =
                    L.marker(
                        [
                            existingLatitude,
                            existingLongitude
                        ]
                    )
                    .addTo(
                        map
                    );


                map.setView(
                    [
                        existingLatitude,
                        existingLongitude
                    ],
                    14
                );


                updatePositionText(
                    existingLatitude,
                    existingLongitude
                );
            }


            map.on(
                "click",
                function (event)
                {
                    const latitude =
                        event.latlng.lat;


                    const longitude =
                        event.latlng.lng;


                    latitudeInput.value =
                        latitude;


                    longitudeInput.value =
                        longitude;


                    if (marker === null)
                    {
                        marker =
                            L.marker(
                                [
                                    latitude,
                                    longitude
                                ]
                            )
                            .addTo(
                                map
                            );
                    }
                    else
                    {
                        marker.setLatLng(
                            [
                                latitude,
                                longitude
                            ]
                        );
                    }


                    updatePositionText(
                        latitude,
                        longitude
                    );
                }
            );


            function updatePositionText(
                latitude,
                longitude
            )
            {
                positionText.textContent =
                    latitude.toFixed(5)
                    +
                    ", "
                    +
                    longitude.toFixed(5);
            }


            // Measures wrapped navigation so the sticky map never overlaps the header.
            const registerHeader = document.querySelector(".site-header");
            function updateHeaderOffset() {
                document.documentElement.style.setProperty(
                    "--register-header-height", registerHeader.offsetHeight + "px");
            }
            updateHeaderOffset();
            window.addEventListener("resize", updateHeaderOffset);
            if (typeof ResizeObserver !== "undefined") {
                const headerSizeObserver = new ResizeObserver(updateHeaderOffset);
                headerSizeObserver.observe(registerHeader);
            }

            // Measures the complete card so its parent cannot collapse to the sticky height.
            const registerGrid = document.querySelector(".resource-grid");
            const registerMapCard = document.querySelector(".map-card");
            function updateStickyBounds() {
                if (isMapFullscreen()) return;
                registerGrid.style.setProperty(
                    "--register-map-card-height", registerMapCard.offsetHeight + "px");
            }
            updateStickyBounds();
            window.addEventListener("resize", updateStickyBounds);
            if (typeof ResizeObserver !== "undefined") {
                const stickyBoundsObserver = new ResizeObserver(updateStickyBounds);
                stickyBoundsObserver.observe(registerMapCard);
            }

            // Refreshes Leaflet when responsive layout changes the map container size.
            if (typeof ResizeObserver !== "undefined")
            {
                const mapSizeObserver = new ResizeObserver(function () {
                    refreshMapSize();
                });
                mapSizeObserver.observe(document.getElementById("resourceMap"));
            }

            // Leaflet trenger noen ganger dette
            // etter at layouten er ferdig rendret.

            window.setTimeout(
                function ()
                {
                    map.invalidateSize();
                },
                100
            );
        }
    );

</script>


<partial name="_Sami" />
</body>

</html>

