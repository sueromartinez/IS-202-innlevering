@using FirstWebAppInDocker.Models
@model FirstWebAppInDocker.ViewModels.RegisterResourceViewModel

@{
    Layout = null;

    ViewData["Title"] =
        "Registrer ressurs";

    string userName =
        Context.Session.GetString("UserName")
        ?? "RessursleverandÃ¸r";
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        Registrer ressurs - Beredskapsportal
    </title>


    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />


    <style>

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            min-height: 100%;
        }


        body {
            background:
                #f5f7f8;

            color:
                #17212b;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        button,
        input,
        select,
        textarea {
            font: inherit;
        }


        /* ==========================================
           HEADER
        ========================================== */

        .site-header {
            min-height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 24px;

            padding:
                14px 32px;

            background:
                white;

            border-bottom:
                1px solid #e5e9ec;
        }


        .brand {
            display: flex;
            align-items: center;

            gap: 12px;

            color:
                #123047;

            text-decoration:
                none;
        }


        .brand-icon {
            width: 42px;
            height: 42px;

            display: grid;
            place-items: center;

            border-radius:
                12px;

            background:
                #e7f5f1;

            color:
                #23855b;
        }


        .brand-icon svg {
            width: 25px;
            height: 25px;
        }


        .brand strong {
            display: block;

            font-size:
                1rem;
        }


        .brand span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.72rem;

                @* Collects the model fields needed to save a complete resource in MariaDB. *@
                <div class="form-group">
                    <label asp-for="ResourceName"></label>
                    <input asp-for="ResourceName" type="text" class="form-control" />
                    <span asp-validation-for="ResourceName" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Quantity"></label>
                    <input asp-for="Quantity" type="number" class="form-control" />
                    <span asp-validation-for="Quantity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" type="text" class="form-control" />
                    <span asp-validation-for="Capacity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" type="text" class="form-control" />
                    <span asp-validation-for="Address" class="validation-message"></span>
                </div>
                @* Fixed status values keep dashboard counts and overview filters consistent. *@
                <div class="form-group">
                    <label asp-for="Availability"></label>
                    <select asp-for="Availability" class="form-control">
                        <option value="">Ikke oppgitt</option>
                        <option value="Tilgjengelig">Tilgjengelig</option>
                        <option value="Ikke tilgjengelig">Ikke tilgjengelig</option>
                    </select>
                    <span asp-validation-for="Availability" class="validation-message"></span>
                </div>

                <!-- BESKRIVELSE -->
                <div class="form-group">
            font-weight:
                700;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        .header-user {
            display: flex;
            align-items: center;

            gap: 18px;
        }


        .header-user-info {
            text-align: right;
        }


        .header-user-info strong {
            display: block;

            color:
                #123047;

            font-size:
                0.92rem;
        }


        .header-user-info span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.78rem;
        }


        .logout-button {
            border:
                1px solid #d5dce1;

            border-radius:
                9px;

            padding:
                9px 14px;

            background:
                white;

            color:
                #344054;

            cursor:
                pointer;

            font-weight:
                700;
        }


        .logout-button:hover {
            background:
                #f7f9fa;
        }


        /* ==========================================
           PAGE
        ========================================== */

        .resource-page {
            width:
                min(
                    1550px,
                    calc(100% - 48px)
                );

            margin:
                0 auto;

            padding:
                42px 0 70px;
        }


        .resource-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 24px;

            margin-bottom:
                26px;
        }


        .resource-eyebrow {
            display: inline-block;

            margin-bottom:
                10px;

            color:
                #187052;

            font-size:
                0.75rem;

            font-weight:
                850;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        .resource-top h1 {
            margin:
                0 0 8px;

            color:
                #102d42;

            font-size:
                clamp(
                    2rem,
                    4vw,
                    3.3rem
                );

            line-height:
                1.02;
        }


        .resource-top p {
            max-width:
                700px;

            margin:
                0;

            color:
                #667085;

            font-size:
                1rem;

            line-height:
                1.65;
        }


        .back-button {
            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            min-height:
                44px;

            padding:
                0 17px;

            border:
                1px solid #d5dce1;

            border-radius:
                10px;

            background:
                white;

            color:
                #344054;

            text-decoration:
                none;

            font-weight:
                750;

            white-space:
                nowrap;
        }


        .back-button:hover {
            background:
                #f8fafb;
        }


        /* ==========================================
           GRID
        ========================================== */

        .resource-grid {
            display:
                grid;

            grid-template-columns:
                minmax(420px, 0.8fr)
                minmax(600px, 1.35fr);

            gap:
                24px;

            align-items:
                start;
        }


        .resource-card {
            border:
                1px solid #dfe5e9;

            border-radius:
                18px;

            background:
                white;

            box-shadow:
                0 12px 35px
                rgba(16, 45, 66, 0.05);
        }


        .form-card {
            padding:
                28px;
        }


        .map-card {
            padding:
                22px;
        }


        .card-heading {
            margin-bottom:
                24px;
        }


        .card-heading span {
            display:
                inline-block;

            margin-bottom:
                7px;

            color:
                #23855b;

            font-size:
                0.72rem;

            font-weight:
                850;

            letter-spacing:
                0.08em;

            text-transform:
                uppercase;
        }


        .card-heading h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .card-heading p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.55;
        }


        /* ==========================================
           FORM
        ========================================== */

        .form-section {
            padding:
                0 0 24px;

            margin-bottom:
                24px;

            border-bottom:
                1px solid #edf0f2;
        }


        .form-section:last-of-type {
            margin-bottom:
                20px;
        }


        .form-section-title {
            margin:
                0 0 18px;

            color:
                #123047;

            font-size:
                0.95rem;

            font-weight:
                800;
        }


        .form-group {
            margin-bottom:
                18px;
        }


        .form-group:last-child {
            margin-bottom:
                0;
        }


        .form-row {
            display:
                grid;

            grid-template-columns:
                1fr 1fr;

            gap:
                14px;
        }


        .form-group label {
            display:
                block;

            margin-bottom:
                7px;

            color:
                #27364a;

            font-size:
                0.88rem;

            font-weight:
                750;
        }


        .required-mark {
            color:
                #b42318;
        }


        .form-control,
        .country-code {
            width:
                100%;

            min-height:
                48px;

            border:
                1px solid #ccd5dc;

            border-radius:
                10px;

            padding:
                11px 13px;

            background:
                white;

            color:
                #17212b;

            outline:
                none;
        }


        textarea.form-control {
            min-height:
                115px;

            resize:
                vertical;
        }


        .form-control:focus,
        .country-code:focus {
            border-color:
                #23855b;

            box-shadow:
                0 0 0 3px
                rgba(35, 133, 91, 0.11);
        }


        .form-control::placeholder {
            color:
                #98a2b3;
        }


        .field-note {
            display:
                block;

            margin-top:
                6px;

            color:
                #7a8695;

            font-size:
                0.78rem;

            line-height:
                1.4;
        }


        .validation-message {
            display:
                block;

            margin-top:
                6px;

            color:
                #b42318;

            font-size:
                0.82rem;

            font-weight:
                600;
        }


        .validation-summary {
            margin-bottom:
                20px;

            color:
                #b42318;
        }


        .validation-summary ul {
            margin:
                0;

            padding-left:
                20px;
        }


        .phone-row {
            display:
                grid;

            grid-template-columns:
                105px 1fr;

            gap:
                10px;
        }


        .selected-position {
            display:
                flex;

            flex-direction:
                column;

            gap:
                5px;

            margin-top:
                16px;

            padding:
                13px 14px;

            border-radius:
                10px;

            background:
                #f4f7f6;

            color:
                #344054;
        }


        .selected-position strong {
            color:
                #123047;

            font-size:
                0.82rem;
        }


        .selected-position span {
            font-size:
                0.88rem;
        }


        .submit-button {
            width:
                100%;

            min-height:
                52px;

            border:
                0;

            border-radius:
                11px;

            background:
                #23855b;

            color:
                white;

            cursor:
                pointer;

            font-weight:
                800;
        }


        .submit-button:hover {
            background:
                #1d704d;
        }


        /* ==========================================
           MAP
        ========================================== */

        .map-card-header {
            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-start;

            gap:
                18px;

            margin-bottom:
                16px;
        }


        .map-card-header h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .map-card-header p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.5;
        }


        .map-badge {
            flex:
                0 0 auto;

            padding:
                7px 10px;

            border-radius:
                999px;

            background:
                #e8f5ef;

            color:
                #187052;

            font-size:
                0.72rem;

            font-weight:
                800;
        }


        #resourceMap {
            width:
                100%;

            height:
                650px;

            border:
                1px solid #d8e0e5;

            border-radius:
                14px;

            overflow:
                hidden;
        }


        .map-help {
            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                10px;

            margin-top:
                15px;
        }


        .map-help-item {
            padding:
                12px;

            border-radius:
                10px;

            background:
                #f7f9fa;
        }


        .map-help-item strong {
            display:
                block;

            margin-bottom:
                4px;

            color:
                #123047;

            font-size:
                0.8rem;
        }


        .map-help-item span {
            color:
                #667085;

            font-size:
                0.75rem;

            line-height:
                1.4;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @@media (max-width: 1150px) {

            .resource-grid {
                grid-template-columns:
                    minmax(380px, 0.85fr)
                    minmax(500px, 1.15fr);
            }


            #resourceMap {
                height:
                    520px;
            }

        }


        @@media (max-width: 950px) {

            .resource-grid {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    460px;
            }

        }


        @@media (max-width: 700px) {

            .site-header {
                padding:
                    12px 18px;
            }


            .header-user-info {
                display:
                    none;
            }


            .resource-page {
                width:
                    min(
                        100% - 28px,
                        1550px
                    );

                padding-top:
                    28px;
            }


            .resource-top {
                flex-direction:
                    column;
            }


            .form-card,
            .map-card {
                padding:
                    19px;
            }


            .form-row {
                grid-template-columns:
                    1fr;
            }


            .map-help {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    420px;
            }

        }

    </style>

</head>


<body>


<!-- ==========================================
     HEADER
========================================== -->

<header class="site-header">

    <a
        asp-controller="Home"
        asp-action="Dashboard"
        class="brand">

        <div class="brand-icon">

            <svg
                viewBox="0 0 24 24"
                aria-hidden="true">

                <path
                    d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                />

                <path
                    d="M8.5 12.5L11 15l4.8-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

            </svg>

        </div>


        <div>

            <strong>
                Beredskapsportal
            </strong>

            <span>
                RessursleverandÃ¸r
            </span>

        </div>

    </a>

<nav class="provider-navigation">

    <a asp-controller="Home"
       asp-action="Dashboard"
       class="provider-nav-link">
        Dashboard
    </a>

    <a asp-controller="Resource"
       asp-action="RegisterResource"
       class="provider-nav-link active">
        Registrer ressurs
    </a>

    <a asp-controller="Resource"
       asp-action="ResourceOverview"
       class="provider-nav-link">
        Mine ressurser
    </a>

</nav>

    <div class="header-user">

        <div class="header-user-info">

            <strong>
                @userName
            </strong>

            <span>
                RessursleverandÃ¸r
            </span>

        </div>


        <form
            asp-controller="Account"
            asp-action="Logout"
            method="post">

            <button
                type="submit"
                class="logout-button">

                Logg ut

            </button>

        </form>

    </div>

</header>


<!-- ==========================================
     PAGE
========================================== -->

<main class="resource-page">

    <section class="resource-top">

        <div>

            <span class="resource-eyebrow">
                Mine ressurser
            </span>


            <h1>
                Registrer ny ressurs
            </h1>


            <p>
                Registrer utstyr, kapasitet eller andre ressurser
                som kan stilles til disposisjon ved en
                beredskapssituasjon.
            </p>

        </div>


        <a
            asp-controller="Home"
            asp-action="Dashboard"
            class="back-button">

            â† Tilbake til oversikt

        </a>

    </section>


    <div class="resource-grid">


        <!-- ==========================================
             FORM
        =========================================== -->

        <section class="resource-card form-card">

            <div class="card-heading">

                <span>
                    Ressursinformasjon
                </span>

                <h2>
                    Hva kan du bidra med?
                </h2>

                <p>
                    Fyll inn informasjonen sÃ¥ presist som mulig.
                </p>

            </div>


            <form
                asp-controller="Resource"
                asp-action="RegisterResource"
                method="post">


                <div
                    asp-validation-summary="ModelOnly"
                    class="validation-summary">
                </div>


                <!-- ==================================
                     GRUNNINFORMASJON
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Grunninformasjon
                    </h3>

                 <!-- RESSURSNAVN -->
                <div class="form-group">

                    <label asp-for="ResourceName"></label>

                    <input
                        asp-for="ResourceName"
                        class="form-control"
                        placeholder="F.eks. Traktor med frontlaster" />

                    <span
                        asp-validation-for="ResourceName"
                        class="validation-message">
                    </span>

                </div>

                    <div class="form-group">

                        <label asp-for="ResourceType">
                            Ressurstype
                            <span class="required-mark">*</span>
                        </label>

                        <select
                            asp-for="ResourceType"
                            asp-items="Html.GetEnumSelectList<ResourceType>()"
                            class="form-control">

                            <option value="">
                                Velg type ressurs
                            </option>

                        </select>

                        <span
                            asp-validation-for="ResourceType"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="ResourceName">
                            Navn pÃ¥ ressurs
                            <span class="required-mark">*</span>
                        </label>

                        <input
                            asp-for="ResourceName"
                            class="form-control"
                            maxlength="100"
                            placeholder="F.eks. Volvo lastebil, aggregat 15 kW eller mÃ¸terom"
                        />

                        <span
                            asp-validation-for="ResourceName"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Description">
                            Beskrivelse
                            <span class="required-mark">*</span>
                        </label>

                        <textarea
                            asp-for="Description"
                            class="form-control"
                            maxlength="500"
                            placeholder="Beskriv ressursen, egenskaper og hva den kan brukes til">
                        </textarea>

                        <span
                            asp-validation-for="Description"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label asp-for="Quantity">
                                Antall
                            </label>

                            <input
                                asp-for="Quantity"
                                class="form-control"
                                type="number"
                                min="1"
                                max="100000"
                            />

                            <span
                                asp-validation-for="Quantity"
                                class="validation-message">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Capacity">
                                Kapasitet
                            </label>

                            <input
                                asp-for="Capacity"
                                class="form-control"
                                maxlength="200"
                                placeholder="F.eks. 10 tonn / 15 kW"
                            />

                            <span
                                asp-validation-for="Capacity"
                                class="validation-message">
                            </span>

                        </div>

                    </div>


                    <div class="form-group">

                        <label asp-for="Availability">
                            Tilgjengelighet
                        </label>

                        <input
                            asp-for="Availability"
                            class="form-control"
                            maxlength="200"
                            placeholder="F.eks. tilgjengelig nÃ¥, etter avtale eller hverdager 08â€“16"
                        />

                        <span
                            asp-validation-for="Availability"
                            class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- ==================================
                     PLASSERING
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Plassering
                    </h3>


                    <div class="form-group">

                        <label asp-for="Address">
                            Adresse / omrÃ¥de
                        </label>

                        <input
                            asp-for="Address"
                            class="form-control"
                            maxlength="200"
                            placeholder="F.eks. Kristiansand, Vennesla eller gateadresse"
                        />

                        <span
                            asp-validation-for="Address"
                            class="validation-message">
                        </span>

                        <small class="field-note">
                            Velg ogsÃ¥ nÃ¸yaktig plassering i kartet.
                        </small>

                    </div>


                    <input
                        asp-for="Latitude"
                        type="hidden"
                        id="Latitude"
                    />


                    <input
                        asp-for="Longitude"
                        type="hidden"
                        id="Longitude"
                    />


                    <div class="selected-position">

                        <strong>
                            Valgt kartposisjon
                        </strong>

                        <span id="positionText">
                            Ingen plassering valgt
                        </span>

                    </div>


                    <span
                        asp-validation-for="Latitude"
                        class="validation-message">
                    </span>

                    <span
                        asp-validation-for="Longitude"
                        class="validation-message">
                    </span>

                </div>


                <!-- ==================================
                     KONTAKT
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Kontaktinformasjon
                    </h3>


                    <div class="form-group">

                        <label asp-for="ContactEmail">
                            Kontakt-e-post
                        </label>

                        <input
                            asp-for="ContactEmail"
                            class="form-control"
                            type="email"
                            maxlength="150"
                            placeholder="navn@eksempel.no"
                        />

                        <small class="field-note">
                            Hvis feltet stÃ¥r tomt brukes e-posten
                            til den innloggede brukeren.
                        </small>

                        <span
                            asp-validation-for="ContactEmail"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label>
                            Telefonnummer
                        </label>

                        <div class="phone-row">

                            <select
                                asp-for="ContactPhoneCountryCode"
                                class="country-code">

                                <option value="+47">
                                    +47
                                </option>

                                <option value="+45">
                                    +45
                                </option>

                                <option value="+46">
                                    +46
                                </option>

                            </select>


                            <input
                                asp-for="ContactPhoneNumber"
                                class="form-control"
                                maxlength="20"
                                placeholder="12345678"
                            />

                        </div>

                        <span
                            asp-validation-for="ContactPhoneNumber"
                            class="validation-message">
                        </span>

                    </div>

                </div>


                <button
                    type="submit"
                    class="submit-button">

                    Registrer ressurs

                </button>

            </form>

        </section>


        <!-- ==========================================
             MAP
