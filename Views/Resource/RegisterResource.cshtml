@using FirstWebAppInDocker.Models
@model FirstWebAppInDocker.ViewModels.RegisterResourceViewModel

@{
    Layout = null;

    ViewData["Title"] =
        "Registrer ressurs";

    string userName =
        Context.Session.GetString("UserName")
        ?? "RessursleverandÃ¸r";
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        Registrer ressurs - Beredskapsportal
    </title>


    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />


    <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />

    <style>

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            min-height: 100%;
        }


        body {
            background:
                #f5f7f8;

            color:
                #17212b;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        button,
        input,
        select,
        textarea {
            font: inherit;
        }


        /* ==========================================
           HEADER
        ========================================== */

        .site-header {
            min-height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 24px;

            padding:
                14px 32px;

            background:
                white;

            border-bottom:
                1px solid #e5e9ec;
        }


        .brand {
            display: flex;
            align-items: center;

            gap: 12px;

            color:
                #123047;

            text-decoration:
                none;
        }


        .brand-icon {
            width: 42px;
            height: 42px;

            display: grid;
            place-items: center;

            border-radius:
                12px;

            background:
                #e7f5f1;

            color:
                #23855b;
        }


        .brand-icon svg {
            width: 25px;
            height: 25px;
        }


        .brand strong {
            display: block;

            font-size:
                1rem;
        }


        .brand span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.72rem;

                @* Collects the model fields needed to save a complete resource in MariaDB. *@
                <div class="form-group">
                    <label asp-for="ResourceName"></label>
                    <input asp-for="ResourceName" type="text" class="form-control" />
                    <span asp-validation-for="ResourceName" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Quantity"></label>
                    <input asp-for="Quantity" type="number" class="form-control" />
                    <span asp-validation-for="Quantity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" type="text" class="form-control" />
                    <span asp-validation-for="Capacity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" type="text" class="form-control" />
                    <span asp-validation-for="Address" class="validation-message"></span>
                </div>
                @* Fixed status values keep dashboard counts and overview filters consistent. *@
                <div class="form-group">
                    <label asp-for="Availability"></label>
                    <select asp-for="Availability" class="form-control">
                        <option value="">Ikke oppgitt</option>
                        <option value="Tilgjengelig">Tilgjengelig</option>
                        <option value="Ikke tilgjengelig">Ikke tilgjengelig</option>
                    </select>
                    <span asp-validation-for="Availability" class="validation-message"></span>
                </div>

                <!-- BESKRIVELSE -->
                <div class="form-group">
            font-weight:
                700;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        .header-user {
            display: flex;
            align-items: center;

            gap: 18px;
        }


        .header-user-info {
            text-align: right;
        }


        .header-user-info strong {
            display: block;

            color:
                #123047;

            font-size:
                0.92rem;
        }


        .header-user-info span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.78rem;
        }


        .logout-button {
            border:
                1px solid #d5dce1;

            border-radius:
                9px;

            padding:
                9px 14px;

            background:
                white;

            color:
                #344054;

            cursor:
                pointer;

            font-weight:
                700;
        }


        .logout-button:hover {
            background:
                #f7f9fa;
        }


        /* ==========================================
           PAGE
        ========================================== */

        /* Uses more desktop width while keeping the original page margins. */
        .resource-page {
            width:
                min(
                    1500px,
                    calc(100% - 48px)
                );

            margin:
                0 auto;

            padding:
                28px 0 44px;
        }


        .resource-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 24px;

            margin-bottom:
                26px;
        }


        .resource-eyebrow {
            display: inline-block;

            margin-bottom:
                10px;

            color:
                #187052;

            font-size:
                0.75rem;

            font-weight:
                850;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        /* Balances the title with the navigation and the larger cards below. */
        .resource-top h1 {
            margin:
                0 0 8px;

            color:
                #102d42;

            font-size:
                clamp(
                    1.8rem,
                    2.7vw,
                    2.5rem
                );

            line-height:
                1.02;
        }


        .resource-top p {
            max-width:
                700px;

            margin:
                0;

            color:
                #667085;

            font-size:
                1rem;

            line-height:
                1.65;
        }


        .back-button {
            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            min-height:
                44px;

            padding:
                0 17px;

            border:
                1px solid #d5dce1;

            border-radius:
                10px;

            background:
                white;

            color:
                #344054;

            text-decoration:
                none;

            font-weight:
                750;

            white-space:
                nowrap;
        }


        .back-button:hover {
            background:
                #f8fafb;
        }


        /* ==========================================
           GRID
        ========================================== */

        .resource-grid {
            display:
                grid;

            grid-template-columns:
                minmax(420px, 0.8fr)
                minmax(600px, 1.35fr);

            gap:
                24px;

            align-items:
                start;
        }


        .resource-card {
            border:
                1px solid #dfe5e9;

            border-radius:
                18px;

            background:
                white;

            box-shadow:
                0 12px 35px
                rgba(16, 45, 66, 0.05);
        }


        .form-card {
            padding:
                28px;
        }


        .map-card {
            padding:
                22px;
        }


        .card-heading {
            margin-bottom:
                24px;
        }


        .card-heading span {
            display:
                inline-block;

            margin-bottom:
                7px;

            color:
                #23855b;

            font-size:
                0.72rem;

            font-weight:
                850;

            letter-spacing:
                0.08em;

            text-transform:
                uppercase;
        }


        .card-heading h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .card-heading p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.55;
        }


        /* ==========================================
           FORM
        ========================================== */

        .form-section {
            padding:
                0 0 24px;

            margin-bottom:
                24px;

            border-bottom:
                1px solid #edf0f2;
        }


        .form-section:last-of-type {
            margin-bottom:
                20px;
        }


        .form-section-title {
            margin:
                0 0 18px;

            color:
                #123047;

            font-size:
                0.95rem;

            font-weight:
                800;
        }


        .form-group {
            margin-bottom:
                18px;
        }


        .form-group:last-child {
            margin-bottom:
                0;
        }


        .form-row {
            display:
                grid;

            grid-template-columns:
                1fr 1fr;

            gap:
                14px;
        }


        .form-group label {
            display:
                block;

            margin-bottom:
                7px;

            color:
                #27364a;

            font-size:
                0.88rem;

            font-weight:
                750;
        }


        .required-mark {
            color:
                #b42318;
        }


        .form-control,
        .country-code {
            width:
                100%;

            min-height:
                48px;

            border:
                1px solid #ccd5dc;

            border-radius:
                10px;

            padding:
                11px 13px;

            background:
                white;

            color:
                #17212b;

            outline:
                none;
        }


        textarea.form-control {
            min-height:
                115px;

            resize:
                vertical;
        }


        .form-control:focus,
        .country-code:focus {
            border-color:
                #23855b;

            box-shadow:
                0 0 0 3px
                rgba(35, 133, 91, 0.11);
        }


        .form-control::placeholder {
            color:
                #98a2b3;
        }


        .field-note {
            display:
                block;

            margin-top:
                6px;

            color:
                #7a8695;

            font-size:
                0.78rem;

            line-height:
                1.4;
        }


        .validation-message {
            display:
                block;

            margin-top:
                6px;

            color:
                #b42318;

            font-size:
                0.82rem;

            font-weight:
                600;
        }


        .validation-summary {
            margin-bottom:
                20px;

            color:
                #b42318;
        }


        .validation-summary ul {
            margin:
                0;

            padding-left:
                20px;
        }


        .phone-row {
            display:
                grid;

            grid-template-columns:
                105px 1fr;

            gap:
                10px;
        }


        .selected-position {
            display:
                flex;

            flex-direction:
                column;

            gap:
                5px;

            margin-top:
                16px;

            padding:
                13px 14px;

            border-radius:
                10px;

            background:
                #f4f7f6;

            color:
                #344054;
        }


        .selected-position strong {
            color:
                #123047;

            font-size:
                0.82rem;
        }


        .selected-position span {
            font-size:
                0.88rem;
        }


        .submit-button {
            width:
                100%;

            min-height:
                52px;

            border:
                0;

            border-radius:
                11px;

            background:
                #23855b;

            color:
                white;

            cursor:
                pointer;

            font-weight:
                800;
        }


        .submit-button:hover {
            background:
                #1d704d;
        }


        /* ==========================================
           MAP
        ========================================== */

        .map-card-header {
            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-start;

            gap:
                18px;

            margin-bottom:
                16px;
        }


        .map-card-header h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .map-card-header p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.5;
        }


        .map-badge {
            flex:
                0 0 auto;

            padding:
                7px 10px;

            border-radius:
                999px;

            background:
                #e8f5ef;

            color:
                #187052;

            font-size:
                0.72rem;

            font-weight:
                800;
        }


        #resourceMap {
            width:
                100%;

            height:
                650px;

            border:
                1px solid #d8e0e5;

            border-radius:
                14px;

            overflow:
                hidden;
        }


        .map-help {
            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                10px;

            margin-top:
                15px;
        }


        .map-help-item {
            padding:
                12px;

            border-radius:
                10px;

            background:
                #f7f9fa;
        }


        .map-help-item strong {
            display:
                block;

            margin-bottom:
                4px;

            color:
                #123047;

            font-size:
                0.8rem;
        }


        .map-help-item span {
            color:
                #667085;

            font-size:
                0.75rem;

            line-height:
                1.4;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @@media (max-width: 1150px) {

            .resource-grid {
                grid-template-columns:
                    minmax(380px, 0.85fr)
                    minmax(500px, 1.15fr);
            }


            #resourceMap {
                height:
                    520px;
            }

        }


        @@media (max-width: 950px) {

            .resource-grid {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    460px;
            }

        }


        @@media (max-width: 700px) {

            .site-header {
                padding:
                    12px 18px;
            }


            .header-user-info {
                display:
                    none;
            }


            .resource-page {
                width:
                    min(
                        100% - 28px,
                        1550px
                    );

                padding-top:
                    28px;
            }


            .resource-top {
                flex-direction:
                    column;
            }


            .form-card,
            .map-card {
                padding:
                    19px;
            }


            .form-row {
                grid-template-columns:
                    1fr;
            }


            .map-help {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    420px;
            }

        }


        /* Balances the columns and uses the dashboard map height as the desktop reference. */
        @@media (min-width: 951px) {
            /* Keeps the shared navigation visible above the sticky map. */
            .site-header.portal-navigation-header {
                position: sticky;
                top: 0;
                z-index: 1100;
                flex-wrap: wrap;
                gap: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
            }

            .resource-grid {
                --resource-panel-height: clamp(640px, calc(100dvh - 260px), 740px);
                /* Gives the map 65 percent while keeping form fields at their normal size. */
                grid-template-columns: minmax(0, 0.35fr) minmax(0, 0.65fr);
                align-items: start;
                height: auto;
                /* Gives the tall sticky card real travel space without resizing either card. */
                min-height: max(
                    calc(100dvh - var(--register-header-height, 80px) - 32px),
                    calc(var(--register-map-card-height, 1000px) + clamp(120px, 18dvh, 220px))
                );
                overflow: visible;
            }

            .resource-grid > .resource-card {
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                min-width: 0;
                min-height: 0;
                height: var(--resource-panel-height);
            }

            /* Stacks paired fields before the narrower form could clip their contents. */
            .form-card .form-row { grid-template-columns: minmax(0, 1fr); }
            .form-card .phone-row { grid-template-columns: 90px minmax(0, 1fr); }
            .form-card .form-group, .form-card .form-control { min-width: 0; max-width: 100%; }

            /* Keeps all normal-sized fields inside a shorter independent scroll area. */
            .resource-grid > .form-card {
                height: var(--resource-panel-height);
            }

            /* Stays below the real header height and stops at the grid boundary. */
            .resource-grid > .map-card {
                position: sticky;
                top: calc(var(--register-header-height, 80px) + 16px);
                align-self: start;
                height: auto;
                z-index: 1;
            }

            .form-card > .card-heading,
            .map-card > .map-card-header,
            .map-card > .map-help {
                flex: 0 0 auto;
            }

            /* Gives the fields their own scroll area, including validation and submit. */
            .form-card > form {
                flex: 1 1 0;
                min-height: 0;
                overflow-y: auto;
                scrollbar-gutter: stable;
                padding-right: 10px;
            }

            /* Makes the map visibly taller while preserving its width and surrounding layout. */
            .map-card > #resourceMap {
                flex: 0 0 auto;
                min-height: 0;
                height: clamp(600px, 75dvh, 800px);
            }

            /* Keeps the document as the scroll container for the sticky map. */
            .resource-page { overflow: visible; }
        }

        /* Keeps touch scrolling natural when the cards stack on tablets and phones. */
        @@media (max-width: 950px) {
            .site-header.portal-navigation-header { flex-wrap: wrap; gap: 16px; }
            .resource-grid { height: auto; min-height: 0; }
            .resource-grid > .map-card { position: static; }
            .form-card > form { max-height: none; overflow: visible; }
        }


        /* Matches Leaflet controls and keeps the fullscreen button easy to tap. */
        .resource-fullscreen-control button {
            display: grid; place-items: center; width: 40px; height: 40px;
            padding: 8px; border: 0; background: white; color: #17212b; cursor: pointer;
        }
        .resource-fullscreen-control button:hover { background: #f4f4f4; }
        .resource-fullscreen-control button:focus-visible { outline: 3px solid #176b87; outline-offset: -3px; }
        .resource-fullscreen-control svg { width: 22px; height: 22px; }
        /* Overrides normal card dimensions only while this same map is fullscreen. */
        #resourceMap:fullscreen, .resource-fullscreen-dialog #resourceMap {
            width: 100% !important; height: 100dvh !important;
            min-height: 0 !important; border: 0; border-radius: 0;
        }
        .resource-fullscreen-dialog {
            width: 100vw; max-width: none; height: 100dvh; max-height: none;
            margin: 0; padding: 0; border: 0; overflow: hidden;
        }
        .resource-fullscreen-dialog::backdrop { background: #17212b; }

    </style>

</head>


<body>


<!-- ==========================================
     HEADER
========================================== -->

<header class="site-header portal-navigation-header">

    <a
        asp-controller="Home"
        asp-action="Dashboard"
        class="brand">

        <div class="brand-icon">

            <svg
                viewBox="0 0 24 24"
                aria-hidden="true">

                <path
                    d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                />

                <path
                    d="M8.5 12.5L11 15l4.8-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

            </svg>

        </div>


        <div>

            <strong>
                Beredskapsportal
            </strong>

            <span>
                RessursleverandÃ¸r
            </span>

        </div>

    </a>

<nav class="provider-navigation">

    <a asp-controller="Home"
       asp-action="Dashboard"
       class="provider-nav-link">
        Dashboard
    </a>

    <a asp-controller="Resource"
       asp-action="RegisterResource"
       class="provider-nav-link active">
        Registrer ressurs
    </a>

    <a asp-controller="Resource"
       asp-action="ResourceOverview"
       class="provider-nav-link">
        Mine ressurser
    </a>

</nav>

    @* Reuses the role menu so RegisterResource receives the same active route styling. *@
    <partial name="_TopNavigation" />

    <div class="header-user">

        <div class="header-user-info">

            <strong>
                @userName
            </strong>

            <span>
                RessursleverandÃ¸r
            </span>

        </div>




    </div>

</header>


<!-- ==========================================
     PAGE
========================================== -->

<main class="resource-page">

    <section class="resource-top">

        <div>

            <span class="resource-eyebrow">
                Mine ressurser
            </span>


            <h1>
                Registrer ny ressurs
            </h1>


            <p>
                Registrer utstyr, kapasitet eller andre ressurser
                som kan stilles til disposisjon ved en
                beredskapssituasjon.
            </p>

        </div>


        <a
            asp-controller="Home"
            asp-action="Dashboard"
            class="back-button">

            â† Tilbake til oversikt

        </a>

    </section>


    <div class="resource-grid">


        <!-- ==========================================
             FORM
        =========================================== -->

        <section class="resource-card form-card">

            <div class="card-heading">

                <span>
                    Ressursinformasjon
                </span>

                <h2>
                    Hva kan du bidra med?
                </h2>

                <p>
                    Fyll inn informasjonen sÃ¥ presist som mulig.
                </p>

            </div>


            <form
                asp-controller="Resource"
                asp-action="RegisterResource"
                method="post">


                <div
                    asp-validation-summary="ModelOnly"
                    class="validation-summary">
                </div>


                <!-- ==================================
                     GRUNNINFORMASJON
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Grunninformasjon
                    </h3>

                 <!-- RESSURSNAVN -->
                <div class="form-group">

                    <label asp-for="ResourceName"></label>

                    <input
                        asp-for="ResourceName"
                        class="form-control"
                        placeholder="F.eks. Traktor med frontlaster" />

                    <span
                        asp-validation-for="ResourceName"
                        class="validation-message">
                    </span>

                </div>

                    <div class="form-group">

                        <label asp-for="ResourceType">
                            Ressurstype
                            <span class="required-mark">*</span>
                        </label>

                        <select
                            asp-for="ResourceType"
                            asp-items="Html.GetEnumSelectList<ResourceType>()"
                            class="form-control">

                            <option value="">
                                Velg type ressurs
                            </option>

                        </select>

                        <span
                            asp-validation-for="ResourceType"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="ResourceName">
                            Navn pÃ¥ ressurs
                            <span class="required-mark">*</span>
                        </label>

                        <input
                            asp-for="ResourceName"
                            class="form-control"
                            maxlength="100"
                            placeholder="F.eks. Volvo lastebil, aggregat 15 kW eller mÃ¸terom"
                        />

                        <span
                            asp-validation-for="ResourceName"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Description">
                            Beskrivelse
                            <span class="required-mark">*</span>
                        </label>

                        <textarea
                            asp-for="Description"
                            class="form-control"
                            maxlength="500"
                            placeholder="Beskriv ressursen, egenskaper og hva den kan brukes til">
                        </textarea>

                        <span
                            asp-validation-for="Description"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label asp-for="Quantity">
                                Antall
                            </label>

                            <input
