@using FirstWebAppInDocker.Models
@model FirstWebAppInDocker.ViewModels.RegisterResourceViewModel

@{
    Layout = null;

    ViewData["Title"] =
        "Registrer ressurs";

    string userName =
        Context.Session.GetString("UserName")
        ?? "Ressursleverandør";
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        Registrer ressurs - Beredskapsportal
    </title>


    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />


    <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />

    <style>

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            min-height: 100%;
        }


        body {
            background:
                var(--background);

            color:
                #17212b;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }


        button,
        input,
        select,
        textarea {
            font: inherit;
        }


        /* ==========================================
           HEADER
        ========================================== */

        .site-header {
            min-height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 24px;

            padding:
                14px 32px;

            background:
                var(--surface);

            border-bottom:
                1px solid #e5e9ec;
        }


        .brand {
            display: flex;
            align-items: center;

            gap: 12px;

            color:
                #123047;

            text-decoration:
                none;
        }


        .brand-icon {
            width: 42px;
            height: 42px;

            display: grid;
            place-items: center;

            border-radius:
                12px;

            background:
                #e7f5f1;

            color:
                #23855b;
        }


        .brand-icon svg {
            width: 25px;
            height: 25px;
        }


        .brand strong {
            display: block;

            font-size:
                1rem;
        }


        .brand span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.72rem;

                @* Collects the model fields needed to save a complete resource in MariaDB. *@
                <div class="form-group">
                    <label asp-for="ResourceName"></label>
                    <input asp-for="ResourceName" type="text" class="form-control" />
                    <span asp-validation-for="ResourceName" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Quantity"></label>
                    <input asp-for="Quantity" type="number" class="form-control" />
                    <span asp-validation-for="Quantity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" type="text" class="form-control" />
                    <span asp-validation-for="Capacity" class="validation-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" type="text" class="form-control" />
                    <span asp-validation-for="Address" class="validation-message"></span>
                </div>
                @* Fixed status values keep dashboard counts and overview filters consistent. *@
                <div class="form-group">
                    <label asp-for="Availability"></label>
                    <select asp-for="Availability" class="form-control">
                        <option value="">Ikke oppgitt</option>
                        <option value="Tilgjengelig">Tilgjengelig</option>
                        <option value="Ikke tilgjengelig">Ikke tilgjengelig</option>
                    </select>
                    <span asp-validation-for="Availability" class="validation-message"></span>
                </div>

                <!-- BESKRIVELSE -->
                <div class="form-group">
            font-weight:
                700;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        .header-user {
            display: flex;
            align-items: center;

            gap: 18px;
        }


        .header-user-info {
            text-align: right;
        }


        .header-user-info strong {
            display: block;

            color:
                #123047;

            font-size:
                0.92rem;
        }


        .header-user-info span {
            display: block;

            margin-top:
                2px;

            color:
                #667085;

            font-size:
                0.78rem;
        }


        .logout-button {
            border:
                1px solid #d5dce1;

            border-radius:
                9px;

            padding:
                9px 14px;

            background:
                var(--surface);

            color:
                #344054;

            cursor:
                pointer;

            font-weight:
                700;
        }


        .logout-button:hover {
            background:
                #f7f9fa;
        }


        /* ==========================================
           PAGE
        ========================================== */

        /* Uses more desktop width while keeping the original page margins. */
        .resource-page {
            width:
                min(
                    1500px,
                    calc(100% - 48px)
                );

            margin:
                0 auto;

            padding:
                28px 0 44px;
        }


        .resource-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 24px;

            margin-bottom:
                26px;
        }


        .resource-eyebrow {
            display: inline-block;

            margin-bottom:
                10px;

            color:
                #187052;

            font-size:
                0.75rem;

            font-weight:
                850;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        /* Balances the title with the navigation and the larger cards below. */
        .resource-top h1 {
            margin:
                0 0 8px;

            color:
                #102d42;

            font-size:
                clamp(
                    1.8rem,
                    2.7vw,
                    2.5rem
                );

            line-height:
                1.02;
        }


        .resource-top p {
            max-width:
                700px;

            margin:
                0;

            color:
                #667085;

            font-size:
                1rem;

            line-height:
                1.65;
        }


        .back-button {
            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            min-height:
                44px;

            padding:
                0 17px;

            border:
                1px solid #d5dce1;

            border-radius:
                10px;

            background:
                var(--surface);

            color:
                #344054;

            text-decoration:
                none;

            font-weight:
                750;

            white-space:
                nowrap;
        }


        .back-button:hover {
            background:
                var(--surface-soft);
        }


        /* ==========================================
           GRID
        ========================================== */

        .resource-grid {
            display:
                grid;

            grid-template-columns:
                minmax(420px, 0.8fr)
                minmax(600px, 1.35fr);

            gap:
                24px;

            align-items:
                start;
        }


        .resource-card {
            border:
                1px solid #dfe5e9;

            border-radius:
                18px;

            background:
                var(--surface);

            box-shadow:
                0 12px 35px
                rgba(16, 45, 66, 0.05);
        }


        .form-card {
            padding:
                28px;
        }


        .map-card {
            padding:
                22px;
        }


        .card-heading {
            margin-bottom:
                24px;
        }


        .card-heading span {
            display:
                inline-block;

            margin-bottom:
                7px;

            color:
                #23855b;

            font-size:
                0.72rem;

            font-weight:
                850;

            letter-spacing:
                0.08em;

            text-transform:
                uppercase;
        }


        .card-heading h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .card-heading p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.55;
        }


        /* ==========================================
           FORM
        ========================================== */

        .form-section {
            padding:
                0 0 24px;

            margin-bottom:
                24px;

            border-bottom:
                1px solid #edf0f2;
        }


        .form-section:last-of-type {
            margin-bottom:
                20px;
        }


        .form-section-title {
            margin:
                0 0 18px;

            color:
                #123047;

            font-size:
                0.95rem;

            font-weight:
                800;
        }


        .form-group {
            margin-bottom:
                18px;
        }


        .form-group:last-child {
            margin-bottom:
                0;
        }


        .form-row {
            display:
                grid;

            grid-template-columns:
                1fr 1fr;

            gap:
                14px;
        }


        .form-group label {
            display:
                block;

            margin-bottom:
                7px;

            color:
                #27364a;

            font-size:
                0.88rem;

            font-weight:
                750;
        }


        .required-mark {
            color:
                #b42318;
        }


        .form-control,
        .country-code {
            width:
                100%;

            min-height:
                48px;

            border:
                1px solid #ccd5dc;

            border-radius:
                10px;

            padding:
                11px 13px;

            background:
                var(--surface);

            color:
                #17212b;

            outline:
                none;
        }


        textarea.form-control {
            min-height:
                115px;

            resize:
                vertical;
        }


        .form-control:focus,
        .country-code:focus {
            border-color:
                #23855b;

            box-shadow:
                0 0 0 3px
                rgba(35, 133, 91, 0.11);
        }


        .form-control::placeholder {
            color:
                #98a2b3;
        }


        .field-note {
            display:
                block;

            margin-top:
                6px;

            color:
                #7a8695;

            font-size:
                0.78rem;

            line-height:
                1.4;
        }


        .validation-message {
            display:
                block;

            margin-top:
                6px;

            color:
                #b42318;

            font-size:
                0.82rem;

            font-weight:
                600;
        }


        .validation-summary {
            margin-bottom:
                20px;

            color:
                #b42318;
        }


        .validation-summary ul {
            margin:
                0;

            padding-left:
                20px;
        }


        .phone-row {
            display:
                grid;

            grid-template-columns:
                105px 1fr;

            gap:
                10px;
        }


        .selected-position {
            display:
                flex;

            flex-direction:
                column;

            gap:
                5px;

            margin-top:
                16px;

            padding:
                13px 14px;

            border-radius:
                10px;

            background:
                #f4f7f6;

            color:
                #344054;
        }


        .selected-position strong {
            color:
                #123047;

            font-size:
                0.82rem;
        }


        .selected-position span {
            font-size:
                0.88rem;
        }


        .submit-button {
            width:
                100%;

            min-height:
                52px;

            border:
                0;

            border-radius:
                11px;

            background:
                #23855b;

            color:
                var(--surface);

            cursor:
                pointer;

            font-weight:
                800;
        }


        .submit-button:hover {
            background:
                #1d704d;
        }


        /* ==========================================
           MAP
        ========================================== */

        .map-card-header {
            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-start;

            gap:
                18px;

            margin-bottom:
                16px;
        }


        .map-card-header h2 {
            margin:
                0 0 6px;

            color:
                #123047;

            font-size:
                1.35rem;
        }


        .map-card-header p {
            margin:
                0;

            color:
                #667085;

            line-height:
                1.5;
        }


        .map-badge {
            flex:
                0 0 auto;

            padding:
                7px 10px;

            border-radius:
                999px;

            background:
                #e8f5ef;

            color:
                #187052;

            font-size:
                0.72rem;

            font-weight:
                800;
        }


        #resourceMap {
            width:
                100%;

            height:
                650px;

            border:
                1px solid #d8e0e5;

            border-radius:
                14px;

            overflow:
                hidden;
        }


        .map-help {
            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                10px;

            margin-top:
                15px;
        }


        .map-help-item {
            padding:
                12px;

            border-radius:
                10px;

            background:
                #f7f9fa;
        }


        .map-help-item strong {
            display:
                block;

            margin-bottom:
                4px;

            color:
                #123047;

            font-size:
                0.8rem;
        }


        .map-help-item span {
            color:
                #667085;

            font-size:
                0.75rem;

            line-height:
                1.4;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @@media (max-width: 1150px) {

            .resource-grid {
                grid-template-columns:
                    minmax(380px, 0.85fr)
                    minmax(500px, 1.15fr);
            }


            #resourceMap {
                height:
                    520px;
            }

        }


        @@media (max-width: 950px) {

            .resource-grid {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    460px;
            }

        }


        @@media (max-width: 700px) {

            .site-header {
                padding:
                    12px 18px;
            }


            .header-user-info {
                display:
                    none;
            }


            .resource-page {
                width:
                    min(
                        100% - 28px,
                        1550px
                    );

                padding-top:
                    28px;
            }


            .resource-top {
                flex-direction:
                    column;
            }


            .form-card,
            .map-card {
                padding:
                    19px;
            }


            .form-row {
                grid-template-columns:
                    1fr;
            }


            .map-help {
                grid-template-columns:
                    1fr;
            }


            #resourceMap {
                height:
                    420px;
            }

        }


        /* Balances the columns and uses the dashboard map height as the desktop reference. */
        @@media (min-width: 951px) {
            /* Keeps the shared navigation visible above the sticky map. */
            .site-header.portal-navigation-header {
                position: sticky;
                top: 0;
                z-index: 1100;
                flex-wrap: wrap;
                gap: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
            }

            .resource-grid {
                --resource-panel-height: clamp(640px, calc(100dvh - 260px), 740px);
                /* Gives the map 65 percent while keeping form fields at their normal size. */
                grid-template-columns: minmax(0, 0.35fr) minmax(0, 0.65fr);
                align-items: start;
                height: auto;
                /* Gives the tall sticky card real travel space without resizing either card. */
                min-height: max(
                    calc(100dvh - var(--register-header-height, 80px) - 32px),
                    calc(var(--register-map-card-height, 1000px) + clamp(120px, 18dvh, 220px))
                );
                overflow: visible;
            }

            .resource-grid > .resource-card {
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                min-width: 0;
                min-height: 0;
                height: var(--resource-panel-height);
            }

            /* Stacks paired fields before the narrower form could clip their contents. */
            .form-card .form-row { grid-template-columns: minmax(0, 1fr); }
            .form-card .phone-row { grid-template-columns: 90px minmax(0, 1fr); }
            .form-card .form-group, .form-card .form-control { min-width: 0; max-width: 100%; }

            /* Keeps all normal-sized fields inside a shorter independent scroll area. */
            .resource-grid > .form-card {
                height: var(--resource-panel-height);
            }

            /* Stays below the real header height and stops at the grid boundary. */
            .resource-grid > .map-card {
                position: sticky;
                top: calc(var(--register-header-height, 80px) + 16px);
                align-self: start;
                height: auto;
                z-index: 1;
            }

            .form-card > .card-heading,
            .map-card > .map-card-header,
            .map-card > .map-help {
                flex: 0 0 auto;
            }

            /* Gives the fields their own scroll area, including validation and submit. */
            .form-card > form {
                flex: 1 1 0;
                min-height: 0;
                overflow-y: auto;
                scrollbar-gutter: stable;
                padding-right: 10px;
            }

            /* Makes the map visibly taller while preserving its width and surrounding layout. */
            .map-card > #resourceMap {
                flex: 0 0 auto;
                min-height: 0;
                height: clamp(600px, 75dvh, 800px);
            }

            /* Keeps the document as the scroll container for the sticky map. */
            .resource-page { overflow: visible; }
        }

        /* Keeps touch scrolling natural when the cards stack on tablets and phones. */
        @@media (max-width: 950px) {
            .site-header.portal-navigation-header { flex-wrap: wrap; gap: 16px; }
            .resource-grid { height: auto; min-height: 0; }
            .resource-grid > .map-card { position: static; }
            .form-card > form { max-height: none; overflow: visible; }
        }


        /* Matches Leaflet controls and keeps the fullscreen button easy to tap. */
        .resource-fullscreen-control button {
            display: grid; place-items: center; width: 40px; height: 40px;
            padding: 8px; border: 0; background: white; color: var(--text); cursor: pointer;
        }
        .resource-fullscreen-control button:hover { background: #f4f4f4; }
        .resource-fullscreen-control button:focus-visible { outline: 3px solid #176b87; outline-offset: -3px; }
        .resource-fullscreen-control svg { width: 22px; height: 22px; }
        /* Overrides normal card dimensions only while this same map is fullscreen. */
        #resourceMap:fullscreen, .resource-fullscreen-dialog #resourceMap {
            width: 100% !important; height: 100dvh !important;
            min-height: 0 !important; border: 0; border-radius: 0;
        }
        .resource-fullscreen-dialog {
            width: 100vw; max-width: none; height: 100dvh; max-height: none;
            margin: 0; padding: 0; border: 0; overflow: hidden;
        }
        .resource-fullscreen-dialog::backdrop { background: #17212b; }

    </style>

    <!-- Fargetema: lyst/mørkt tema -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>


<body>


<!-- ==========================================
     HEADER
========================================== -->

<partial name="_PortalHeader" />


<!-- ==========================================
     PAGE
========================================== -->

<main class="resource-page">

    <section class="resource-top">

        <div>

            <span class="resource-eyebrow">
                Mine ressurser
            </span>


            <h1>
                Registrer ny ressurs
            </h1>


            <p>
                Registrer utstyr, kapasitet eller andre ressurser
                som kan stilles til disposisjon ved en
                beredskapssituasjon.
            </p>

        </div>


        <a
            asp-controller="Home"
            asp-action="Dashboard"
            class="back-button">

            ← Tilbake til oversikt

        </a>

    </section>


    <div class="resource-grid">


        <!-- ==========================================
             FORM
        =========================================== -->

        <section class="resource-card form-card">

            <div class="card-heading">

                <span>
                    Ressursinformasjon
                </span>

                <h2>
                    Hva kan du bidra med?
                </h2>

                <p>
                    Fyll inn informasjonen så presist som mulig.
                </p>

            </div>


            <form
                asp-controller="Resource"
                asp-action="RegisterResource"
                method="post">


                <div
                    asp-validation-summary="ModelOnly"
                    class="validation-summary">
                </div>


                <!-- ==================================
                     GRUNNINFORMASJON
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Grunninformasjon
                    </h3>


                    <div class="form-group">

                        <label asp-for="ResourceType">
                            Ressurstype
                            <span class="required-mark">*</span>
                        </label>

                        <select
                            asp-for="ResourceType"
                            asp-items="Html.GetEnumSelectList<ResourceType>()"
                            class="form-control">

                            <option value="">
                                Velg type ressurs
                            </option>

                        </select>

                        <span
                            asp-validation-for="ResourceType"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="ResourceName">
                            Navn på ressurs
                            <span class="required-mark">*</span>
                        </label>

                        <input
                            asp-for="ResourceName"
                            class="form-control"
                            maxlength="100"
                            placeholder="F.eks. Volvo lastebil, aggregat 15 kW eller møterom"
                        />

                        <span
                            asp-validation-for="ResourceName"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Description">
                            Beskrivelse
                            <span class="required-mark">*</span>
                        </label>

                        <textarea
                            asp-for="Description"
                            class="form-control"
                            maxlength="500"
                            placeholder="Beskriv ressursen, egenskaper og hva den kan brukes til">
                        </textarea>

                        <span
                            asp-validation-for="Description"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label asp-for="Quantity">
                                Antall
                            </label>

                            <input
                                asp-for="Quantity"
                                class="form-control"
                                type="number"
                                min="1"
                                max="100000"
                            />

                            <span
                                asp-validation-for="Quantity"
                                class="validation-message">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Capacity">
                                Kapasitet
                            </label>

                            <input
                                asp-for="Capacity"
                                class="form-control"
                                maxlength="200"
                                placeholder="F.eks. 10 tonn / 15 kW"
                            />

                            <span
                                asp-validation-for="Capacity"
                                class="validation-message">
                            </span>

                        </div>

                    </div>


                    <div class="form-group">

                        <label asp-for="Availability">
                            Tilgjengelighet
                        </label>

                        <input
                            asp-for="Availability"
                            class="form-control"
                            maxlength="200"
                            placeholder="F.eks. tilgjengelig nå, etter avtale eller hverdager 08–16"
                        />

                        <span
                            asp-validation-for="Availability"
                            class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- ==================================
                     PLASSERING
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Plassering
                    </h3>


                    <div class="form-group">

                        <label asp-for="Address">
                            Adresse / område
                        </label>

                        <input
                            asp-for="Address"
                            class="form-control"
                            maxlength="200"
                            placeholder="F.eks. Kristiansand, Vennesla eller gateadresse"
                        />

                        <span
                            asp-validation-for="Address"
                            class="validation-message">
                        </span>

                        <small class="field-note">
                            Velg også nøyaktig plassering i kartet.
                        </small>

                    </div>


                    <input
                        asp-for="Latitude"
                        type="hidden"
                        id="Latitude"
                    />


                    <input
                        asp-for="Longitude"
                        type="hidden"
                        id="Longitude"
                    />


                    <div class="selected-position">

                        <strong>
                            Valgt kartposisjon
                        </strong>

                        <span id="positionText">
                            Ingen plassering valgt
                        </span>

                    </div>


                    <span
                        asp-validation-for="Latitude"
                        class="validation-message">
                    </span>

                    <span
                        asp-validation-for="Longitude"
                        class="validation-message">
                    </span>

                </div>


                <!-- ==================================
                     KONTAKT
                =================================== -->

                <div class="form-section">

                    <h3 class="form-section-title">
                        Kontaktinformasjon
                    </h3>


                    <div class="form-group">

                        <label asp-for="ContactEmail">
                            Kontakt-e-post
                        </label>

                        <input
                            asp-for="ContactEmail"
                            class="form-control"
                            type="email"
                            maxlength="150"
                            placeholder="navn@eksempel.no"
                        />

                        <small class="field-note">
                            Hvis feltet står tomt brukes e-posten
                            til den innloggede brukeren.
                        </small>

                        <span
                            asp-validation-for="ContactEmail"
                            class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label>
                            Telefonnummer
                        </label>

                        <div class="phone-row">

                            <select
                                asp-for="ContactPhoneCountryCode"
                                class="country-code">

                                <option value="+47">
                                    +47
                                </option>

                                <option value="+45">
                                    +45
                                </option>

                                <option value="+46">
                                    +46
                                </option>

                            </select>


                            <input
                                asp-for="ContactPhoneNumber"
                                class="form-control"
                                maxlength="20"
                                placeholder="12345678"
                            />

                        </div>

                        <span
                            asp-validation-for="ContactPhoneNumber"
                            class="validation-message">
                        </span>

                    </div>

                </div>


                <button
                    type="submit"
                    class="submit-button">

                    Registrer ressurs

                </button>

            </form>

        </section>


        <!-- ==========================================
             MAP
        =========================================== -->

        <section class="resource-card map-card">

            <div class="map-card-header">

                <div>

                    <h2>
                        Velg plassering
                    </h2>

                    <p>
                        Klikk i kartet der ressursen befinner seg.
                    </p>

                </div>


                <span class="map-badge">
                    Leaflet
                </span>

            </div>


            <div id="resourceMap"></div>


            <div class="map-help">

                <div class="map-help-item">

                    <strong>
                        1. Finn området
                    </strong>

                    <span>
                        Zoom og flytt kartet til riktig sted.
                    </span>

                </div>


                <div class="map-help-item">

                    <strong>
                        2. Klikk i kartet
                    </strong>

                    <span>
                        En markør viser den valgte posisjonen.
                    </span>

                </div>


                <div class="map-help-item">

                    <strong>
                        3. Registrer
                    </strong>

                    <span>
                        Koordinatene lagres sammen med ressursen.
                    </span>

                </div>

            </div>

        </section>

    </div>

</main>


<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

<script src="~/js/kartverket.js" asp-append-version="true"></script>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function ()
        {
            const latitudeInput =
                document.getElementById(
                    "Latitude"
                );


            const longitudeInput =
                document.getElementById(
                    "Longitude"
                );


            const positionText =
                document.getElementById(
                    "positionText"
                );


            const defaultLatitude =
                58.1467;


            const defaultLongitude =
                7.9956;


            const map =
                L.map(
                    "resourceMap"
                )
                .setView(
                    [
                        defaultLatitude,
                        defaultLongitude
                    ],
                    10
                );


            // Reuses one Leaflet map so fullscreen never rebuilds layers or selected coordinates.
            const mapElement = document.getElementById("resourceMap");
            const fullscreenDialog = document.createElement("dialog");
            fullscreenDialog.className = "resource-fullscreen-dialog";
            fullscreenDialog.setAttribute("aria-label", "Ressurskart i fullskjerm");
            document.body.appendChild(fullscreenDialog);
            let mapPlaceholder;
            let fullscreenButton;
            const expandIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>';
            const collapseIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6"/></svg>';

            function isMapFullscreen() {
                return document.fullscreenElement === mapElement || fullscreenDialog.open;
            }

            // Refreshes the viewport while explicitly retaining the current map center and zoom.
            function refreshMapSize() {
                const center = map.getCenter();
                const zoom = map.getZoom();
                map.invalidateSize({ pan: false });
                map.setView(center, zoom, { animate: false, reset: true });
            }

            function updateFullscreenControl() {
                const expanded = isMapFullscreen();
                const label = expanded ? "Avslutt fullskjerm" : "Vis i fullskjerm";
                fullscreenButton.title = label;
                fullscreenButton.setAttribute("aria-label", label);
                fullscreenButton.setAttribute("aria-pressed", String(expanded));
                fullscreenButton.innerHTML = expanded ? collapseIcon : expandIcon;
                requestAnimationFrame(refreshMapSize);
            }

            // Uses a top-layer dialog on browsers that cannot fullscreen arbitrary elements.
            function openFullscreenDialog() {
                mapPlaceholder = document.createComment("Original resource map position");
                mapElement.before(mapPlaceholder);
                fullscreenDialog.appendChild(mapElement);
                fullscreenDialog.showModal();
                updateFullscreenControl();
                fullscreenButton.focus();
            }

            fullscreenDialog.addEventListener("close", function () {
                if (mapPlaceholder) {
                    mapPlaceholder.replaceWith(mapElement);
                    mapPlaceholder = null;
                }
                updateFullscreenControl();
                fullscreenButton.focus({ preventScroll: true });
            });
            // Escape closes the dialog automatically; native fullscreen emits fullscreenchange.
            document.addEventListener("fullscreenchange", updateFullscreenControl);
            // Also handles Escape explicitly where browser fullscreen keys are not forwarded.
            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape" || !isMapFullscreen()) return;
                event.preventDefault();
                if (fullscreenDialog.open) fullscreenDialog.close();
                else document.exitFullscreen();
            });

            const FullscreenControl = L.Control.extend({
                options: { position: "topright" },
                onAdd: function () {
                    const control = L.DomUtil.create("div", "leaflet-bar resource-fullscreen-control");
                    fullscreenButton = L.DomUtil.create("button", "", control);
                    fullscreenButton.type = "button";
                    L.DomEvent.disableClickPropagation(control);
                    L.DomEvent.disableScrollPropagation(control);
                    fullscreenButton.addEventListener("click", async function (event) {
                        // Prevents the same click from selecting coordinates after moving the map.
                        event.preventDefault();
                        event.stopPropagation();
                        if (fullscreenDialog.open) {
                            fullscreenDialog.close();
                        } else if (document.fullscreenElement === mapElement) {
                            await document.exitFullscreen();
                        } else if (mapElement.requestFullscreen && document.fullscreenEnabled) {
                            try {
                                await mapElement.requestFullscreen();
                            } catch {
                                openFullscreenDialog();
                            }
                        } else {
                            openFullscreenDialog();
                        }
                    });
                    return control;
                }
            });
            new FullscreenControl().addTo(map);
            updateFullscreenControl();

            addKartverketLayers(map);

            let marker =
                null;


            // Dersom skjemaet returneres etter
            // valideringsfeil, behold valgt posisjon.

            const existingLatitude =
                parseFloat(
                    latitudeInput.value
                );


            const existingLongitude =
                parseFloat(
                    longitudeInput.value
                );


            if (
                !Number.isNaN(
                    existingLatitude
                )
                &&
                !Number.isNaN(
                    existingLongitude
                )
                &&
                (
                    existingLatitude !== 0
                    ||
                    existingLongitude !== 0
                )
            )
            {
                marker =
                    L.marker(
                        [
                            existingLatitude,
                            existingLongitude
                        ]
                    )
                    .addTo(
                        map
                    );


                map.setView(
                    [
                        existingLatitude,
                        existingLongitude
                    ],
                    14
                );


                updatePositionText(
                    existingLatitude,
                    existingLongitude
                );
            }


            map.on(
                "click",
                function (event)
                {
                    const latitude =
                        event.latlng.lat;


                    const longitude =
                        event.latlng.lng;


                    latitudeInput.value =
                        latitude;


                    longitudeInput.value =
                        longitude;


                    if (marker === null)
                    {
                        marker =
                            L.marker(
                                [
                                    latitude,
                                    longitude
                                ]
                            )
                            .addTo(
                                map
                            );
                    }
                    else
                    {
                        marker.setLatLng(
                            [
                                latitude,
                                longitude
                            ]
                        );
                    }


                    updatePositionText(
                        latitude,
                        longitude
                    );
                }
            );


            function updatePositionText(
                latitude,
                longitude
            )
            {
                positionText.textContent =
                    latitude.toFixed(5)
                    +
                    ", "
                    +
                    longitude.toFixed(5);
            }


            // Measures wrapped navigation so the sticky map never overlaps the header.
            const registerHeader = document.querySelector(".site-header");
            function updateHeaderOffset() {
                document.documentElement.style.setProperty(
                    "--register-header-height", registerHeader.offsetHeight + "px");
            }
            updateHeaderOffset();
            window.addEventListener("resize", updateHeaderOffset);
            if (typeof ResizeObserver !== "undefined") {
                const headerSizeObserver = new ResizeObserver(updateHeaderOffset);
                headerSizeObserver.observe(registerHeader);
            }

            // Measures the complete card so its parent cannot collapse to the sticky height.
            const registerGrid = document.querySelector(".resource-grid");
            const registerMapCard = document.querySelector(".map-card");
            function updateStickyBounds() {
                if (isMapFullscreen()) return;
                registerGrid.style.setProperty(
                    "--register-map-card-height", registerMapCard.offsetHeight + "px");
            }
            updateStickyBounds();
            window.addEventListener("resize", updateStickyBounds);
            if (typeof ResizeObserver !== "undefined") {
                const stickyBoundsObserver = new ResizeObserver(updateStickyBounds);
                stickyBoundsObserver.observe(registerMapCard);
            }

            // Refreshes Leaflet when responsive layout changes the map container size.
            if (typeof ResizeObserver !== "undefined")
            {
                const mapSizeObserver = new ResizeObserver(function () {
                    refreshMapSize();
                });
                mapSizeObserver.observe(document.getElementById("resourceMap"));
            }

            // Leaflet trenger noen ganger dette
            // etter at layouten er ferdig rendret.

            window.setTimeout(
                function ()
                {
                    map.invalidateSize();
                },
                100
            );
        }
    );

</script>


<partial name="_Sami" />
</body>

</html>