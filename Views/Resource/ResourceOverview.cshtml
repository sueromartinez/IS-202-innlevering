                1fr;
        }

    }


    @@media (max-width: 700px) {

        .provider-header {
            padding:
                12px 16px;
        }


        .provider-user-text,
        .dashboard-link {
            display: none;
        }


        .provider-brand span {
            display: none;
        }


        .overview-page {
            width:
                min(
                    100% - 24px,
                    1650px
                );
        }


        .overview-header {
            align-items: flex-start;

            flex-direction: column;

            gap: 18px;
        }


        .primary-button {
            width: 100%;
        }


        .resource-list-card {
            padding:
                20px 17px;
        }


        .resource-item-top {
            grid-template-columns:
                42px minmax(0, 1fr);
        }


        .resource-status {
            width: max-content;

            grid-column:
                2;
        }


        .resource-meta {
            grid-template-columns:
                1fr;
        }


        .map-card-header {
            flex-direction: column;
        }


        #resourceOverviewMap {
            height: 360px;
        }


        .overview-help {
            padding:
                22px 18px;
        }

    }


    /* Keeps navigation visible and allows buttons to wrap on small screens. */
    .provider-header { flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; gap: 16px; }
    .overview-navigation { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .overview-navigation a { padding: 10px 12px; border-radius: 8px; color: var(--navy); font-size: .8rem; font-weight: 700; }
    .overview-navigation a:hover { background: #eef5f8; }
    .overview-navigation a[aria-current="page"] { background: var(--primary); color: white; }
    .overview-navigation form { margin: 0; }
    .overview-navigation :focus-visible, .resource-filters :focus-visible, .map-focus-button:focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; }

    /* Gives filters clear labels and keeps the map at a moderate height. */
    [hidden] { display: none !important; }
    .resource-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; padding: 20px; margin-bottom: 20px; background: white; border: 1px solid var(--border); border-radius: 15px; }
    .filter-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; flex: 1 1 200px; }
    .filter-search { flex-grow: 2; }
    .filter-field label { font-weight: 700; font-size: .85rem; color: var(--navy); }
    .filter-field select, .filter-field input { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: white; color: var(--text); font: inherit; }
    .resource-filters button { min-height: 44px; }
    #filterSummary { flex-basis: 100%; margin: 0; color: var(--secondary); font-size: .85rem; }
    .filter-empty { color: var(--secondary); line-height: 1.6; }
    .resource-item { overflow-wrap: anywhere; }
    #resourceOverviewMap { height: 460px; }
    .resource-list { max-height: 460px; }
    @@media (max-width: 950px) {
        .provider-header { justify-content: flex-start; }
        .overview-navigation { order: 3; flex-basis: 100%; }
        .provider-user-text { margin-left: auto; }
        .resource-list { max-height: 400px; }
    }
    @@media (max-width: 700px) {
        .overview-navigation a { flex: 1 1 auto; text-align: center; }
        .resource-filters { padding: 16px; }
        .filter-field { flex-basis: 100%; }
        #resourceOverviewMap { height: 340px; }
    }

</style>


@if (resources.Any())
{
    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

<script src="~/js/kartverket.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const resources = @Html.Raw(mapResourcesJson);
            const filterForm = document.getElementById("resourceFilters");
            const typeFilter = document.getElementById("resourceTypeFilter");
            const availabilityFilter = document.getElementById("resourceAvailabilityFilter");
            const searchInput = document.getElementById("resourceSearch");
            const cards = new Map(Array.from(document.querySelectorAll(".resource-item"))
                .map(card => [Number(card.dataset.resourceId), card]));
            const markers = new Map();
            let map;

            // Keeps unknown legacy availability text separate from explicit statuses.
            function availabilityStatus(value) {
                const status = (value || "").trim().toLocaleLowerCase("nb-NO");
                return ["tilgjengelig", "ikke tilgjengelig"].includes(status) ? status : "unspecified";
            }

            // Applies all filters to the same resources before updating cards and markers.
            function applyFilters() {
                const search = searchInput.value.trim().toLocaleLowerCase("nb-NO");
                const matching = resources.filter(resource =>
                    (typeFilter.value === "" || String(resource.typeId) === typeFilter.value) &&
                    (availabilityFilter.value === "" || availabilityStatus(resource.availability) === availabilityFilter.value.toLocaleLowerCase("nb-NO")) &&
                    `${resource.name} ${resource.description}`.toLocaleLowerCase("nb-NO").includes(search));
                const matchingIds = new Set(matching.map(resource => resource.id));
                cards.forEach((card, id) => { card.hidden = !matchingIds.has(id); });
                document.getElementById("filteredResourceCount").textContent = matching.length;
                document.getElementById("filterSummary").textContent =
                    `Viser ${matching.length} av ${resources.length} ressurser`;
                document.getElementById("noMatchingResources").hidden = matching.length !== 0;

                // Removes hidden markers and fits the map to the matching resources.
                if (map) {
                    map.closePopup();
                    markers.forEach((marker, id) => {
                        if (matchingIds.has(id)) marker.addTo(map);
                        else marker.remove();
                    });
                    const visibleMarkers = matching.map(resource => markers.get(resource.id));
                    if (visibleMarkers.length > 0) {
                        map.fitBounds(L.featureGroup(visibleMarkers).getBounds(), {
                            padding: [30, 30], maxZoom: 13
                        });
                    }
                }
            }

            // Keeps list filtering available if the external map library cannot load.
            filterForm.hidden = false;
            filterForm.addEventListener("submit", event => event.preventDefault());
            typeFilter.addEventListener("change", applyFilters);
            availabilityFilter.addEventListener("change", applyFilters);
            searchInput.addEventListener("input", applyFilters);
            filterForm.addEventListener("reset", function () {
                typeFilter.value = "";
                availabilityFilter.value = "";
                searchInput.value = "";
                applyFilters();
            });
            if (typeof L === "undefined") {
                document.getElementById("mapUnavailable").hidden = false;
                document.querySelectorAll(".map-focus-button").forEach(button => { button.disabled = true; });
                applyFilters();
                return;
            }

            // Reuses Leaflet, Kartverket tiles and the existing marker design.
            map = L.map("resourceOverviewMap").setView([58.1467, 7.9956], 10);
            addKartverketLayers(map);
            const resourceIcon = L.divIcon({
                className: "resource-map-marker",
                html: '<div class="resource-map-dot"><span></span></div>',
                iconSize: [34, 38], iconAnchor: [17, 36], popupAnchor: [0, -32]
            });

            // Uses textContent so resource descriptions and contact details stay plain text.
            resources.forEach(resource => {
                const marker = L.marker([resource.latitude, resource.longitude], { icon: resourceIcon });
                const popup = document.createElement("div");
                popup.className = "resource-popup";
                const details = [
                    ["span", resource.type, "resource-popup-type"],
                    ["strong", resource.name || resource.description],
                    ["p", resource.description],
                    ["small", resource.availability || "Ikke oppgitt"],
                    ["p", `${resource.latitude.toFixed(5)}, ${resource.longitude.toFixed(5)}`],
                    ["small", resource.email],
                    ["small", resource.phone]
                ];
                details.forEach(([tag, text, className]) => {
                    if (!text) return;
                    const element = document.createElement(tag);
                    element.textContent = text;
                    if (className) element.className = className;
                    popup.appendChild(element);
                });
                marker.bindPopup(popup);
                markers.set(resource.id, marker);
            });

            // Finds the marker by resource ID, including resources at the same coordinates.
            document.querySelectorAll(".map-focus-button").forEach(button => {
                button.addEventListener("click", function () {
                    const id = Number(button.closest(".resource-item").dataset.resourceId);
                    const marker = markers.get(id);
                    map.setView(marker.getLatLng(), 14);
                    marker.openPopup();
                    document.getElementById("resourceOverviewMap").scrollIntoView({
                        behavior: "smooth", block: "center"
                    });
                });
            });
            applyFilters();
        });
    </script>
}


</body>

</html>