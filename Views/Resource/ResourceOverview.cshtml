
@using FirstWebAppInDocker.Models
@using System.Text.Json
@using System.Globalization
@model IEnumerable<FirstWebAppInDocker.ViewModels.ResourceOverviewViewModel>

@{
    Layout = null;

    string? userRole = ViewBag.UserRole as string
        ?? Context.Session.GetString("UserRole");

    bool isResourceProvider = userRole == "ResourceProvider";

    string pageTitle = isResourceProvider
        ? "Mine ressurser"
        : "Ressursoversikt";

    ViewData["Title"] = pageTitle;

    var resources = Model.ToList();

    var resourceTypeNames = Html.GetEnumSelectList<ResourceType>()
        .ToDictionary(
            item => int.Parse(item.Value),
            item => item.Text
        );

    string GetResourceTypeName(ResourceType resourceType)
    {
        return resourceTypeNames.TryGetValue(
            (int)resourceType,
            out string? name
        ) ? name : resourceType.ToString();
    }

    string GetResourceIcon(ResourceType resourceType)
    {
        return resourceType switch
        {
            ResourceType.Transport => "T",
            ResourceType.Drone => "D",
            ResourceType.Generator => "A",
            ResourceType.Machinery => "M",
            ResourceType.CommunicationEquipment => "S",
            ResourceType.Personnel => "P",
            ResourceType.Premises => "L",
            ResourceType.SandAndGravel => "G",
            ResourceType.Boat => "B",
            _ => "R"
        };
    }

    int resourceTypeCount = resources
        .Select(resource => resource.ResourceType)
        .Distinct()
        .Count();

    var mapResources = resources.Select(resource => new
    {
        id = resource.Id,
        name = resource.ResourceName,
        availability = resource.EffectiveStatus.ToString(),
        typeId = (int)resource.ResourceType,
        typeKey = resource.ResourceType.ToString(),
        type = GetResourceTypeName(resource.ResourceType),
        description = resource.Description,
        latitude = resource.Position.Latitude,
        longitude = resource.Position.Longitude,
        email = resource.ContactEmail,
        phone = string.IsNullOrWhiteSpace(resource.ContactPhoneNumber)
            ? null
            : $"{resource.ContactPhoneCountryCode} {resource.ContactPhoneNumber}"
    }).ToList();

    string mapResourcesJson = JsonSerializer.Serialize(
        mapResources,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - Beredskapsportal</title>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet"
          href="~/css/top-navigation.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />

    <script src="~/js/theme.js"
            asp-append-version="true"></script>

    <style>
        /* ==========================================
           GRUNNLEGGENDE DESIGN
        ========================================== */

        :root {
            --overview-navy: #123047;
            --overview-primary: #176b87;
            --overview-green: #23855b;
            --overview-border: #dfe5e9;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-width: 0;
            min-height: 100%;
        }

        body {
            background: var(--background, #f4f6f8);
            color: var(--text, #17212b);
            font-family: Inter, ui-sans-serif, system-ui,
                -apple-system, BlinkMacSystemFont,
                "Segoe UI", sans-serif;
            overflow-x: hidden;
        }

        button,
        input,
        select {
            font: inherit;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        [hidden] {
            display: none !important;
        }

        /* ==========================================
           SIDEN
        ========================================== */

        .overview-page {
            width: min(1500px, calc(100% - 40px));
            min-width: 0;
            margin: 0 auto;
            padding: 18px 0 12px;
        }

        .overview-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            margin-bottom: 16px;
        }

        .overview-header > div {
            min-width: 0;
        }

        .page-eyebrow {
            display: block;
            margin-bottom: 9px;
            color: var(--link, #176b87);
            font-size: .72rem;
            font-weight: 850;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .overview-header h1 {
            margin: 0 0 8px;
            color: var(--heading, #102d42);
            font-size: clamp(1.8rem, 2.7vw, 2.5rem);
            line-height: 1.02;
        }

        .overview-header p {
            max-width: 700px;
            margin: 0;
            color: var(--text-secondary, #667085);
            font-size: 1rem;
            line-height: 1.65;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-shrink: 0;
            min-height: 44px;
            padding: 0 17px;
            border-radius: 10px;
            background: var(--overview-primary);
            color: white;
            font-weight: 750;
            white-space: nowrap;
        }

        .primary-button:hover {
            background: #125770;
            color: white;
        }

        .primary-button span {
            font-size: 1.1rem;
        }

        /* ==========================================
           STATUSKORT
        ========================================== */

        .overview-status {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 18px;
        }

        .status-card {
            min-width: 0;
            padding: 16px 20px;
            border: 1px solid var(--overview-border);
            border-radius: 13px;
            background: var(--surface, white);
        }

        .status-card > span {
            display: block;
            color: var(--text-secondary, #667085);
            font-size: .75rem;
        }

        .status-card > strong {
            display: block;
            margin: 7px 0 5px;
            color: var(--heading, #123047);
            font-size: 1.6rem;
            line-height: 1;
        }

        .status-card > strong.green-number {
            color: var(--overview-green);
        }

        .status-card small {
            color: var(--text-secondary, #667085);
            font-size: .68rem;
        }

        /* ==========================================
           FILTRERING
        ========================================== */

        .resource-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            gap: 14px;
            padding: 16px 18px;
            margin-bottom: 18px;
            border: 1px solid var(--overview-border);
            border-radius: 15px;
            background: var(--surface, white);
        }

        .resource-category-filter {
            flex: 1 1 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
            border: 0;
        }

        .resource-category-filter legend {
            margin-bottom: 9px;
            padding: 0;
            color: var(--heading, #123047);
            font-size: .85rem;
            font-weight: 750;
        }

        .resource-category-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .resource-category-option {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            max-width: 100%;
            padding: 8px 11px;
            border: 1px solid var(--overview-border);
            border-radius: 9px;
            background: var(--surface-soft, #f4f7fa);
            color: var(--heading, #123047);
            font-size: .8rem;
            cursor: pointer;
        }

        .resource-category-option:has(input:checked) {
            border-color: var(--overview-primary);
            background: #eef5f8;
        }

        .resource-category-option input {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: var(--overview-primary);
            cursor: pointer;
        }

        .resource-category-option span {
            overflow-wrap: anywhere;
        }

        .filter-field {
            display: flex;
            flex: 1 1 200px;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .filter-search {
            flex-grow: 2;
        }

        .filter-field label {
            color: var(--heading, #123047);
            font-size: .82rem;
            font-weight: 750;
        }

        .filter-field select,
        .filter-field input {
            width: 100%;
            min-height: 44px;
            padding: 10px 12px;
            border: 1px solid #ccd5dc;
            border-radius: 9px;
            background: var(--surface, white);
            color: var(--text, #17212b);
        }

        .filter-field select:focus,
        .filter-field input:focus {
            outline: 2px solid var(--overview-primary);
            outline-offset: 1px;
        }

        .filter-reset {
            min-height: 44px;
            padding: 0 14px;
            border: 1px solid #ccd5dc;
            border-radius: 9px;
            background: var(--surface, white);
            color: var(--heading, #123047);
            font-size: .82rem;
            font-weight: 750;
            cursor: pointer;
        }

        .filter-reset:hover {
            background: var(--surface-soft, #f4f7fa);
        }

        #filterSummary {
            flex-basis: 100%;
            margin: 0;
            color: var(--text-secondary, #667085);
            font-size: .78rem;
        }

        .filter-empty {
            color: var(--text-secondary, #667085);
            line-height: 1.5;
        }

        #mapUnavailable {
            padding: 12px 15px;
            border-radius: 10px;
            background: #fff3dc;
            color: #805600;
        }

        /* ==========================================
           FELLES KARTMAL

           Samme dimensjoner som RegisterResource
        ========================================== */

        .overview-grid {
            display: grid;
            grid-template-columns: minmax(0, .33fr) minmax(0, .67fr);
            gap: 18px;
            align-items: start;
            min-width: 0;
            min-height: 0;
        }

        .resource-list-card,
        .map-card {
            min-width: 0;
            border: 1px solid var(--overview-border);
            border-radius: 18px;
            background: var(--surface, white);
            box-shadow: 0 12px 35px rgba(16, 45, 66, .05);
        }

        /* ==========================================
           RESSURSLISTE
        ========================================== */

        .resource-list-card {
            padding: 28px;
        }

        .section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 20px;
        }

        .section-heading h2 {
            margin: 0;
            color: var(--heading, #123047);
            font-size: 1.35rem;
        }

        .resource-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            border-radius: 999px;
            background: #e4eff9;
            color: var(--overview-primary);
            font-size: .8rem;
            font-weight: 850;
        }

        .resource-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 0;
        }

        .resource-list::-webkit-scrollbar {
            width: 7px;
        }

        .resource-list::-webkit-scrollbar-thumb {
            border-radius: 999px;
            background: #bdc8d2;
        }

        /* ==========================================
           RESSURSKORT
        ========================================== */

        .resource-item {
            flex: 0 0 auto;
            min-width: 0;
            padding: 16px;
            border: 1px solid #e0e5e8;
            border-radius: 12px;
            background: var(--surface, white);
            overflow-wrap: anywhere;
            transition: border-color 150ms ease,
                        box-shadow 150ms ease;
        }

        .resource-item:hover {
            border-color: rgba(23, 107, 135, .3);
            box-shadow: 0 8px 20px rgba(18, 48, 71, .045);
        }

        .resource-item-top {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr);
            gap: 12px;
            align-items: start;
            min-width: 0;
        }

        .resource-icon {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #0789c8;
            color: white;
            font-size: .8rem;
            font-weight: 850;
        }

        .resource-title {
            min-width: 0;
        }

        .resource-type {
            display: block;
            margin: 1px 0 5px;
            color: var(--link, #176b87);
            font-size: .68rem;
            font-weight: 850;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .resource-title h3 {
            margin: 0;
            color: var(--heading, #123047);
            font-size: .95rem;
            overflow-wrap: anywhere;
        }

        .resource-title p {
            margin: 10px 0 0;
            color: var(--text, #344054);
            font-size: .88rem;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .resource-status {
            display: inline-flex;
            width: max-content;
            margin-top: 12px;
            padding: 5px 9px;
            border-radius: 999px;
            background: #e4f3ec;
            color: #1b6b48;
            font-size: .68rem;
            font-weight: 750;
        }

        /* ==========================================
           INFORMASJON OM RESSURS
        ========================================== */

        .resource-meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin: 16px 0 12px;
            padding: 12px;
            border-radius: 10px;
            background: var(--surface-soft, #edf4fa);
        }

        .resource-meta > div {
            min-width: 0;
        }

        .meta-label {
            display: block;
            margin-bottom: 4px;
            color: var(--text-secondary, #667085);
            font-size: .62rem;
            font-weight: 750;
            text-transform: uppercase;
        }

        .meta-value {
            display: block;
            color: var(--text, #344054);
            font-size: .72rem;
            overflow-wrap: anywhere;
        }

        .contact-box {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 13px;
            color: var(--text-secondary, #667085);
            font-size: .75rem;
            overflow-wrap: anywhere;
        }

        .contact-title {
            color: var(--heading, #123047);
            font-weight: 800;
        }

        /* ==========================================
           VIS I KART
        ========================================== */

        .map-focus-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 12px;
            border: 1px solid rgba(23, 107, 135, .3);
            border-radius: 8px;
            background: var(--surface, white);
            color: var(--link, #176b87);
            font-size: .75rem;
            font-weight: 750;
            cursor: pointer;
        }

        .map-focus-button:hover {
            background: #eef5f8;
        }

        .map-focus-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        /* ==========================================
           RESSURSSTATUS
        ========================================== */

        .resource-availability-status {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
        }

        .resource-availability-status form {
            margin: 0;
        }

        .resource-state {
            padding: 5px 9px;
            border-radius: 999px;
            background: #e4f3ec;
            color: #1b6b48;
            font-size: .72rem;
            font-weight: 750;
        }

        .resource-state-busy {
            background: #fdf3df;
            color: #8a5a00;
        }

        .resource-state-unavailable {
            background: #fbe9e9;
            color: #9d2f2f;
        }

        .resource-state-toggle {
            min-height: 34px;
            padding: 0 11px;
            border: 1px solid var(--overview-border);
            border-radius: 8px;
            background: var(--surface, white);
            color: var(--text, #17212b);
            font-size: .75rem;
            font-weight: 700;
            cursor: pointer;
        }

        .resource-state-toggle:hover {
            background: var(--surface-soft, #f6f8f9);
        }

        /* Endre/Slett-knappene på egne ressurser */
        .resource-owner-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .resource-owner-actions form {
            margin: 0;
        }

        a.resource-state-toggle {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

        .resource-delete-button {
            color: var(--danger-text, #a62f2f);
        }

        .resource-flash-error {
            background: #fbe9e9;
            color: #9d2f2f;
        }

        .resource-flash {
            margin-bottom: 18px;
            padding: 12px 15px;
            border-radius: 10px;
            background: #e4f3ec;
            color: #1b6b48;
            font-size: .86rem;
            font-weight: 650;
        }

        /* ==========================================
           KARTKORT
        ========================================== */

        .map-card {
            padding: 14px 18px 18px 14px;
            position: static;
            overflow: visible;
        }

        .map-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 10px;
        }

        .map-card-header h2 {
            margin: 0 0 6px;
            color: var(--heading, #123047);
            font-size: 1.35rem;
        }

        .map-card-header p {
            max-width: 520px;
            margin: 0;
            color: var(--text-secondary, #667085);
            font-size: .9rem;
            line-height: 1.5;
        }

        .map-legend {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            flex-shrink: 0;
            padding: 7px 10px;
            border-radius: 999px;
            background: #e8f5ef;
            color: #187052;
            font-size: .72rem;
            font-weight: 750;
        }

        .map-legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--overview-green);
        }

        #resourceOverviewMap {
            width: 100%;
            height: 650px;
            border: 1px solid #d8e0e5;
            border-radius: 14px;
            background: #dfe9ec;
            overflow: hidden;
        }

        /* ==========================================
           HJELP UNDER KARTET

           Samme utforming som RegisterResource
        ========================================== */

        .map-help {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .map-help-item {
            min-width: 0;
            padding: 12px;
            border-radius: 10px;
            background: var(--surface-soft, #f7f9fa);
        }

        .map-help-item strong {
            display: block;
            margin-bottom: 4px;
            color: var(--heading, #123047);
            font-size: .8rem;
        }

        .map-help-item span {
            color: var(--text-secondary, #667085);
            font-size: .75rem;
            line-height: 1.4;
        }

        /* ==========================================
           FULLSKJERMKNAPP
        ========================================== */

        .resource-fullscreen-control button {
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            padding: 8px;
            border: 0;
            background: white;
            color: #123047;
            cursor: pointer;
        }

        .resource-fullscreen-control button:hover {
            background: #f4f4f4;
        }

        .resource-fullscreen-control button:focus-visible {
            outline: 3px solid #176b87;
            outline-offset: -3px;
        }

        .resource-fullscreen-control svg {
            width: 22px;
            height: 22px;
        }

        #resourceOverviewMap:fullscreen,
        .resource-fullscreen-dialog #resourceOverviewMap {
            width: 100% !important;
            height: 100dvh !important;
            min-height: 0 !important;
            border: 0;
            border-radius: 0;
        }

        .resource-fullscreen-dialog {
            width: 100vw;
            max-width: none;
            height: 100dvh;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            overflow: hidden;
        }

        .resource-fullscreen-dialog::backdrop {
            background: #17212b;
        }

        /* ==========================================
           POPUP PÅ KARTET
        ========================================== */

        .resource-popup {
            min-width: 190px;
            font-family: Inter, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .resource-popup-type {
            display: block;
            margin-bottom: 5px;
            color: #176b87;
            font-size: .65rem;
            font-weight: 850;
            text-transform: uppercase;
        }

        .resource-popup strong {
            display: block;
            margin-bottom: 5px;
            color: #123047;
            font-size: .88rem;
        }

        .resource-popup p {
            margin: 0 0 8px;
            color: #667085;
            font-size: .78rem;
            line-height: 1.45;
        }

        .resource-popup small {
            display: block;
            margin-top: 3px;
            color: #667085;
            font-size: .72rem;
            overflow-wrap: anywhere;
        }

        /* ==========================================
           TOM RESSURSOVERSIKT
        ========================================== */

        .empty-state {
            max-width: 650px;
            margin: 50px auto;
            padding: 50px 35px;
            border: 1px solid var(--overview-border);
            border-radius: 16px;
            background: var(--surface, white);
            text-align: center;
        }

        .empty-icon {
            display: grid;
            place-items: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 20px;
            border-radius: 14px;
            background: #e8f5ef;
            color: #176b87;
            font-size: 1.5rem;
        }

        .empty-state h2 {
            margin: 0 0 10px;
            color: var(--heading, #123047);
            font-size: 1.5rem;
        }

        .empty-state p {
            max-width: 480px;
            margin: 0 auto 23px;
            color: var(--text-secondary, #667085);
            line-height: 1.6;
        }

        .empty-primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 16px;
            border-radius: 9px;
            background: var(--overview-primary);
            color: white;
            font-weight: 800;
        }

        /* ==========================================
           PC - SAMME LAYOUT SOM REGISTER RESOURCE
        ========================================== */

        @@media (min-width: 951px) {

            .overview-grid {
                grid-template-columns:
                    minmax(0, .33fr)
                    minmax(0, .67fr);
                gap: 18px;
                align-items: start;
                height: auto;
                min-height: 0;
                overflow: visible;
            }

            /*
              Venstre ressursboks får nøyaktig
              samme høyde som kartboksen.
            */
            .overview-grid > .resource-list-card {
                display: flex;
                flex-direction: column;
                height: var(--overview-map-card-height, 780px);
                min-height: 0;
                overflow: hidden;
            }

            .resource-list-card > .section-heading {
                flex: 0 0 auto;
            }

            .resource-list-card > .filter-empty {
                flex: 0 0 auto;
            }

            /*
              Kun ressurslisten scroller.
              Hele kartboksen forblir synlig.
            */
            .resource-list-card > .resource-list {
                flex: 1 1 auto;
                min-height: 0;
                max-height: none;
                overflow-y: auto;
                overflow-x: hidden;
                overscroll-behavior-y: contain;
                scrollbar-gutter: stable;
                padding-right: 10px;
            }

            /*
              Ingen sticky-kart og ingen
              ekstra plass under kortene.
            */
            .overview-grid > .map-card {
                position: static;
                align-self: start;
                height: auto;
            }

            /*
              Identisk høyde som kartet
              på Registrer ressurs-siden.
            */
            .map-card > #resourceOverviewMap {
                height: clamp(470px, 68dvh, 740px);
            }
        }

        /* ==========================================
           NETTBRETT
        ========================================== */

        @@media (max-width: 950px) {

            .overview-page {
                width: calc(100% - 32px);
                padding: 25px 0 20px;
            }

            .overview-grid {
                grid-template-columns: 1fr;
            }

            .overview-grid > .resource-list-card {
                height: auto;
                overflow: visible;
            }

            .resource-list {
                max-height: 420px;
                overflow-y: auto;
                padding-right: 6px;
            }

            .overview-grid > .map-card {
                position: static;
            }

            #resourceOverviewMap {
                height: 460px;
            }
        }

        /* ==========================================
           MOBIL
        ========================================== */

        @@media (max-width: 700px) {

            .overview-page {
                width: calc(100% - 28px);
            }

            .overview-header {
                flex-direction: column;
                gap: 18px;
            }

            .primary-button {
                width: 100%;
            }

            .overview-status {
                grid-template-columns: 1fr;
            }

            .resource-filters {
                padding: 15px;
            }

            .filter-field {
                flex-basis: 100%;
            }

            .resource-list-card {
                padding: 19px;
            }

            .map-card {
                padding: 19px;
            }

            .map-card-header {
                flex-direction: column;
            }

            .map-help {
                grid-template-columns: 1fr;
            }

            #resourceOverviewMap {
                height: 420px;
            }

            .resource-meta {
                grid-template-columns: 1fr;
            }
        }

        /* ==========================================
           FOKUS OG TILGJENGELIGHET
        ========================================== */

        .resource-filters :focus-visible,
        .map-focus-button:focus-visible,
        .resource-state-toggle:focus-visible,
        .primary-button:focus-visible {
            outline: 3px solid var(--overview-primary);
            outline-offset: 3px;
        }

    </style>
</head>

<body>

<partial name="_PortalHeader" />

<main class="overview-page">

    @if (TempData["ResourceError"] is string resourceError)
    {
        <div class="resource-flash resource-flash-error" role="alert">
            @resourceError
        </div>
    }

    @if (TempData["ResourceSuccess"] is string resourceMessage)
    {
        <div class="resource-flash" role="status">
            @resourceMessage
        </div>
    }

    @if (TempData["ResourceCelebrate"] is true)
    {
        <partial name="_Feiring" />
    }

    <!-- ==========================================
         OVERSKRIFT
    ========================================== -->

    <div class="overview-header">

        <div>
            <span class="page-eyebrow">
                @(isResourceProvider
                    ? "MINE RESSURSER"
                    : "BEREDSKAPSRESSURSER")
            </span>

            <h1>@pageTitle</h1>

            @if (isResourceProvider)
            {
                <p>
                    Se ressursene du har registrert
                    og hvor de befinner seg.
                </p>
            }
            else
            {
                <p>
                    Oversikt over registrerte ressurser
                    som kan være relevante i en beredskapssituasjon.
                </p>
            }
        </div>

        @if (isResourceProvider)
        {
            <a asp-controller="Resource"
               asp-action="RegisterResource"
               class="primary-button">
                <span>+</span>
                Registrer ny ressurs
            </a>
        }

    </div>

    @if (!resources.Any())
    {
        <!-- TOM OVERSIKT -->

        <section class="empty-state">

            <div class="empty-icon">◎</div>

            <span class="page-eyebrow">
                INGEN RESSURSER
            </span>

            <h2>Ingen ressurser registrert</h2>

            @if (isResourceProvider)
            {
                <p>
                    Du har ikke registrert noen ressurser ennå.
                    Registrer den første ressursen for å komme i gang.
                </p>

                <a asp-controller="Resource"
                   asp-action="RegisterResource"
                   class="empty-primary-button">
                    + Registrer første ressurs
                </a>
            }
            else
            {
                <p>
                    Det finnes ingen registrerte ressurser
                    å vise akkurat nå.
                </p>
            }

        </section>
    }
    else
    {
        <!-- ==========================================
             STATISTIKK
        ========================================== -->

        <section class="overview-status">

            <article class="status-card">
                <span>Registrerte ressurser</span>
                <strong>@resources.Count</strong>
                <small>I denne oversikten</small>
            </article>

            <article class="status-card">
                <span>Ressurstyper</span>
                <strong class="green-number">
                    @resourceTypeCount
                </strong>
                <small>Ulike kategorier</small>
            </article>

            <article class="status-card">
                <span>Kartpunkter</span>
                <strong>@resources.Count</strong>
                <small>Registrerte plasseringer</small>
            </article>

        </section>

        <!-- ==========================================
             FILTRE
        ========================================== -->

        <form id="resourceFilters"
              class="resource-filters"
              role="search"
              aria-label="Filtrer ressurser"
              hidden>

            <fieldset class="resource-category-filter">

                <legend>Ressurstype</legend>

                <div class="resource-category-options">

                    @foreach (var type in resources
                        .Select(resource => resource.ResourceType)
                        .Distinct()
                        .OrderBy(type => GetResourceTypeName(type)))
                    {
                        <label class="resource-category-option">

                            <input type="checkbox"
                                   name="resourceTypes"
                                   value="@((int)type)"
                                   checked />

                            <span>
                                @GetResourceTypeName(type)
                            </span>

                        </label>
                    }

                </div>
            </fieldset>

            <div class="filter-field">

                <label for="resourceAvailabilityFilter">
                    Tilgjengelighet
                </label>

                <select id="resourceAvailabilityFilter">
                    <option value="">Alle statuser</option>

                    @foreach (var status in Html.GetEnumSelectList<ResourceStatus>())
                    {
                        <option value="@((ResourceStatus)int.Parse(status.Value))">
                            @status.Text
                        </option>
                    }
                </select>

            </div>

            <div class="filter-field filter-search">

                <label for="resourceSearch">
                    Søk i navn eller beskrivelse
                </label>

                <input id="resourceSearch"
                       type="search"
                       placeholder="Søk etter en ressurs …" />

            </div>

            <button type="reset" class="filter-reset">
                Nullstill filtre
            </button>

            <p id="filterSummary"
               role="status"
               aria-live="polite"></p>

        </form>

        <p id="mapUnavailable" hidden>
            Kartet kunne ikke lastes.
            Du kan fortsatt filtrere ressurslisten.
        </p>

        <!-- ==========================================
             RESSURSLISTE OG KART
        ========================================== -->

        <div class="overview-grid">

            <!-- ======================================
                 VENSTRE: RESSURSLISTE
            ======================================= -->

            <section class="resource-list-card">

                <div class="section-heading">

                    <div>
                        <span class="page-eyebrow">
                            OVERSIKT
                        </span>

                        <h2>Ressurser</h2>
                    </div>

                    <span class="resource-count"
                          id="filteredResourceCount">
                        @resources.Count
                    </span>

                </div>

                <p id="noMatchingResources"
                   class="filter-empty"
                   hidden>
                    Ingen ressurser passer til filtrene.
                    Prøv en annen ressurstype eller nullstill filtrene.
                </p>

                <div class="resource-list">

                    @foreach (var resource in resources)
                    {
                        string resourceType =
                            GetResourceTypeName(resource.ResourceType);

                        string registeredDate =
                            resource.CreatedAt
                                .ToLocalTime()
                                .ToString("dd.MM.yyyy HH:mm");

                        <article class="resource-item"
                                 data-resource-id="@resource.Id">

                            <div class="resource-item-top">

                                <div class="resource-icon">
                                    @GetResourceIcon(resource.ResourceType)
                                </div>

                                <div class="resource-title">

                                    <span class="resource-type">
                                        @resourceType
                                    </span>

                                    <h3>
                                        @(string.IsNullOrWhiteSpace(resource.ResourceName)
                                            ? resource.Description
                                            : resource.ResourceName)
                                    </h3>

                                    <p>
                                        @resource.Description
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(resource.Availability))
                                    {
                                        <p>
                                            Periode: @resource.Availability
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(resource.Address))
                                    {
                                        <p>@FirstWebAppInDocker.Services.ResourceDisplay.PrettyAddress(resource.Address)</p>
                                    }

                                </div>

                            </div>

                            <span class="resource-status">
                                @(Html.GetEnumSelectList<ResourceStatus>()
                                    .First(item => item.Value ==
                                        ((int)resource.EffectiveStatus).ToString()).Text)
                            </span>

                            <!-- RESSURSINFORMASJON -->

                            <div class="resource-meta">

                                <div>
                                    <span class="meta-label">
                                        Plassering
                                    </span>

                                    <span class="meta-value">
                                        @resource.Position.Latitude.ToString("F5"),
                                        @resource.Position.Longitude.ToString("F5")
                                    </span>
                                </div>

                                <div>
                                    <span class="meta-label">
                                        Registrert
                                    </span>

                                    <span class="meta-value">
                                        @registeredDate
                                    </span>
                                </div>

                            </div>

                            <!-- KONTAKT -->

                            @if (
                                !string.IsNullOrWhiteSpace(resource.ContactEmail)
                                || !string.IsNullOrWhiteSpace(resource.ContactPhoneNumber)
                            )
                            {
                                <div class="contact-box">

                                    <span class="contact-title">
                                        Kontakt
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(resource.ContactEmail))
                                    {
                                        <span>
                                            @resource.ContactEmail
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(resource.ContactPhoneNumber))
                                    {
                                        <span>
                                            @resource.ContactPhoneCountryCode
                                            @resource.ContactPhoneNumber
                                        </span>
                                    }

                                </div>
                            }

                            <!-- VIS I KART -->

                            <button type="button"
                                    class="map-focus-button"
                                    data-latitude="@resource.Position.Latitude.ToString(CultureInfo.InvariantCulture)"
                                    data-longitude="@resource.Position.Longitude.ToString(CultureInfo.InvariantCulture)">

                                <span>◎</span>
                                Vis i kart

                            </button>

                            <!-- STATUS -->

                            <div class="resource-availability-status">

                                <span class="resource-state resource-state-@resource.EffectiveStatus.ToString().ToLowerInvariant()">
                                    @(resource.EffectiveStatus switch
                                    {
                                        ResourceStatus.Busy => "Opptatt",
                                        ResourceStatus.Unavailable => "Utilgjengelig",
                                        _ => "Tilgjengelig"
                                    })
                                </span>

                                @if (isResourceProvider &&
                                     resource.Status != ResourceStatus.Busy)
                                {
                                    <form asp-controller="Resource"
                                          asp-action="SetStatus"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@resource.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="@(resource.Status == ResourceStatus.Available
                                                   ? ResourceStatus.Unavailable
                                                   : ResourceStatus.Available)" />

                                        <button type="submit"
                                                class="resource-state-toggle">

                                            @(resource.Status == ResourceStatus.Available
                                                ? "Marker som utilgjengelig"
                                                : "Marker som tilgjengelig")

                                        </button>

                                    </form>
                                }

                            </div>


                            <!-- ENDRE / SLETTE (bare egne ressurser) -->

                            @if (isResourceProvider)
                            {
                                <div class="resource-owner-actions">

                                    <a asp-controller="Resource"
                                       asp-action="EditResource"
                                       asp-route-id="@resource.Id"
                                       class="resource-state-toggle">
                                        Endre
                                    </a>

                                    <form asp-controller="Resource"
                                          asp-action="DeleteResource"
                                          method="post"
                                          onsubmit="return confirm('Slette denne ressursen? Dette kan ikke angres.');">

                                        <input type="hidden"
                                               name="id"
                                               value="@resource.Id" />

                                        <button type="submit"
                                                class="resource-state-toggle resource-delete-button">
                                            Slett
                                        </button>

                                    </form>

                                </div>
                            }

                        </article>
                    }

                </div>

            </section>

            <!-- ======================================
                 HØYRE: RESSURSKART
            ======================================= -->

            <section class="map-card">

                <div class="map-card-header">

                    <div>
                        <span class="page-eyebrow">
                            KART
                        </span>

                        <h2>Ressurskart</h2>

                        <p>
                            Klikk på en markør for mer informasjon,
                            eller velg «Vis i kart» fra listen.
                        </p>
                    </div>

                    <div class="map-legend">
                        <span class="map-legend-dot"></span>
                        Registrert ressurs
                    </div>

                </div>

                <div id="resourceOverviewMap"></div>

                <!-- INSTRUKSJONER INNE I KARTBOKSEN -->

                <div class="map-help">

                    <div class="map-help-item">
                        <strong>1. Finn ressursen</strong>
                        <span>
                            Se registrerte ressurser i listen.
                        </span>
                    </div>

                    <div class="map-help-item">
                        <strong>2. Se plassering</strong>
                        <span>
                            Velg «Vis i kart» for å zoome til ressursen.
                        </span>
                    </div>

                    <div class="map-help-item">
                        <strong>3. Kontakt ved behov</strong>
                        <span>
                            Bruk registrert kontaktinformasjon
                            dersom ressursen blir aktuell.
                        </span>
                    </div>

                </div>

            </section>

        </div>
    }

</main>

@if (resources.Any())
{
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/kartverket.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* ==========================================
               DATA, FILTRE OG RESSURSKORT
            ========================================== */

            const resources = @Html.Raw(mapResourcesJson);

            const filterForm =
                document.getElementById("resourceFilters");

            const categoryCheckboxes = Array.from(
                filterForm.querySelectorAll('input[name="resourceTypes"]')
            );

            const availabilityFilter =
                document.getElementById("resourceAvailabilityFilter");

            const searchInput =
                document.getElementById("resourceSearch");

            const cards = new Map(
                Array.from(document.querySelectorAll(".resource-item"))
                    .map(card => [
                        Number(card.dataset.resourceId),
                        card
                    ])
            );

            const markers = new Map();

            const mapElement =
                document.getElementById("resourceOverviewMap");

            const mapCard =
                document.querySelector(".overview-grid > .map-card");

            const overviewGrid =
                document.querySelector(".overview-grid");

            let map = null;

            /* ==========================================
               TILGJENGELIGHET OG FILTRERING
            ========================================== */

            function availabilityStatus(value) {

                const status = (value || "")
                    .trim()
                    .toLocaleLowerCase();

                if (["available", "unavailable", "busy"].includes(status)) {
                    return status;
                }

                return "unspecified";
            }

            function applyFilters() {

                const search = searchInput.value
                    .trim()
                    .toLocaleLowerCase("nb-NO");

                const selectedTypes = new Set(
                    categoryCheckboxes
                        .filter(checkbox => checkbox.checked)
                        .map(checkbox => checkbox.value)
                );

                const matching = resources.filter(resource => {

                    const matchesType =
                        selectedTypes.has(String(resource.typeId));

                    const matchesAvailability =
                        availabilityFilter.value === "" ||
                        availabilityStatus(resource.availability) ===
                        availabilityFilter.value.toLocaleLowerCase("nb-NO");

                    const searchableText =
                        `${resource.name || ""} ${resource.description || ""}`
                            .toLocaleLowerCase("nb-NO");

                    return matchesType &&
                           matchesAvailability &&
                           searchableText.includes(search);
                });

                const matchingIds = new Set(
                    matching.map(resource => resource.id)
                );

                cards.forEach((card, id) => {
                    card.hidden = !matchingIds.has(id);
                });

                document.getElementById(
                    "filteredResourceCount"
                ).textContent = matching.length;

                document.getElementById(
                    "filterSummary"
                ).textContent =
                    `Viser ${matching.length} av ${resources.length} ressurser`;

                document.getElementById(
                    "noMatchingResources"
                ).hidden = matching.length !== 0;

                if (map) {

                    map.closePopup();

                    markers.forEach((marker, id) => {
                        if (matchingIds.has(id)) {
                            marker.addTo(map);
                        } else {
                            marker.remove();
                        }
                    });

                    const visibleMarkers = matching
                        .map(resource => markers.get(resource.id))
                        .filter(Boolean);

                    if (visibleMarkers.length > 0) {
                        map.fitBounds(
                            L.featureGroup(visibleMarkers).getBounds(),
                            {
                                padding: [30, 30],
                                maxZoom: 13
                            }
                        );
                    }
                }
            }

            /* ==========================================
               AKTIVER FILTRE
            ========================================== */

            filterForm.hidden = false;

            filterForm.addEventListener(
                "submit",
                event => event.preventDefault()
            );

            categoryCheckboxes.forEach(checkbox => {
                checkbox.addEventListener(
                    "change",
                    applyFilters
                );
            });

            availabilityFilter.addEventListener(
                "change",
                applyFilters
            );

            searchInput.addEventListener(
                "input",
                applyFilters
            );

            filterForm.addEventListener("reset", function () {

                requestAnimationFrame(function () {

                    categoryCheckboxes.forEach(checkbox => {
                        checkbox.checked = true;
                    });

                    availabilityFilter.value = "";
                    searchInput.value = "";

                    applyFilters();
                });
            });

            /* ==========================================
               KONTROLLER LEAFLET
            ========================================== */

            if (typeof L === "undefined") {

                document.getElementById(
                    "mapUnavailable"
                ).hidden = false;

                document.querySelectorAll(
                    ".map-focus-button"
                ).forEach(button => {
                    button.disabled = true;
                });

                applyFilters();
                return;
            }

            /* ==========================================
               OPPRETT KART
            ========================================== */

            map = L.map("resourceOverviewMap")
                .setView([58.1467, 7.9956], 10);

            addKartverketLayers(map);

            /* ==========================================
               FULLSKJERM

               Samme funksjon som RegisterResource
            ========================================== */

            const fullscreenDialog =
                document.createElement("dialog");

            fullscreenDialog.className =
                "resource-fullscreen-dialog";

            fullscreenDialog.setAttribute(
                "aria-label",
                "Ressurskart i fullskjerm"
            );

            document.body.appendChild(fullscreenDialog);

            let mapPlaceholder = null;
            let fullscreenButton = null;

            const expandIcon =
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>';

            const collapseIcon =
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6"/></svg>';

            function isMapFullscreen() {

                return document.fullscreenElement === mapElement ||
                       fullscreenDialog.open;
            }

            function refreshMapSize() {

                const center = map.getCenter();
                const zoom = map.getZoom();

                map.invalidateSize({
                    pan: false
                });

                map.setView(center, zoom, {
                    animate: false,
                    reset: true
                });
            }

            function scheduleMapRefresh() {

                requestAnimationFrame(refreshMapSize);
            }

            function updateFullscreenControl() {

                const expanded = isMapFullscreen();

                const label = expanded
                    ? "Avslutt fullskjerm"
                    : "Vis i fullskjerm";

                fullscreenButton.title = label;

                fullscreenButton.setAttribute(
                    "aria-label",
                    label
                );

                fullscreenButton.setAttribute(
                    "aria-pressed",
                    String(expanded)
                );

                fullscreenButton.innerHTML = expanded
                    ? collapseIcon
                    : expandIcon;

                scheduleMapRefresh();
                syncCardHeight();
            }

            function openFullscreenDialog() {

                mapPlaceholder = document.createComment(
                    "Original plassering av ressurskartet"
                );

                mapElement.before(mapPlaceholder);

                fullscreenDialog.appendChild(mapElement);
                fullscreenDialog.showModal();

                updateFullscreenControl();
                fullscreenButton.focus();
            }

            fullscreenDialog.addEventListener(
                "close",
                function () {

                    if (mapPlaceholder) {
                        mapPlaceholder.replaceWith(mapElement);
                        mapPlaceholder = null;
                    }

                    updateFullscreenControl();

                    fullscreenButton.focus({
                        preventScroll: true
                    });
                }
            );

            document.addEventListener(
                "fullscreenchange",
                updateFullscreenControl
            );

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key !== "Escape" ||
                        !isMapFullscreen()
                    ) {
                        return;
                    }

                    event.preventDefault();

                    if (fullscreenDialog.open) {
                        fullscreenDialog.close();
                    } else if (document.fullscreenElement) {
                        document.exitFullscreen();
                    }
                }
            );

            const FullscreenControl = L.Control.extend({

                options: {
                    position: "topright"
                },

                onAdd: function () {

                    const control = L.DomUtil.create(
                        "div",
                        "leaflet-bar resource-fullscreen-control"
                    );

                    fullscreenButton = L.DomUtil.create(
                        "button",
                        "",
                        control
                    );

                    fullscreenButton.type = "button";

                    L.DomEvent.disableClickPropagation(
                        control
                    );

                    L.DomEvent.disableScrollPropagation(
                        control
                    );

                    fullscreenButton.addEventListener(
                        "click",
                        async function (event) {

                            event.preventDefault();
                            event.stopPropagation();

                            if (fullscreenDialog.open) {

                                fullscreenDialog.close();

                            } else if (
                                document.fullscreenElement === mapElement
                            ) {

                                await document.exitFullscreen();

                            } else if (
                                mapElement.requestFullscreen &&
                                document.fullscreenEnabled
                            ) {

                                try {
                                    await mapElement.requestFullscreen();
                                } catch {
                                    openFullscreenDialog();
                                }

                            } else {

                                openFullscreenDialog();
                            }
                        }
                    );

                    return control;
                }
            });

            new FullscreenControl().addTo(map);
            updateFullscreenControl();

            /* ==========================================
               KARTSYMBOLER

               Beholder eksisterende symboler
               for hver ressurstype.
            ========================================== */

            function symbolFor(type) {

                const icons = {

                    Transport:
                        "<path d='M1 3h15v13H1z'/><path d='M16 8h4l3 3v5h-7z'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/>",

                    Drone:
                        "<circle cx='12' cy='12' r='3'/><circle cx='5' cy='5' r='2.5'/><circle cx='19' cy='5' r='2.5'/><circle cx='5' cy='19' r='2.5'/><circle cx='19' cy='19' r='2.5'/><path d='M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3'/>",

                    Generator:
                        "<polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/>",

                    Machinery:
                        "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",

                    CommunicationEquipment:
                        "<circle cx='12' cy='12' r='2'/><path d='M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14'/>",

                    Personnel:
                        "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'/>",

                    Premises:
                        "<path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/>",

                    SandAndGravel:
                        "<polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/>",

                    Boat:
                        "<circle cx='12' cy='5' r='3'/><line x1='12' y1='22' x2='12' y2='8'/><path d='M5 12H2a10 10 0 0 0 20 0h-3'/>",

                    Other:
                        "<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>"
                };

                return icons[type] || icons.Other;
            }

            function createSymbolMarker(color, type, badge) {

                const svg =
                    "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='" +
                    color +
                    "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>" +
                    symbolFor(type) +
                    "</svg>";

                const badgeHtml = badge
                    ? "<div style='position:absolute;top:-6px;right:-6px;min-width:20px;height:20px;padding:0 4px;border-radius:10px;background:#102d43;color:white;border:2px solid white;box-sizing:border-box;font:700 11px/16px sans-serif;text-align:center;'>" +
                      badge +
                      "</div>"
                    : "";

                return L.divIcon({

                    className: "",

                    html:
                        "<div style='position:relative;width:50px;height:62px;'>" +
                        "<div style='position:absolute;left:0;top:0;width:50px;height:50px;box-sizing:border-box;border:3px solid white;border-radius:50% 50% 50% 8px;transform:rotate(-45deg);background:" +
                        color +
                        ";box-shadow:0 5px 14px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;'>" +
                        "<div style='transform:rotate(45deg);width:36px;height:36px;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;'>" +
                        svg +
                        "</div></div>" +
                        badgeHtml +
                        "</div>",

                    iconSize: [50, 62],
                    iconAnchor: [25, 60],
                    popupAnchor: [0, -54]
                });
            }

            /* ==========================================
               OPPRETT KARTMARKØRER
            ========================================== */

            resources.forEach(resource => {

                const marker = L.marker(
                    [resource.latitude, resource.longitude],
                    {
                        icon: createSymbolMarker(
                            "#23855b",
                            resource.typeKey,
                            ""
                        )
                    }
                );

                const popup = document.createElement("div");
                popup.className = "resource-popup";

                const details = [
                    ["span", resource.type, "resource-popup-type"],
                    ["strong", resource.name || resource.description],
                    ["p", resource.description],
                    ["small", resource.availability || "Ikke oppgitt"],
                    ["p", `${resource.latitude.toFixed(5)}, ${resource.longitude.toFixed(5)}`],
                    ["small", resource.email],
                    ["small", resource.phone]
                ];

                details.forEach(([tag, text, className]) => {

                    if (!text) {
                        return;
                    }

                    const element = document.createElement(tag);
                    element.textContent = text;

                    if (className) {
                        element.className = className;
                    }

                    popup.appendChild(element);
                });

                marker.bindPopup(popup);
                markers.set(resource.id, marker);
            });

            /* ==========================================
               VIS RESSURS I KART
            ========================================== */

            document.querySelectorAll(
                ".map-focus-button"
            ).forEach(button => {

                button.addEventListener("click", function () {

                    const id = Number(
                        button.closest(".resource-item")
                            .dataset.resourceId
                    );

                    const marker = markers.get(id);

                    if (!marker) {
                        return;
                    }

                    map.setView(marker.getLatLng(), 14);
                    marker.openPopup();

                    mapCard.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest"
                    });
                });
            });

            /* ==========================================
               SAMME HØYDE PÅ BEGGE BOKSER

               Venstre boks tilpasses høyre.
               Ingen ekstra tomplass under kartet.
            ========================================== */

            function syncCardHeight() {

                if (isMapFullscreen()) {
                    return;
                }

                const mapCardHeight =
                    mapCard.getBoundingClientRect().height;

                overviewGrid.style.setProperty(
                    "--overview-map-card-height",
                    mapCardHeight + "px"
                );
            }

            syncCardHeight();

            window.addEventListener(
                "resize",
                function () {
                    syncCardHeight();
                    scheduleMapRefresh();
                }
            );

            if (typeof ResizeObserver !== "undefined") {

                const cardObserver =
                    new ResizeObserver(syncCardHeight);

                cardObserver.observe(mapCard);

                const mapObserver =
                    new ResizeObserver(scheduleMapRefresh);

                mapObserver.observe(mapElement);
            }

            window.setTimeout(function () {
                map.invalidateSize();
                syncCardHeight();
            }, 100);

            /* ==========================================
               START FILTRERING
            ========================================== */

            applyFilters();

        });
    </script>
}

<partial name="_Sami" />

</body>
</html>
