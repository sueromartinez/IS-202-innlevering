@if (resources.Any())
{
    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

<script src="~/js/kartverket.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const resources = @Html.Raw(mapResourcesJson);
            const filterForm = document.getElementById("resourceFilters");
            const categoryCheckboxes = Array.from(
                filterForm.querySelectorAll('input[name="resourceTypes"]'));
            const availabilityFilter = document.getElementById("resourceAvailabilityFilter");
            const searchInput = document.getElementById("resourceSearch");
            const cards = new Map(Array.from(document.querySelectorAll(".resource-item"))
                .map(card => [Number(card.dataset.resourceId), card]));
            const markers = new Map();
            let map;

            // Keeps unknown legacy availability text separate from explicit statuses.
            function availabilityStatus(value) {
                const status = (value || "").trim().toLocaleLowerCase("nb-NO");
                return ["tilgjengelig", "ikke tilgjengelig"].includes(status) ? status : "unspecified";
            }

            // Applies all filters to the same resources before updating cards and markers.
            function applyFilters() {
                const search = searchInput.value.trim().toLocaleLowerCase("nb-NO");
                // Matches any selected category, then combines it with status and search.
                const selectedTypes = new Set(categoryCheckboxes
                    .filter(checkbox => checkbox.checked).map(checkbox => checkbox.value));
                const matching = resources.filter(resource =>
                    selectedTypes.has(String(resource.typeId)) &&
                    (availabilityFilter.value === "" || availabilityStatus(resource.availability) === availabilityFilter.value.toLocaleLowerCase("nb-NO")) &&
                    `${resource.name} ${resource.description}`.toLocaleLowerCase("nb-NO").includes(search));
                const matchingIds = new Set(matching.map(resource => resource.id));
                cards.forEach((card, id) => { card.hidden = !matchingIds.has(id); });
                document.getElementById("filteredResourceCount").textContent = matching.length;
                document.getElementById("filterSummary").textContent =
                    `Viser ${matching.length} av ${resources.length} ressurser`;
                document.getElementById("noMatchingResources").hidden = matching.length !== 0;

                // Removes hidden markers and fits the map to the matching resources.
                if (map) {
                    map.closePopup();
                    markers.forEach((marker, id) => {
                        if (matchingIds.has(id)) marker.addTo(map);
                        else marker.remove();
                    });

                    const visibleMarkers = matching.map(resource => markers.get(resource.id));
                    if (visibleMarkers.length > 0) {
                        map.fitBounds(L.featureGroup(visibleMarkers).getBounds(), {
                            padding: [30, 30], maxZoom: 13
                        });
                    }
                    }
                }
            }

            // Keeps list filtering available if the external map library cannot load.
            filterForm.hidden = false;
            filterForm.addEventListener("submit", event => event.preventDefault());
            // Each checkbox updates the resource cards and map markers immediately.
            categoryCheckboxes.forEach(checkbox => checkbox.addEventListener("change", applyFilters));
            availabilityFilter.addEventListener("change", applyFilters);
            searchInput.addEventListener("input", applyFilters);
            filterForm.addEventListener("reset", function () {
                // Restores every category before recalculating the complete result set.
                categoryCheckboxes.forEach(checkbox => { checkbox.checked = true; });
                availabilityFilter.value = "";
                searchInput.value = "";
                applyFilters();
            });
            if (typeof L === "undefined") {
                document.getElementById("mapUnavailable").hidden = false;
                document.querySelectorAll(".map-focus-button").forEach(button => { button.disabled = true; });
                applyFilters();
                return;
            }

            // Reuses Leaflet, Kartverket tiles and the existing marker design.
            map = L.map("resourceOverviewMap").setView([58.1467, 7.9956], 10);
            addKartverketLayers(map);
            // SVG_SYMBOL_V3
// Kartsymboler: symbolFor() gir SVG-ikonet som passer til typen behov eller ressurs,
// og createSymbolMarker() tegner kartpinnen med ikonet (og eventuelt et nummer).
function symbolFor(type) {
    const icons = {
        Transport: "<path d='M1 3h15v13H1z'/><path d='M16 8h4l3 3v5h-7z'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/>",
        Drone: "<circle cx='12' cy='12' r='3'/><circle cx='5' cy='5' r='2.5'/><circle cx='19' cy='5' r='2.5'/><circle cx='5' cy='19' r='2.5'/><circle cx='19' cy='19' r='2.5'/><path d='M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3'/>",
        Generator: "<polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/>",
        Machinery: "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",
        CommunicationEquipment: "<circle cx='12' cy='12' r='2'/><path d='M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14'/>",
        Personnel: "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'/>",
        Premises: "<path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/>",
        SandAndGravel: "<polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/>",
        Boat: "<circle cx='12' cy='5' r='3'/><line x1='12' y1='22' x2='12' y2='8'/><path d='M5 12H2a10 10 0 0 0 20 0h-3'/>",
        Other: "<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>"
    };
    return icons[type] || icons.Other;
}

function createSymbolMarker(color, type, badge) {
    const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='" + color + "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>" + symbolFor(type) + "</svg>";
    const badgeHtml = badge ? "<div style='position:absolute;top:-6px;right:-6px;min-width:20px;height:20px;padding:0 4px;border-radius:10px;background:#102d43;color:white;border:2px solid white;box-sizing:border-box;font:700 11px/16px sans-serif;text-align:center;'>" + badge + "</div>" : "";
    return L.divIcon({
        className: "",
        html: "<div style='position:relative;width:50px;height:62px;'><div style='position:absolute;left:0;top:0;width:50px;height:50px;box-sizing:border-box;border:3px solid white;border-radius:50% 50% 50% 8px;transform:rotate(-45deg);background:" + color + ";box-shadow:0 5px 14px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;'><div style='transform:rotate(45deg);width:36px;height:36px;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;'>" + svg + "</div></div>" + badgeHtml + "</div>",
        iconSize: [50, 62],
        iconAnchor: [25, 60],
        popupAnchor: [0, -54]
    });
}



            // Uses textContent so resource descriptions and contact details stay plain text.
            resources.forEach(resource => {
                const marker = L.marker([resource.latitude, resource.longitude], { icon: createSymbolMarker("#23855b", resource.typeKey, "") });
                const popup = document.createElement("div");
                popup.className = "resource-popup";
                const details = [
                    ["span", resource.type, "resource-popup-type"],
                    ["strong", resource.name || resource.description],
                    ["p", resource.description],
                    ["small", resource.availability || "Ikke oppgitt"],
                    ["p", `${resource.latitude.toFixed(5)}, ${resource.longitude.toFixed(5)}`],
                    ["small", resource.email],
                    ["small", resource.phone]
                ];
                details.forEach(([tag, text, className]) => {
                    if (!text) return;
                    const element = document.createElement(tag);
                    element.textContent = text;
                    if (className) element.className = className;
                    popup.appendChild(element);
                });
                marker.bindPopup(popup);
                markers.set(resource.id, marker);
            });

            // Finds the marker by resource ID, including resources at the same coordinates.
            document.querySelectorAll(".map-focus-button").forEach(button => {
                button.addEventListener("click", function () {
                    const id = Number(button.closest(".resource-item").dataset.resourceId);
                    const marker = markers.get(id);
                    map.setView(marker.getLatLng(), 14);
                    marker.openPopup();
                    document.getElementById("resourceOverviewMap").scrollIntoView({
                        behavior: "smooth", block: "center"
                    });
                });
            });
            applyFilters();
        });
    </script>
}


<partial name="_Sami" />
</body>

