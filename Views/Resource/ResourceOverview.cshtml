@using FirstWebAppInDocker.Models
@using System.Text.Json
@model IEnumerable<FirstWebAppInDocker.ViewModels.ResourceOverviewViewModel>

@{
    Layout = null;

    string? userName =
        Context.Session.GetString("UserName");

    string? userRole =
        Context.Session.GetString("UserRole");

    bool isResourceProvider =
        userRole == "ResourceProvider";

    string displayName =
        string.IsNullOrWhiteSpace(userName)
            ? (isResourceProvider
                ? "Ressursleverandør"
                : "Offentlig aktør")
            : userName;

    string roleLabel =
        isResourceProvider
            ? "Ressursleverandør"
            : "Offentlig aktør";

    string pageTitle =
        isResourceProvider
            ? "Mine ressurser"
            : "Ressursoversikt";

    ViewData["Title"] = pageTitle;

    var resources =
        Model.ToList();

    var resourceTypeNames =
        Html.GetEnumSelectList<ResourceType>()
            .ToDictionary(
                item => int.Parse(item.Value),
                item => item.Text
            );

    string GetResourceTypeName(
        ResourceType resourceType)
    {
        return resourceTypeNames.TryGetValue(
            (int)resourceType,
            out string? name
        )
            ? name
            : resourceType.ToString();
    }

    string GetResourceIcon(
        ResourceType resourceType)
    {
        return resourceType switch
        {
            ResourceType.Transport => "T",
            ResourceType.Drone => "D",
            ResourceType.Generator => "A",
            ResourceType.Machinery => "M",
            ResourceType.CommunicationEquipment => "S",
            ResourceType.Personnel => "P",
            ResourceType.Premises => "L",
            ResourceType.SandAndGravel => "G",
            ResourceType.Boat => "B",
            _ => "R"
        };
    }

    int resourceTypeCount =
        resources
            .Select(resource => resource.ResourceType)
            .Distinct()
            .Count();

    // Uses the same database resources for the cards and map.
    var mapResources =
        resources.Select(
            resource => new
            {
                id =
                    resource.Id,

                name = resource.ResourceName,
                availability = resource.Availability,

                typeId = (int)resource.ResourceType,

                type =
                    GetResourceTypeName(
                        resource.ResourceType
                    ),

                description =
                    resource.Description,

                latitude =
                    resource.Position.Latitude,

                longitude =
                    resource.Position.Longitude,

                email =
                    resource.ContactEmail,

                phone =
                    string.IsNullOrWhiteSpace(
                        resource.ContactPhoneNumber
                    )
                        ? null
                        : $"{resource.ContactPhoneCountryCode} {resource.ContactPhoneNumber}"
            }
        ).ToList();

    string mapResourcesJson =
        JsonSerializer.Serialize(
            mapResources,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy =
                    JsonNamingPolicy.CamelCase
            }
        );
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        @pageTitle - Beredskapsportal
    </title>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

</head>

<body>


<!-- =========================================
     HEADER
========================================= -->

<header class="provider-header">

    <a
        asp-controller="Home"
        asp-action="Dashboard"
        class="provider-brand">

        <div class="brand-icon">

            <svg
                viewBox="0 0 24 24"
                aria-hidden="true">

                <path
                    d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                />

                <path
                    d="M8.5 12.5L11 15l4.8-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

            </svg>

        </div>


        <div>

            <strong>
                Beredskapsportal
            </strong>

            <span>
                @roleLabel
            </span>

        </div>

    </a>


    @* Uses existing routes and only shows provider links to providers. *@
    <nav class="overview-navigation" aria-label="Brukermeny">
        <a asp-controller="Home" asp-action="Dashboard">Oversikt</a>
        @if (isResourceProvider)
        {
            <a asp-controller="Resource" asp-action="ResourceOverview" aria-current="page">Mine ressurser</a>
            <a asp-controller="Resource" asp-action="RegisterResource">Registrer ressurs</a>
            <a asp-controller="Account" asp-action="Profile">Profil</a>
        }
        else
        {
            <a asp-controller="Resource" asp-action="ResourceOverview" aria-current="page">Ressursoversikt</a>
        }
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-button">Logg ut</button>
        </form>
    </nav>
    <div class="provider-user-text">
        <strong>@displayName</strong>
        <span>@roleLabel</span>
    </div>

</header>


<!-- =========================================
     SIDE
========================================= -->

<main class="overview-page">


    <!-- =====================================
         TOPP
    ====================================== -->

    <div class="overview-header">

        <div>

            <span class="page-eyebrow">
                @(isResourceProvider
                    ? "MINE RESSURSER"
                    : "BEREDSKAPSRESSURSER")
            </span>

            <h1>
                @pageTitle
            </h1>

            <p>
                @if (isResourceProvider)
                {
                    <text>
                        Se ressursene du har registrert
                        og hvor de befinner seg.
                    </text>
                }
                else
                {
                    <text>
                        Oversikt over registrerte ressurser
                        som kan være relevante i en beredskapssituasjon.
                    </text>
                }
            </p>

        </div>


        @if (isResourceProvider)
        {
            <a
                asp-controller="Resource"
                asp-action="RegisterResource"
                class="primary-button">

                <span>
                    +
                </span>

                Registrer ny ressurs

            </a>
        }

    </div>


    @if (!resources.Any())
    {
        <!-- =====================================
             TOM OVERSIKT
        ====================================== -->

        <section class="empty-state">

            <div class="empty-icon">
                ◎
            </div>

            <span class="page-eyebrow">
                INGEN RESSURSER
            </span>

            <h2>
                Ingen ressurser registrert
            </h2>


            @if (isResourceProvider)
            {
                <p>
                    Du har ikke registrert noen ressurser ennå.
                    Registrer den første ressursen for å komme i gang.
                </p>


                <a
                    asp-controller="Resource"
                    asp-action="RegisterResource"
                    class="empty-primary-button">

                    + Registrer første ressurs

                </a>
            }
            else
            {
                <p>
                    Det finnes ingen registrerte ressurser
                    å vise akkurat nå.
                </p>
            }

        </section>
    }
    else
    {
        <!-- =====================================
             STATUS
        ====================================== -->

        <section class="overview-status">

            <article class="status-card">

                <span>
                    Registrerte ressurser
                </span>

                <strong>
                    @resources.Count
                </strong>

                <small>
                    I denne oversikten
                </small>

            </article>


            <article class="status-card">

                <span>
                    Ressurstyper
                </span>

                <strong class="green-number">
                    @resourceTypeCount
                </strong>

                <small>
                    Ulike kategorier
                </small>

            </article>


            <article class="status-card">

                <span>
                    Kartpunkter
                </span>

                <strong>
                    @resources.Count
                </strong>

                <small>
                    Registrerte plasseringer
                </small>

            </article>

        </section>


        <!-- =====================================
             LISTE + KART
        ====================================== -->

        @* Combines category and description filters for the list and map. *@
        <form id="resourceFilters" class="resource-filters" role="search" aria-label="Filtrer ressurser" hidden>
            <div class="filter-field">
                <label for="resourceTypeFilter">Ressurstype</label>
                <select id="resourceTypeFilter">
                    <option value="">Alle ressurstyper</option>
                    @foreach (var type in resources.Select(resource => resource.ResourceType).Distinct().OrderBy(type => GetResourceTypeName(type)))
                    {
                        <option value="@((int)type)">@GetResourceTypeName(type)</option>
                    }
                </select>
            </div>
            @* Applies availability together with category and search to the same results. *@
            <div class="filter-field">
                <label for="resourceAvailabilityFilter">Tilgjengelighet</label>
                <select id="resourceAvailabilityFilter">
                    <option value="">Alle statuser</option>
                    <option value="Tilgjengelig">Tilgjengelig</option>
                    <option value="Ikke tilgjengelig">Ikke tilgjengelig</option>
                    <option value="unspecified">Ikke oppgitt / annen status</option>
                </select>
            </div>
            <div class="filter-field filter-search">
                <label for="resourceSearch">Søk i navn eller beskrivelse</label>
                <input id="resourceSearch" type="search" placeholder="Søk etter en ressurs …" />
            </div>
            <button type="reset" class="logout-button">Nullstill filtre</button>
            <p id="filterSummary" role="status" aria-live="polite"></p>
        </form>
        <p id="mapUnavailable" hidden>Kartet kunne ikke lastes. Du kan fortsatt filtrere ressurslisten.</p>

        <div class="overview-grid">


            <!-- =================================
                 RESSURSLISTE
            ================================== -->

            <section class="resource-list-card">

                <div class="section-heading">

                    <div>

                        <span class="page-eyebrow">
                            OVERSIKT
                        </span>

                        <h2>
                            Ressurser
                        </h2>

                    </div>


                    <span class="resource-count" id="filteredResourceCount">
                        @resources.Count
                    </span>

                </div>


                <p id="noMatchingResources" class="filter-empty" hidden>Ingen ressurser passer til filtrene. Prøv en annen ressurstype eller nullstill filtrene.</p>
                <div class="resource-list">

                    @foreach (var resource in resources)
                    {
                        string resourceType =
                            GetResourceTypeName(
                                resource.ResourceType
                            );

                        string registeredDate =
                            resource.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                    "dd.MM.yyyy HH:mm"
                                );

                        <article class="resource-item" data-resource-id="@resource.Id">

                            <div class="resource-item-top">

                                <div class="resource-icon">
                                    @GetResourceIcon(
                                        resource.ResourceType
                                    )
                                </div>


                                <div class="resource-title">

                                    <span class="resource-type">
                                        @resourceType
                                    </span>

                                    <h3>
                                        @(string.IsNullOrWhiteSpace(resource.ResourceName) ? resource.Description : resource.ResourceName)
                                    </h3>

                                    <p>
                                        @resource.Description
                                    </p>

                                </div>


                                <span class="resource-status">
                                    @(string.IsNullOrWhiteSpace(resource.Availability) ? "Ikke oppgitt" : resource.Availability)
                                </span>

                            </div>


                            <!-- INFORMASJON -->
                            <div class="resource-meta">

                                <div>

                                    <span class="meta-label">
                                        Plassering
                                    </span>

                                    <span class="meta-value">
                                        @resource.Position.Latitude.ToString("F5"),
                                        @resource.Position.Longitude.ToString("F5")
                                    </span>

                                </div>


                                <div>

                                    <span class="meta-label">
                                        Registrert
                                    </span>

                                    <span class="meta-value">
                                        @registeredDate
                                    </span>

                                </div>

                            </div>


                            <!-- KONTAKT -->
                            @if (
                                !string.IsNullOrWhiteSpace(
                                    resource.ContactEmail
                                )
                                ||
                                !string.IsNullOrWhiteSpace(
                                    resource.ContactPhoneNumber
                                )
                            )
                            {
                                <div class="contact-box">

                                    <span class="contact-title">
                                        Kontakt
                                    </span>


                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            resource.ContactEmail
                                        )
                                    )
                                    {
                                        <span>
                                            @resource.ContactEmail
                                        </span>
                                    }


                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            resource.ContactPhoneNumber
                                        )
                                    )
                                    {
                                        <span>
                                            @resource.ContactPhoneCountryCode
                                            @resource.ContactPhoneNumber
                                        </span>
                                    }

                                </div>
                            }


                            <!-- HANDLING -->
                            <button
                                type="button"
                                class="map-focus-button"
                                data-latitude="@resource.Position.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-longitude="@resource.Position.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                <span>
                                    ◎
                                </span>

                                Vis i kart

                            </button>

                        </article>
                    }

                </div>

            </section>


            <!-- =================================
                 KART
            ================================== -->

            <section class="map-card">

                <div class="map-card-header">

                    <div>

                        <span class="page-eyebrow">
                            KART
                        </span>

                        <h2>
                            Ressurskart
                        </h2>

                        <p>
                            Klikk på en markør for mer informasjon,
                            eller velg «Vis i kart» fra listen.
                        </p>

                    </div>


                    <div class="map-legend">

                        <span class="map-legend-dot"></span>

                        Registrert ressurs

                    </div>

                </div>


                <div id="resourceOverviewMap"></div>

            </section>

        </div>


        <!-- =====================================
             INFO NEDERST
        ====================================== -->

        <section class="overview-help">

            <div class="overview-help-item">

                <span class="help-number">
                    01
                </span>

                <div>

                    <strong>
                        Finn ressursen
                    </strong>

                    <p>
                        Se registrerte ressurser
                        i listen.
                    </p>

                </div>

            </div>


            <div class="overview-help-item">

                <span class="help-number">
                    02
                </span>

                <div>

                    <strong>
                        Se plassering
                    </strong>

                    <p>
                        Velg «Vis i kart» for å
                        zoome til ressursen.
                    </p>

                </div>

            </div>


            <div class="overview-help-item">

                <span class="help-number">
                    03
                </span>

                <div>

                    <strong>
                        Kontakt ved behov
                    </strong>

                    <p>
                        Bruk registrert kontaktinformasjon
                        dersom ressursen blir aktuell.
                    </p>

                </div>

            </div>

        </section>
    }

</main>


<style>

    /* =========================================
       FARGER
    ========================================= */

    :root {
        --navy: #123047;
        --navy-dark: #0d2639;

        --primary: #176b87;
        --primary-dark: #125770;

        --green: #23855b;

        --background: #f4f6f8;
        --surface: #ffffff;

        --text: #17212b;
        --secondary: #667085;

        --border: #dfe4e8;
    }


    /* =========================================
       BASE
    ========================================= */

    * {
        box-sizing: border-box;
    }


    html,
    body {
        margin: 0;

        min-width: 0;
        min-height: 100%;

        color: var(--text);

        background: var(--background);

        font-family:
            Inter,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }


    body {
        min-height: 100vh;

        overflow-x: hidden;
    }


    a {
        color: inherit;

        text-decoration: none;
    }


    button {
        font: inherit;
    }


    /* =========================================
       HEADER
    ========================================= */

    .provider-header {
        min-height: 72px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;

        padding:
            0 max(
                4vw,
                calc((100vw - 1650px) / 2)
            );

        border-bottom:
            1px solid var(--border);

        background: white;
    }


    .provider-brand {
        display: flex;
        align-items: center;

        gap: 12px;

        min-width: 0;
    }


    .brand-icon {
        width: 41px;
        height: 41px;

        display: grid;
        place-items: center;

        flex-shrink: 0;

        border-radius: 11px;

        color: var(--primary);

        background:
            rgba(
                23,
                107,
                135,
                0.08
            );
    }


    .brand-icon svg {
        width: 23px;
        height: 23px;
    }


    .provider-brand strong {
        display: block;

        color: var(--navy);

        font-size: 0.93rem;
    }


    .provider-brand span {
        display: block;

        margin-top: 2px;

        color: #7b8794;

        font-size: 0.58rem;
        font-weight: 750;

        letter-spacing: 0.12em;

        text-transform: uppercase;
    }


    .provider-user {
        display: flex;
        align-items: center;

        gap: 17px;

        flex-shrink: 0;
    }


    .provider-user-text {
        text-align: right;
    }


    .provider-user-text strong {
        display: block;

        font-size: 0.79rem;
    }


    .provider-user-text span {
        display: block;

        margin-top: 2px;

        color: var(--secondary);

        font-size: 0.66rem;
    }


    .provider-user form {
        margin: 0;
    }


    .dashboard-link {
        padding:
            9px 12px;

        border-radius: 8px;

        color: #52606c;

        font-size: 0.73rem;
        font-weight: 700;
    }


    .dashboard-link:hover {
        color: var(--primary);

        background:
            rgba(
                23,
                107,
                135,
                0.06
            );
    }


    .logout-button {
        padding:
            9px 14px;

        border:
            1px solid var(--border);

        border-radius: 8px;

        color: #344054;

        background: white;

        font-size: 0.75rem;
        font-weight: 700;

        cursor: pointer;
    }


    .logout-button:hover {
        background: #f7f8f9;
    }


    /* =========================================
       SIDE
    ========================================= */

    .overview-page {
        width:
            min(
                1650px,
                calc(100% - 48px)
            );

        min-width: 0;

        margin:
            0 auto;

        padding:
            44px 0 65px;
    }


    .overview-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 40px;

        margin-bottom: 26px;
    }


    .overview-header > div {
        min-width: 0;
    }


    .page-eyebrow {
        display: block;

        margin-bottom: 9px;

        color: var(--primary);

        font-size: 0.66rem;
        font-weight: 850;

        letter-spacing: 0.11em;

        text-transform: uppercase;
    }


    .overview-header h1 {
        margin:
            0 0 10px;

        color: var(--navy-dark);

        font-size:
            clamp(
                2.3rem,
                4vw,
                3.2rem
            );

        line-height: 1;

        letter-spacing: -0.045em;
    }


    .overview-header p {
        max-width: 680px;

        margin: 0;

        color: var(--secondary);

        font-size: 0.9rem;

        line-height: 1.65;
    }


    .primary-button {
        min-height: 47px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        flex-shrink: 0;

        padding:
            0 18px;

        border-radius: 9px;

        color: white;

        background: var(--primary);

        font-size: 0.75rem;
        font-weight: 800;
    }


    .primary-button:hover {
        color: white;

        background: var(--primary-dark);
    }


    .primary-button > span {
        font-size: 1rem;
    }


    /* =========================================
       STATUS
    ========================================= */

    .overview-status {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 15px;

        margin-bottom: 20px;
    }


    .status-card {
        min-width: 0;
        min-height: 112px;

        padding:
            20px 22px;

        border:
            1px solid var(--border);

        border-radius: 13px;

        background: white;
    }


    .status-card > span {
        display: block;

        color: var(--secondary);

        font-size: 0.71rem;
    }


    .status-card > strong {
        display: block;

        margin:
            7px 0 6px;

        color: var(--text);

        font-size: 1.65rem;

        line-height: 1;
    }


    .status-card > strong.green-number {
        color: var(--green);
    }


    .status-card small {
        color: #98a2b3;

        font-size: 0.64rem;
    }


    /* =========================================
       LISTE + KART
    ========================================= */

    .overview-grid {
        display: grid;

        grid-template-columns:
            minmax(370px, 0.72fr)
            minmax(0, 1.78fr);

        gap: 20px;

        align-items: start;

        min-width: 0;
    }


    /* =========================================
       FELLES KORT
    ========================================= */

    .resource-list-card,
    .map-card {
        min-width: 0;

        border:
            1px solid var(--border);

        border-radius: 15px;

        background: white;

        box-shadow:
            0 8px 25px
            rgba(
                18,
                48,
                71,
                0.04
            );
    }


    /* =========================================
       RESSURSLISTE
    ========================================= */

    .resource-list-card {
        padding:
            22px;
    }


    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 18px;
    }


    .section-heading h2 {
        margin: 0;

        color: var(--navy);

        font-size: 1.25rem;

        letter-spacing: -0.03em;
    }


    .resource-count {
        min-width: 33px;
        height: 33px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        padding:
            0 10px;

        border-radius: 999px;

        color: var(--primary);

        background:
            rgba(
                23,
                107,
                135,
                0.08
            );

        font-size: 0.7rem;
        font-weight: 850;
    }


    .resource-list {
        max-height: 560px;

        display: flex;
        flex-direction: column;

        gap: 12px;

        overflow-y: auto;
        overflow-x: hidden;

        padding-right: 4px;
    }


    .resource-list::-webkit-scrollbar {
        width: 7px;
    }


    .resource-list::-webkit-scrollbar-thumb {
        border-radius: 999px;

        background: #d9dfe3;
    }


    /* =========================================
       RESSURSKORT
    ========================================= */

    .resource-item {
        min-width: 0;

        padding:
            17px;

        border:
            1px solid #e0e5e8;

        border-radius: 12px;

        background: #ffffff;

        transition:
            border-color 150ms ease,
            box-shadow 150ms ease;
    }


    .resource-item:hover {
        border-color:
            rgba(
                23,
                107,
                135,
                0.23
            );

        box-shadow:
            0 8px 20px
            rgba(
                18,
                48,
                71,
                0.045
            );
    }


    .resource-item-top {
        display: grid;

        grid-template-columns:
            42px minmax(0, 1fr) auto;

        gap: 12px;

        align-items: start;

        min-width: 0;
    }


    .resource-icon {
        width: 42px;
        height: 42px;

        display: grid;
        place-items: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: white;

        background: var(--primary);

        font-size: 0.72rem;
        font-weight: 850;
    }


    .resource-title {
