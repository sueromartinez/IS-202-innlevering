@* Felles header for alle behovssidene *@

@{
    string userName =
        Context.Session.GetString("UserName") ?? "Beredskapsbruker";
}

<header class="header">

    <a asp-controller="Home" asp-action="Dashboard" class="brand">
        <div class="brand-icon">
            <svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true">
                <path d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="M8.5 12.5L11 15l4.8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div>
            <strong>Beredskapsportal</strong>
            <span>Totalforsvaret</span>
        </div>
    </a>

    <div class="header-user">
        <a asp-controller="Home" asp-action="Dashboard" class="header-link">Oversikt</a>
        <a asp-controller="Need" asp-action="NeedOverview" class="header-link">Behov</a>
        <a asp-controller="Resource" asp-action="ResourceOverview" class="header-link">Ressurser</a>

        <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
        @await Component.InvokeAsync("NotificationBell")

        <div class="header-user-text">
            <strong>@userName</strong>
            <span>@(User.IsInRole("Admin") ? "Administrator" : "Offentlig aktør")</span>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-button">Logg ut</button>
        </form>
    </div>

</header>