@using FirstWebAppInDocker.Models
@model List<Need>

@{
    Layout = null;

    // Identity-ID brukes for eierskap, e-post for eldre behov.
    string? currentUserId =
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    string? userEmail =
        (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name);

    string? message =
        TempData["NeedMessage"] as string;

    // Henter visningsnavnet til ressurstypene, f.eks. "Strøm / aggregat"
    var typeNames =
        Html.GetEnumSelectList<ResourceType>()
            .ToDictionary(item => item.Value, item => item.Text);
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Behov - Beredskapsportal</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/need.css" asp-append-version="true" />
    <!-- Fargetema: lyst/mørkt tema -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>

<body>

<partial name="_PortalHeader" />


<main class="page">

    <div class="page-header">
        <div>
            <span class="eyebrow">BEHOV</span>
            <h1>Registrerte behov</h1>
            <p>Alle behov som er registrert. Du kan endre og slette behov du selv har registrert.</p>
        </div>

        <a asp-controller="Need" asp-action="RegisterNeed" class="primary-link">+ Registrer behov</a>
    </div>

    @if (message != null)
    {
        <div class="success">✓ @message</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card empty-state">
            <strong>Ingen behov er registrert ennå.</strong>
            <p>Registrerte behov vil vises her og i kartet.</p>
            <a asp-controller="Need" asp-action="RegisterNeed" class="primary-link">+ Registrer behov</a>
        </div>
    }
    else
    {
        <div class="grid">

            <!-- LISTE -->
            <section class="card">

                <div id="needList" class="entry-list">

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        Need need = Model[i];

                        bool isPlanned = need.Priority == NeedPriority.Planned;
                        bool isOwn =
                            need.OwnerUserId == currentUserId
                            || (need.OwnerUserId == null && need.OwnerEmail == userEmail);

                        // NeedController lar bare eieren endre og slette.
                        bool canEdit = isOwn;
                        string statusClass = need.Status switch
                        {
                            NeedStatus.UnderReview => "status-review",
                            NeedStatus.Assigned => "status-assigned",
                            NeedStatus.Resolved => "status-resolved",
                            _ => "status-new"
                        };
                        string statusName = need.Status switch
                        {
                            NeedStatus.UnderReview => "Vurderes",
                            NeedStatus.Assigned => "Tildelt",
                            NeedStatus.Resolved => "Løst",
                            _ => "Ny"
                        };

                        string typeName =
                            typeNames.GetValueOrDefault(((int)need.ResourceType).ToString())
                            ?? need.ResourceType.ToString();

                        <article class="entry @(isPlanned ? "planned" : "")"
                                 data-type="@need.ResourceType" data-lat="@need.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-lng="@need.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-planned="@(isPlanned ? "true" : "false")">

                            <div class="entry-top">
                                <span class="need-number">@(i + 1)</span>
                                <strong>@typeName</strong>
                                <span class="badge">@(isPlanned ? "Planlagt" : "Akutt")</span>
                                <span class="entry-quantity">Antall: @need.Quantity</span>
                                <span class="need-status @statusClass">@statusName</span>
                            </div>

                            <p class="entry-description">@need.Description</p>

                            <div class="entry-bottom">
                                <span class="entry-meta">
                                    Registrert @need.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    @(isOwn ? "av deg" : $"av {need.OwnerEmail}")
                                </span>

                                <div class="entry-actions">
                                    @if (need.Status != NeedStatus.Resolved)
                                    {
                                        <a asp-controller="Match" asp-action="Need" asp-route-id="@need.Id"
                                           class="small-button primary">Finn ressurser</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Match" asp-action="Need" asp-route-id="@need.Id"
                                           class="small-button">Se tildeling</a>
                                    }

                                @if (canEdit)
                                {
                                        <a asp-controller="Need" asp-action="EditNeed" asp-route-id="@need.Id"
                                           class="small-button">Endre</a>

                                        <form asp-controller="Need" asp-action="DeleteNeed" asp-route-id="@need.Id"
                                              method="post"
                                              onsubmit="return confirm('Er du sikker på at du vil slette dette behovet?');">
                                            <button type="submit" class="small-button danger">Slett</button>
                                        </form>
                                }
                                </div>
                            </div>

                        </article>
                    }

                </div>

            </section>


            <!-- KART -->
            <section class="card map-card">
                <p class="map-help">Klikk på et behov i listen for å se det i kartet.</p>
                <div id="map"></div>
                <p class="legend">
                    <span><i style="background: var(--acute)"></i> Akutt</span>
                    <span><i style="background: var(--planned)"></i> Planlagt</span>
                </p>
            </section>

        </div>
    }

</main>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/kartverket.js" asp-append-version="true"></script>

<script>

    // SVG_SYMBOL_V3
// Kartsymboler: symbolFor() gir SVG-ikonet som passer til typen behov eller ressurs,
// og createSymbolMarker() tegner kartpinnen med ikonet (og eventuelt et nummer).
function symbolFor(type) {
    const icons = {
        Transport: "<path d='M1 3h15v13H1z'/><path d='M16 8h4l3 3v5h-7z'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/>",
        Drone: "<circle cx='12' cy='12' r='3'/><circle cx='5' cy='5' r='2.5'/><circle cx='19' cy='5' r='2.5'/><circle cx='5' cy='19' r='2.5'/><circle cx='19' cy='19' r='2.5'/><path d='M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3'/>",
        Generator: "<polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/>",
        Machinery: "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",
        CommunicationEquipment: "<circle cx='12' cy='12' r='2'/><path d='M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14'/>",
        Personnel: "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'/>",
        Premises: "<path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/>",
        SandAndGravel: "<polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/>",
        Boat: "<circle cx='12' cy='5' r='3'/><line x1='12' y1='22' x2='12' y2='8'/><path d='M5 12H2a10 10 0 0 0 20 0h-3'/>",
        Other: "<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>"
    };
    return icons[type] || icons.Other;
}

function createSymbolMarker(color, type, badge) {
    const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='" + color + "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>" + symbolFor(type) + "</svg>";
    const badgeHtml = badge ? "<div style='position:absolute;top:-6px;right:-6px;min-width:20px;height:20px;padding:0 4px;border-radius:10px;background:#102d43;color:white;border:2px solid white;box-sizing:border-box;font:700 11px/16px sans-serif;text-align:center;'>" + badge + "</div>" : "";
    return L.divIcon({
        className: "",
        html: "<div style='position:relative;width:50px;height:62px;'><div style='position:absolute;left:0;top:0;width:50px;height:50px;box-sizing:border-box;border:3px solid white;border-radius:50% 50% 50% 8px;transform:rotate(-45deg);background:" + color + ";box-shadow:0 5px 14px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;'><div style='transform:rotate(45deg);width:36px;height:36px;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;'>" + svg + "</div></div>" + badgeHtml + "</div>",
        iconSize: [50, 62],
        iconAnchor: [25, 60],
        popupAnchor: [0, -54]
    });
}

    const entries = Array.from(document.querySelectorAll(".entry"));

    if (entries.length > 0) {

        const map = L.map("map");

        addKartverketLayers(map);

        const bounds = [];

        // Én markør per behov, med samme nummer som i listen
        entries.forEach((entry, index) => {
            const position = [parseFloat(entry.dataset.lat), parseFloat(entry.dataset.lng)];
            const color = entry.dataset.planned === "true" ? "#d99a24" : "#d34b4b";

            const marker = L.marker(position, {
                icon: createSymbolMarker(color, entry.dataset.type, String(index + 1))
            }).addTo(map);

            bounds.push(position);

            // Klikk på markør: marker behovet i listen
            marker.on("click", () => {
                select(entry);
                entry.scrollIntoView({ behavior: "smooth", block: "nearest" });
            });

            // Klikk på behovet i listen: vis det i kartet
            entry.addEventListener("click", event => {
                if (event.target.closest("a, button")) return;
                select(entry);
                map.setView(position, 14);
            });
        });

        function select(entry) {
            entries.forEach(other => other.classList.toggle("active", other === entry));
        }

        // Zoom slik at alle behov synes
        if (bounds.length === 1) {
            map.setView(bounds[0], 13);
        } else {
            map.fitBounds(bounds, { padding: [40, 40] });
        }
    }

</script>

<partial name="_Sami" />
</body>
</html>