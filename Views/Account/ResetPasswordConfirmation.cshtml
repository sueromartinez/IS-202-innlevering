
@{
    Layout = null;
    ViewData["Title"] = "Passord endret - Beredskapsportalen";
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>@ViewData["Title"]</title>

    <link
        rel="stylesheet"
        href="~/css/theme.css"
        asp-append-version="true"
    />

    <script
        src="~/js/theme.js"
        asp-append-version="true">
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, -apple-system,
                BlinkMacSystemFont, "Segoe UI",
                sans-serif;
            background: #f3f6f8;
            color: #172b3d;
        }

        .reset-header {
            background: #102d43;
            padding: 18px 5%;
        }

        .reset-brand {
            display: inline-flex;
            align-items: center;
            gap: 13px;
            color: #ffffff;
            text-decoration: none;
        }

        .reset-brand img {
            width: auto;
            height: 46px;
        }

        .reset-brand strong {
            display: block;
            font-size: 18px;
        }

        .reset-brand span {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            color: #c2d1dc;
        }

        .reset-main {
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 480px;
            padding: 42px 38px;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 12px 45px
                rgba(16, 45, 67, 0.10);
            text-align: center;
        }

        .success-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            margin: 0 auto 26px;
            border-radius: 50%;
            background: #e8f4ef;
            color: #16855a;
        }

        .success-icon svg {
            width: 42px;
            height: 42px;
        }

        .reset-label {
            display: block;
            margin-bottom: 12px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #16855a;
        }

        .reset-card h1 {
            margin: 0 0 16px;
            font-size: 29px;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .reset-description {
            margin: 0 0 26px;
            font-size: 14px;
            line-height: 1.8;
            color: #617184;
        }

        .success-message {
            margin-bottom: 30px;
            padding: 18px 20px;
            border-radius: 10px;
            background: #e8f4ef;
            border: 1px solid #c9e8d8;
            color: #176644;
            text-align: left;
        }

        .success-message strong {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .success-message p {
            margin: 0;
            font-size: 13px;
            line-height: 1.7;
        }

        .login-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 50px;
            padding: 13px 18px;
            border-radius: 9px;
            background: #16855a;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            text-decoration: none;
            transition: background 0.2s;
        }

        .login-button:hover {
            background: #116b49;
        }

        .login-button:focus-visible {
            outline: 3px solid #16855a;
            outline-offset: 3px;
        }

        .security-note {
            margin-top: 25px;
            font-size: 12px;
            line-height: 1.7;
            color: #758594;
        }

        .reset-footer {
            padding: 20px;
            text-align: center;
            color: #758594;
            font-size: 12px;
        }

        @@media (max-width: 520px) {
            .reset-main {
                padding: 35px 16px;
            }

            .reset-card {
                padding: 32px 24px;
            }

            .reset-card h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <!-- ========================================
         HEADER
    ======================================== -->

    <header class="reset-header">

        <a
            href="@Url.Action("Index", "Home")"
            class="reset-brand">

            <img
                src="~/images/logo.png"
                alt="Beredskapsportalen"
            />

            <div>
                <strong>Beredskapsportal</strong>
                <span>Totalforsvaret</span>
            </div>

        </a>

    </header>

    <!-- ========================================
         HOVEDINNHOLD
    ======================================== -->

    <main class="reset-main">

        <section
            class="reset-card"
            aria-labelledby="confirmation-title">

            <!-- SUKSESSIKON -->

            <div
                class="success-icon"
                aria-hidden="true">

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">

                    <circle
                        cx="12"
                        cy="12"
                        r="10"
                    />

                    <path
                        d="m7.5 12 3 3 6-6"
                    />

                </svg>

            </div>

            <span class="reset-label">
                Passordtilbakestilling fullført
            </span>

            <h1 id="confirmation-title">
                Passordet er endret!
            </h1>

            <p class="reset-description">
                Du har opprettet et nytt passord
                for brukerkontoen din.

                Du kan nå logge inn på
                Beredskapsportalen med det
                nye passordet.
            </p>

            <!-- BEKREFTELSE -->

            <div
                class="success-message"
                role="status">

                <strong>
                    ✓ Passordet ble oppdatert
                </strong>

                <p>
                    Det gamle passordet kan ikke
                    lenger brukes til å logge inn.
                </p>

            </div>

            <!-- TILBAKE TIL INNLOGGING -->

            <a
                href="@Url.Action("Index", "Home")#login"
                class="login-button">

                Gå til innlogging

            </a>

            <!-- SIKKERHETSINFORMASJON -->

            <p class="security-note">
                Av sikkerhetsgrunner må du logge
                inn på nytt.

                Dersom kontoen din bruker
                tofaktorautentisering, må du
                også bekrefte innloggingen
                med en sikkerhetskode.
            </p>

        </section>

    </main>

    <!-- ========================================
         FOOTER
    ======================================== -->

    <footer class="reset-footer">
        Beredskapsportalen · Studentprosjekt
    </footer>

</body>
</html>
