
@model FirstWebAppInDocker.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Glemt passord - Beredskapsportalen";
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>@ViewData["Title"]</title>

    <link
        rel="stylesheet"
        href="~/css/theme.css"
        asp-append-version="true"
    />

    <script
        src="~/js/theme.js"
        asp-append-version="true">
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, -apple-system,
                BlinkMacSystemFont, "Segoe UI",
                sans-serif;
            background: #f3f6f8;
            color: #172b3d;
        }

        .reset-header {
            background: #102d43;
            padding: 18px 5%;
        }

        .reset-brand {
            display: inline-flex;
            align-items: center;
            gap: 13px;
            color: #ffffff;
            text-decoration: none;
        }

        .reset-brand img {
            width: auto;
            height: 46px;
        }

        .reset-brand strong {
            display: block;
            font-size: 18px;
        }

        .reset-brand span {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            color: #c2d1dc;
        }

        .reset-main {
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 460px;
            padding: 42px 38px;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 12px 45px
                rgba(16, 45, 67, 0.10);
        }

        .reset-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            border-radius: 15px;
            background: #e8f4ef;
            color: #15845a;
            font-size: 28px;
            margin-bottom: 24px;
        }

        .reset-label {
            display: block;
            margin-bottom: 10px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #16855a;
        }

        .reset-card h1 {
            margin: 0 0 12px;
            font-size: 28px;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .reset-description {
            margin: 0 0 30px;
            font-size: 14px;
            line-height: 1.8;
            color: #617184;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 600;
        }

        .form-group input {
            display: block;
            width: 100%;
            height: 49px;
            padding: 12px 14px;
            border: 1px solid #d5dee5;
            border-radius: 9px;
            background: #ffffff;
            color: #172b3d;
            font: inherit;
            font-size: 14px;
            transition: border-color 0.2s,
                box-shadow 0.2s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #16855a;
            box-shadow: 0 0 0 3px
                rgba(22, 133, 90, 0.12);
        }

        .form-group input::placeholder {
            color: #98a5b1;
        }

        .validation-message,
        .validation-summary {
            display: block;
            color: #bd3030;
            font-size: 13px;
            line-height: 1.5;
        }

        .validation-message {
            margin-top: 7px;
        }

        .validation-summary {
            margin-bottom: 15px;
        }

        .validation-summary ul {
            padding-left: 20px;
        }

        .reset-button {
            display: block;
            width: 100%;
            min-height: 49px;
            padding: 13px 18px;
            border: none;
            border-radius: 9px;
            background: #16855a;
            color: #ffffff;
            font: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
        }

        .reset-button:hover {
            background: #116b49;
        }

        .reset-button:focus-visible,
        .back-link:focus-visible {
            outline: 3px solid #16855a;
            outline-offset: 3px;
        }

        .back-link {
            display: block;
            width: fit-content;
            margin: 25px auto 0;
            color: #27647a;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .reset-footer {
            padding: 20px;
            text-align: center;
            color: #758594;
            font-size: 12px;
        }

        @@media (max-width: 520px) {
            .reset-main {
                padding: 35px 16px;
            }

            .reset-card {
                padding: 32px 24px;
            }

            .reset-card h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header class="reset-header">
        <a
            href="@Url.Action("Index", "Home")"
            class="reset-brand">

            <img
                src="~/images/logo.png"
                alt="Beredskapsportalen"
            />

            <div>
                <strong>Beredskapsportal</strong>
                <span>Totalforsvaret</span>
            </div>

        </a>
    </header>

    <!-- HOVEDINNHOLD -->

    <main class="reset-main">

        <section
            class="reset-card"
            aria-labelledby="reset-title">

            <div class="reset-icon" aria-hidden="true">
                ✉
            </div>

            <span class="reset-label">
                Kontogjenoppretting
            </span>

            <h1 id="reset-title">
                Glemt passord?
            </h1>

            <p class="reset-description">
                Skriv inn e-postadressen som er
                knyttet til brukerkontoen din.

                Hvis adressen er registrert og
                bekreftet, sender vi deg en lenke
                for å opprette et nytt passord.
            </p>

            <!-- SKJEMA -->

            <form
                asp-controller="Account"
                asp-action="ForgotPassword"
                method="post">

                <div
                    asp-validation-summary="ModelOnly"
                    class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="Email">
                        E-postadresse
                    </label>

                    <input
                        asp-for="Email"
                        type="email"
                        autocomplete="email"
                        inputmode="email"
                        maxlength="254"
                        placeholder="navn@eksempel.no"
                        required
                    />

                    <span
                        asp-validation-for="Email"
                        class="validation-message">
                    </span>

                </div>

                <button
                    type="submit"
                    class="reset-button">

                    Send tilbakestillingslenke

                </button>

            </form>

            <!-- TILBAKE TIL INNLOGGING -->

            <a
                href="@Url.Action("Index", "Home")#login"
                class="back-link">

                ← Tilbake til innlogging

            </a>

        </section>

    </main>

    <footer class="reset-footer">
        Beredskapsportalen · Studentprosjekt
    </footer>

</body>
</html>
