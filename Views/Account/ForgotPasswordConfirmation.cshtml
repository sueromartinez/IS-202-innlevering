
@{
    Layout = null;
    ViewData["Title"] = "Sjekk e-posten din - Beredskapsportalen";
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>@ViewData["Title"]</title>

    <link
        rel="stylesheet"
        href="~/css/theme.css"
        asp-append-version="true"
    />

    <script
        src="~/js/theme.js"
        asp-append-version="true">
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, -apple-system,
                BlinkMacSystemFont, "Segoe UI",
                sans-serif;
            background: #f3f6f8;
            color: #172b3d;
        }

        .reset-header {
            background: #102d43;
            padding: 18px 5%;
        }

        .reset-brand {
            display: inline-flex;
            align-items: center;
            gap: 13px;
            color: #ffffff;
            text-decoration: none;
        }

        .reset-brand img {
            width: auto;
            height: 46px;
        }

        .reset-brand strong {
            display: block;
            font-size: 18px;
        }

        .reset-brand span {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            color: #c2d1dc;
        }

        .reset-main {
            min-height: calc(100vh - 160px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 480px;
            padding: 42px 38px;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 12px 45px
                rgba(16, 45, 67, 0.10);
            text-align: center;
        }

        .reset-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 68px;
            height: 68px;
            margin: 0 auto 26px;
            border-radius: 18px;
            background: #e8f4ef;
            color: #15845a;
        }

        .reset-icon svg {
            width: 35px;
            height: 35px;
        }

        .reset-label {
            display: block;
            margin-bottom: 12px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #16855a;
        }

        .reset-card h1 {
            margin: 0 0 16px;
            font-size: 29px;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .reset-description {
            margin: 0 0 24px;
            font-size: 14px;
            line-height: 1.8;
            color: #617184;
        }

        .info-box {
            padding: 17px 20px;
            margin-bottom: 30px;
            border-radius: 10px;
            background: #eef5f7;
            border: 1px solid #dce9ee;
            text-align: left;
        }

        .info-box p {
            margin: 0;
            font-size: 13px;
            line-height: 1.7;
            color: #456275;
        }

        .reset-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 49px;
            padding: 13px 18px;
            border-radius: 9px;
            background: #16855a;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            text-decoration: none;
            transition: background 0.2s;
        }

        .reset-button:hover {
            background: #116b49;
        }

        .reset-button:focus-visible,
        .back-link:focus-visible {
            outline: 3px solid #16855a;
            outline-offset: 3px;
        }

        .back-link {
            display: inline-block;
            margin-top: 24px;
            color: #27647a;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .reset-footer {
            padding: 20px;
            text-align: center;
            color: #758594;
            font-size: 12px;
        }

        @@media (max-width: 520px) {
            .reset-main {
                padding: 35px 16px;
            }

            .reset-card {
                padding: 32px 24px;
            }

            .reset-card h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <!-- ========================================
         HEADER
    ======================================== -->

    <header class="reset-header">

        <a
            href="@Url.Action("Index", "Home")"
            class="reset-brand">

            <img
                src="~/images/logo.png"
                alt="Beredskapsportalen"
            />

            <div>
                <strong>Beredskapsportal</strong>
                <span>Totalforsvaret</span>
            </div>

        </a>

    </header>

    <!-- ========================================
         HOVEDINNHOLD
    ======================================== -->

    <main class="reset-main">

        <section
            class="reset-card"
            aria-labelledby="confirmation-title">

            <!-- E-POSTIKON -->

            <div class="reset-icon" aria-hidden="true">

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round">

                    <rect
                        x="3"
                        y="5"
                        width="18"
                        height="14"
                        rx="2"
                    />

                    <path d="m3 7 9 6 9-6" />

                    <circle
                        cx="18"
                        cy="18"
                        r="4"
                        fill="#e8f4ef"
                        stroke="#15845a"
                    />

                    <path
                        d="m16.5 18 1 1 2-2"
                        stroke="#15845a"
                    />

                </svg>

            </div>

            <span class="reset-label">
                Passordtilbakestilling
            </span>

            <h1 id="confirmation-title">
                Sjekk e-posten din
            </h1>

            <p class="reset-description">

                Hvis e-postadressen er knyttet til
                en bekreftet brukerkonto, har vi
                forsøkt å sende en lenke for
                tilbakestilling av passord.

                <br />
                <br />

                Åpne lenken i e-posten for
                å opprette et nytt passord.

            </p>

            <!-- INFORMASJON -->

            <div class="info-box">

                <p>
                    <strong>Finner du ikke e-posten?</strong>
                    <br />
                    Kontroller at du har skrevet inn
                    riktig e-postadresse.

                    Du kan også prøve å sende
                    en ny forespørsel.
                </p>

            </div>

            <!-- TILBAKE TIL INNLOGGING -->

            <a
                href="@Url.Action("Index", "Home")#login"
                class="reset-button">

                Tilbake til innlogging

            </a>

            <!-- PRØV IGJEN -->

            <a
                asp-controller="Account"
                asp-action="ForgotPassword"
                class="back-link">

                ← Send ny forespørsel

            </a>

        </section>

    </main>

    <!-- ========================================
         FOOTER
    ======================================== -->

    <footer class="reset-footer">
        Beredskapsportalen · Studentprosjekt
    </footer>

</body>
</html>
