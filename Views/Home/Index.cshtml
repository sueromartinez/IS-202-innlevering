
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@model FirstWebAppInDocker.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Beredskapsportal";

    string? loginError =
        TempData["LoginError"] as string;

    bool hasLoginErrors =
        !string.IsNullOrWhiteSpace(loginError);

    string? registerError =
        TempData["RegisterError"] as string;

    string registerName =
        TempData["RegisterName"] as string
        ?? string.Empty;

    string registerEmail =
        TempData["RegisterEmail"] as string
        ?? string.Empty;

    bool hasRegisterErrors =
        !string.IsNullOrWhiteSpace(registerError);
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        Beredskapsportal
    </title>

    <link
        rel="stylesheet"
        href="~/css/home.css"
        asp-append-version="true"
    />

    <!-- Fargetema: lyst/mørkt tema -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>

<body>


<!-- ==========================================
     HEADER
=========================================== -->

<header class="site-header">

    <a
        href="#top"
        class="brand">

        <img src="/images/logo.png" alt="Logo" style="height: 46px; width: auto;" />

        <div>

            <strong>
                Beredskapsportal
            </strong>

            <span>
                Totalforsvaret
            </span>

        </div>

    </a>

    <nav class="header-nav">

        <a href="#how">
            Slik fungerer det
        </a>

        <a
            href="#login"
            class="header-login"
            data-open-auth="login">

            Logg inn

        </a>

    </nav>

</header>


<main id="top">


<!-- ==========================================
     HERO (bakgrunnsbilde: wwwroot/images/forside/hero.jpg)
=========================================== -->

<section class="hero-banner">

    <div class="hero-banner-content">

        <div class="hero-label">
            Sammen for et tryggere Norge
        </div>

        <h1>
            Gjør en forskjell når det faktisk gjelder
        </h1>

        <p class="hero-description">
            Del utstyr, kompetanse og ressurser med andre, og styrk
            beredskapen i lokalsamfunnet, regionen og hele Norge.
        </p>

        <div class="hero-actions">

            <a
                href="#login"
                class="primary-button"
                data-open-auth="register">

                Registrer ressurs

                <span aria-hidden="true">
                    →
                </span>

            </a>

            <a
                href="#how"
                class="secondary-button">

                Slik fungerer det

            </a>

        </div>

    </div>

</section>


<!-- ==========================================
     STYRK BEREDSKAPEN (bilde: sivilt.jpg)
=========================================== -->

<section class="feature-section">

    <div class="feature-split">

        <div
            class="feature-image"
            role="img"
            aria-label="Person i fjellandskap med utsikt over fjorden">
        </div>

        <div class="feature-copy">

            <span class="section-label">
                Dele ressurser
            </span>

            <h2>
                Styrk beredskapen der du bor
            </h2>

            <p>
                Din ressurs kan være avgjørende. Gjør den synlig for
                andre, og bidra til et mer robust og forberedt
                lokalsamfunn.
            </p>

            <a
                href="#login"
                class="feature-link"
                data-open-auth="register">

                Kom i gang

                <span aria-hidden="true">
                    →
                </span>

            </a>

        </div>

    </div>

</section>


<!-- ==========================================
     DEL, FINN OG BIDRA (fire kort med bilder)
=========================================== -->

<section class="topics-section">

    <div class="section-container">

        <div class="section-heading">

            <span class="section-label">
                Ressurser og kompetanse
            </span>

            <h2>
                Del, finn og bidra med ressurser
            </h2>

            <p>
                En felles plattform for utstyr, kompetanse og kapasitet
                som kan være avgjørende når det virkelig gjelder.
            </p>

            <div class="hero-audience">

                <span>
                    Privatpersoner
                </span>

                <span>
                    Virksomheter
                </span>

                <span>
                    Frivillige organisasjoner
                </span>

            </div>

        </div>

        <div class="topics-grid">

            <article class="topic-card">

                <div
                    class="topic-image topic-transport"
                    role="img"
                    aria-label="Terrengbil med henger i vinterlandskap">
                </div>

                <h3>
                    Transport og maskiner
                </h3>

                <p>
                    Kjøretøy, henger, båt, traktor og tunge maskiner.
                </p>

            </article>

            <article class="topic-card">

                <div
                    class="topic-image topic-utstyr"
                    role="img"
                    aria-label="Drone og utstyr, og samband i snølandskap">
                </div>

                <h3>
                    Utstyr og kritisk infrastruktur
                </h3>

                <p>
                    Droner, samband, aggregat, strøm og støttefunksjoner.
                </p>

            </article>

            <article class="topic-card">

                <div
                    class="topic-image topic-kompetanse"
                    role="img"
                    aria-label="Frivillige i røde jakker som samarbeider">
                </div>

                <h3>
                    Kompetanse og mannskap
                </h3>

                <p>
                    Fagkunnskap, erfaring og ressurspersoner.
                </p>

            </article>

            <article class="topic-card">

                <div
                    class="topic-image topic-forsyninger"
                    role="img"
                    aria-label="Lager med drivstoffdunker og materiell">
                </div>

                <h3>
                    Forsyninger og materiell
                </h3>

                <p>
                    Drivstoff, mat, varme, telt og annet utstyr.
                </p>

            </article>

        </div>

    </div>

</section>


<!-- ==========================================
     SLIK FUNGERER DET
=========================================== -->

<section
    class="how-section"
    id="how">

    <div class="section-container">

        <div class="section-heading">

            <span class="section-label">
                Slik fungerer det
            </span>

            <h2>
                Tre enkle steg
            </h2>

            <p>
                Kom i gang på få minutter. Registrer en ressurs,
                gjør den tilgjengelig og bidra til økt beredskap
                i ditt område.
            </p>

        </div>

        <div class="steps-row">

            <article class="flow-step">

                <div class="step-number">
                    01
                </div>

                <div>
                    <h3>
                        Registrer ressursen
                    </h3>
                    <p>
                        Legg inn utstyr, kompetanse eller kapasitet
                        du kan dele.
                    </p>
                </div>

            </article>

            <span class="flow-arrow" aria-hidden="true">
                →
            </span>

            <article class="flow-step">

                <div class="step-number">
                    02
                </div>

                <div>
                    <h3>
                        Gjør den tilgjengelig
                    </h3>
                    <p>
                        Bestem tilgjengelighet, omfang og relevante
                        detaljer.
                    </p>
                </div>

            </article>

            <span class="flow-arrow" aria-hidden="true">
                →
            </span>

            <article class="flow-step">

                <div class="step-number">
                    03
                </div>

                <div>
                    <h3>
                        Bidra ved behov
                    </h3>
                    <p>
                        Ressursen kan finne sin plass når det oppstår
                        et reelt behov.
                    </p>
                </div>

            </article>

        </div>

    </div>

</section>


<!-- ==========================================
     DIN RESSURS KAN VÆRE AVGJØRENDE (bilde: katastrofe.jpg)
=========================================== -->

<section class="mission-section">

    <div class="mission-card">

        <div class="mission-copy">

            <h2>
                Din ressurs kan være avgjørende
            </h2>

            <p>
                Alt fra en drone og en henger til fagkunnskap og
                mannskap kan gjøre en stor forskjell når samfunnet
                utfordres. Bli en del av Beredskapsportal i dag.
            </p>

            <div class="mission-actions">

                <a
                    href="#login"
                    class="primary-button"
                    data-open-auth="register">

                    Registrer ressurs

                    <span aria-hidden="true">
                        →
                    </span>

                </a>

                <a
                    href="#how"
                    class="secondary-button">

                    Les mer

                </a>

            </div>

        </div>

        <div
            class="mission-image"
            role="img"
            aria-label="Redningsmannskap og helikopter ved et steinras">
        </div>

    </div>

</section>


<!-- ==========================================
     LOGIN / REGISTER
=========================================== -->

<section
    class="login-section"
    id="login">

    <div class="login-layout">

        <div class="login-copy">

            <span class="section-label">
                Beredskapsportal
            </span>

            <h2>
                Klar til å gjøre en forskjell?
            </h2>

            <p>
                Logg inn hvis du allerede har en bruker,
                eller opprett en ny bruker for å registrere
                ressurser du kan bidra med.
            </p>

            <div class="login-ending">
                Det vi har sammen, gjør oss bedre rustet.
            </div>

        </div>


        <div
            class="login-card"
            id="authCard">

            <div
                class="auth-tabs"
                role="tablist"
                aria-label="Brukertilgang">

                <button
                    type="button"
                    class="auth-tab active"
                    id="loginTab"
                    role="tab"
                    aria-selected="true"
                    aria-controls="loginPanel"
                    data-auth-tab="login">

                    Logg inn

                </button>

                <button
                    type="button"
                    class="auth-tab"
                    id="registerTab"
                    role="tab"
                    aria-selected="false"
                    aria-controls="registerPanel"
                    data-auth-tab="register">

                    Registrer bruker

                </button>

            </div>


            <!-- ==========================================
                 LOGG INN
            =========================================== -->

            <div
                id="loginPanel"
                class="auth-panel"
                role="tabpanel"
                aria-labelledby="loginTab">

                <span class="login-card-label">
                    Logg inn
                </span>

                <h3>
                    Velkommen tilbake
                </h3>

                @if (hasLoginErrors)
                {
                    <div class="auth-error">
                        @loginError
                    </div>
                }

                <form
                    asp-controller="Account"
                    asp-action="Login"
                    method="post">

                    <div
                        asp-validation-summary="ModelOnly"
                        class="validation-summary">
                    </div>

                    <div class="login-group">

                        <label asp-for="Email">
                            E-post
                        </label>

                        <input
                            asp-for="Email"
                            autocomplete="email"
                            placeholder="navn@eksempel.no"
                        />

                        <span
                            asp-validation-for="Email"
                            class="validation-message">
                        </span>

                    </div>

                    <div class="login-group">

                        <label asp-for="Password">
                            Passord
                        </label>

                        <input
                            asp-for="Password"
                            autocomplete="current-password"
                            placeholder="Skriv inn passord"
                        />

                        <span
                            asp-validation-for="Password"
                            class="validation-message">
                        </span>

                    </div>

                    <button
                        type="submit"
                        class="login-submit">

                        Logg inn

                    </button>

                </form>


                <!-- ==========================================
                     DEMOINNLOGGING
                     KUN I DEVELOPMENT
                =========================================== -->

                @if (HostingEnvironment.IsDevelopment())
                {
                    <div class="login-divider">
                        eller
                    </div>

                    <form
                        asp-controller="Account"
                        asp-action="DemoPublicActorLogin"
                        method="post"
                        class="demo-login-form">

                        <button
                            type="submit"
                            class="demo-button">

                            Fortsett som offentlig testbruker

                        </button>

                    </form>

                    <p class="demo-note">
                        Midlertidig testinnlogging for prosjektet.
                    </p>
                }

            </div>


            <!-- ==========================================
                 REGISTRER BRUKER
            =========================================== -->

            <div
                id="registerPanel"
                class="auth-panel hidden"
                role="tabpanel"
                aria-labelledby="registerTab">

                <span class="login-card-label">
                    Ny bruker
                </span>

                <h3>
                    Opprett bruker
                </h3>

                <p class="auth-intro">
                    Opprett en bruker for å registrere
                    og administrere ressurser du kan bidra med.
                </p>

                @if (hasRegisterErrors)
                {
                    <div class="auth-error">
                        @registerError
                    </div>
                }

                <form
                    asp-controller="Account"
                    asp-action="Register"
                    method="post">

                    <div class="login-group">

                        <label for="registerName">
                            Navn
                        </label>

                        <input
                            id="registerName"
                            name="Name"
                            type="text"
                            value="@registerName"
                            autocomplete="name"
                            maxlength="100"
                            required
                            placeholder="Ola Nordmann"
                        />

                    </div>

                    <div class="login-group">

                        <label for="registerEmail">
                            E-post
                        </label>

                        <input
                            id="registerEmail"
                            name="Email"
                            type="email"
                            value="@registerEmail"
                            autocomplete="email"
                            required
                            placeholder="navn@eksempel.no"
                        />

                    </div>

                    <div class="login-group">

                        <label for="registerPassword">
                            Passord
                        </label>

                        <input
                            id="registerPassword"
                            name="Password"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                            placeholder="Minst 8 tegn"
                        />

                    </div>

                    <div class="login-group">

                        <label for="registerConfirmPassword">
                            Bekreft passord
                        </label>

                        <input
                            id="registerConfirmPassword"
                            name="ConfirmPassword"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                            placeholder="Skriv passordet på nytt"
                        />

                    </div>

                    <button
                        type="submit"
                        class="register-submit">

                        Opprett bruker

                    </button>

                </form>

                <p class="register-note">
                    Nye brukere registreres som ressursleverandører.
                </p>

            </div>

        </div>

    </div>

</section>


</main>


<footer class="footer">

    <strong>
        Beredskapsportal
    </strong>

    <span>
        Sammen for et tryggere Norge.
    </span>

    <span>
        Studentprosjekt
    </span>

</footer>


<script>

    const authTabs =
        document.querySelectorAll(
            "[data-auth-tab]"
        );

    const loginPanel =
        document.getElementById(
            "loginPanel"
        );

    const registerPanel =
        document.getElementById(
            "registerPanel"
        );

    const authCard =
        document.getElementById(
            "authCard"
        );


    function activateAuthTab(tabName)
    {
        const showLogin =
            tabName === "login";

        loginPanel.classList.toggle(
            "hidden",
            !showLogin
        );

        registerPanel.classList.toggle(
            "hidden",
            showLogin
        );

        authTabs.forEach(
            tab =>
            {
                const isActive =
                    tab.dataset.authTab ===
                    tabName;

                tab.classList.toggle(
                    "active",
                    isActive
                );

                tab.setAttribute(
                    "aria-selected",
                    isActive
                        ? "true"
                        : "false"
                );
            }
        );
    }


    authTabs.forEach(
        tab =>
        {
            tab.addEventListener(
                "click",
                function ()
                {
                    activateAuthTab(
                        tab.dataset.authTab
                    );
                }
            );
        }
    );


    document
        .querySelectorAll(
            "[data-open-auth]"
        )
        .forEach(
            link =>
            {
                link.addEventListener(
                    "click",
                    function ()
                    {
                        activateAuthTab(
                            link.dataset.openAuth
                        );
                    }
                );
            }
        );


    document
        .querySelectorAll(
            'a[href^="#"]'
        )
        .forEach(
            link =>
            {
                link.addEventListener(
                    "click",
                    function (event)
                    {
                        const targetId =
                            link.getAttribute(
                                "href"
                            );

                        if (
                            !targetId
                            ||
                            targetId === "#"
                        )
                        {
                            return;
                        }

                        const target =
                            document.querySelector(
                                targetId
                            );

                        if (!target)
                        {
                            return;
                        }

                        event.preventDefault();

                        target.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });
                    }
                );
            }
        );


    activateAuthTab("login");


    const hasLoginErrors =
        @hasLoginErrors
            .ToString()
            .ToLowerInvariant();

    const hasRegisterErrors =
        @hasRegisterErrors
            .ToString()
            .ToLowerInvariant();


    if (hasRegisterErrors)
    {
        activateAuthTab(
            "register"
        );

        window.setTimeout(
            function ()
            {
                authCard.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            },
            50
        );
    }
    else if (hasLoginErrors)
    {
        activateAuthTab(
            "login"
        );

        window.setTimeout(
            function ()
            {
                authCard.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            },
            50
        );
    }

</script>


</body>

</html>
