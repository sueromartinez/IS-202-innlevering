@model FirstWebAppInDocker.ViewModels.DashboardViewModel

@using FirstWebAppInDocker.Models

@{
    Layout = null;

    ViewData["Title"] = "Oversikt";

    string userName =
        ViewBag.UserName ?? "Bruker";

    string userRole =
        ViewBag.UserRole ?? "";

    // Admin ser samme dashboard som offentlige aktører.
    bool isOfficial =
        userRole == "PublicActor"
        || userRole == "Admin";
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Beredskapsportal
    </title>


    @if (isOfficial)
    {
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }

    <!-- Fargetema: lyst/mørkt tema -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>


<body>


@if (isOfficial)
{
    <!-- =========================================
         OFFENTLIG AKTØR
         ========================================= -->

    <div class="public-shell">

        <!-- HEADER -->

        <header class="public-header">

            <a
                asp-controller="Home"
                asp-action="Dashboard"
                class="public-brand">

                <div class="brand-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path
                            d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7" />

                        <path
                            d="M8.5 12.5L11 15l4.8-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round" />

                    </svg>

                </div>

                <div>

                    <strong>
                        Beredskapsportal
                    </strong>

                    <span>
                        TOTALFORSVARET
                    </span>

                </div>

            </a>


            <div class="public-header-status">

                <span class="active-dot"></span>

                Situasjonsbilde aktivt

            </div>


            <div class="public-user">

                <div>

                    <strong>
                        @userName
                    </strong>

                    <span>
                        @(userRole == "Admin" ? "Administrator" : "Offentlig aktør")
                    </span>

                </div>


                <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
                @await Component.InvokeAsync("NotificationBell")


                <form
                    asp-controller="Account"
                    asp-action="Logout"
                    method="post">

                    @Html.AntiForgeryToken()

                    <button
                        type="submit"
                        class="logout-button">

                        Logg ut

                    </button>

                </form>

            </div>

        </header>


        <div class="public-layout">

            <!-- SIDEBAR -->

            <aside class="public-sidebar">

                <div class="sidebar-intro">

                    <span class="eyebrow">
                        OPERATIV OVERSIKT
                    </span>

                    <h1>
                        Situasjonsbilde
                    </h1>

                    <p>
                        Behov, ressurser og hendelser samlet
                        i ett geografisk bilde.
                    </p>

                </div>


                <nav class="public-navigation">

                    <a
                        href="#situationMap"
                        class="public-navigation-item active">

                        <span class="navigation-icon">
                            ◎
                        </span>

                        <span>

                            <strong>
                                Kartoversikt
                            </strong>

                            <small>
                                Aktiv visning
                            </small>

                        </span>

                    </a>


                    <a
                        asp-controller="Need"
                        asp-action="NeedOverview"
                        class="public-navigation-item">

                        <span class="navigation-icon">
                            !
                        </span>

                        <span>

                            <strong>
                                Behov
                            </strong>

                            <small>
                                Se registrerte behov
                            </small>

                        </span>

                    </a>


                    <a
                        asp-controller="Resource"
                        asp-action="ResourceOverview"
                        class="public-navigation-item">

                        <span class="navigation-icon">
                            ◆
                        </span>

                        <span>

                            <strong>
                                Ressurser
                            </strong>

                            <small>
                                Se registrerte ressurser
                            </small>

                        </span>

                    </a>


                    @if (userRole == "Admin")
                    {
                        <a
                            asp-controller="Admin"
                            asp-action="Users"
                            class="public-navigation-item">

                            <span class="navigation-icon">
                                ⚙
                            </span>

                            <span>

                                <strong>
                                    Brukere
                                </strong>

                                <small>
                                    Administrer kontoer
                                </small>

                            </span>

                        </a>
                    }

                </nav>


                <section class="quick-actions">

                    <span class="eyebrow">
                        HURTIGHANDLINGER
                    </span>


                    <a
                        asp-controller="Need"
                        asp-action="RegisterNeed"
                        class="quick-action primary">

                        <span>
                            +
                        </span>

                        <div>

                            <strong>
                                Registrer behov
                            </strong>

                            <small>
                                Ett eller flere behov
                            </small>

                        </div>

                    </a>


                    <a
                        asp-controller="Resource"
                        asp-action="ResourceOverview"
                        class="quick-action secondary">

                        <span>
                            ◆
                        </span>

                        <div>

                            <strong>
                                Se ressurser
                            </strong>

                            <small>
                                Åpne ressursoversikt
                            </small>

                        </div>

                    </a>

                </section>


                <section class="sidebar-legend">

                    <span class="eyebrow">
                        KARTFORKLARING
                    </span>


                    <div class="legend-row">
                        <span class="legend-dot urgent"></span>
                        <span>Akutt behov</span>
                    </div>


                    <div class="legend-row">
                        <span class="legend-dot planned"></span>
                        <span>Planlagt behov</span>
                    </div>


                    <div class="legend-row">
                        <span class="legend-dot resource"></span>
                        <span>Tilgjengelig ressurs</span>
                    </div>


                    <div class="legend-row">
                        <span class="legend-dot actor"></span>
                        <span>Offentlig aktør</span>
                    </div>

                </section>

            </aside>


            <!-- HOVEDOMRÅDE -->

            <main class="public-workspace">

                <div class="workspace-heading">

                    <div>

                        <span class="eyebrow">
                            SITUASJONSOVERSIKT
                        </span>

                        <h2>
                            Kristiansand og omegn
                        </h2>

                        <p>
                            Samlet oversikt over behov,
                            tilgjengelige ressurser og relevante aktører.
                        </p>

                    </div>


                    <span class="demo-badge">
                        DEMO-DATA
                    </span>

                </div>


                <section class="public-status-grid">

                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Akutte behov
                            </span>

                            <span class="status-dot urgent"></span>

                        </div>

                        <strong>
                            @Model.AcuteCount
                        </strong>

                        <small>
                            Krever oppfølging
                        </small>

                    </article>


                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Tilgjengelige ressurser
                            </span>

                            <span class="status-dot resource"></span>

                        </div>

                        <strong class="green-number">
                            @Model.ResourceCount
                        </strong>

                        <small>
                            Registrert i området
                        </small>

                    </article>


                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Planlagte behov
                            </span>

                            <span class="status-dot planned"></span>

                        </div>

                        <strong>
                            @Model.PlannedCount
                        </strong>

                        <small>
                            Kommende oppgaver
                        </small>

                    </article>

                </section>


                <section class="situation-card">

                    <div class="map-toolbar">

                        <div>

                            <span class="eyebrow">
                                VIS I KART
                            </span>

                            <h3>
                                Operativt kart
                            </h3>

                        </div>


                        <div class="map-filters">

                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showResources"
                                    checked />

                                <span class="filter-dot resource"></span>

                                Ressurser

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showUrgent"
                                    checked />

                                <span class="filter-dot urgent"></span>

                                Akutte behov

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showPlanned"
                                    checked />

                                <span class="filter-dot planned"></span>

                                Planlagte behov

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showActors"
                                    checked />

                                <span class="filter-dot actor"></span>

                                Aktører

                            </label>

                        </div>

                    </div>


                    <div id="situationMap"></div>

                </section>


                <section class="public-bottom-grid">

                    <article class="summary-card">

                        <span class="eyebrow">
                            PRIORITERT
                        </span>

                        <h3>
                            Aktive behov
                        </h3>


                        @if (Model.Needs.Any())
                        {
                            @foreach (
                                var need
                                in Model.Needs
                                    .OrderByDescending(
                                        n => n.CreatedAt
                                    )
                                    .Take(2)
                            )
                            {
                                <div class="summary-item">

                                    <span class="summary-icon urgent">
                                        !
                                    </span>

                                    <div>

                                        <strong>
                                            @FirstWebAppInDocker.Services.EnumDisplay.Name(need.ResourceType)
                                        </strong>

                                        <p>
                                            @need.Description
                                        </p>

                                        <small>
                                            Antall: @need.Quantity
                                        </small>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="empty-text">
                                Ingen registrerte behov.
                            </p>
                        }

                         <a
                            asp-controller="Need"
                            asp-action="NeedOverview"
                            class="summary-link">

                            Se alle behov →

                        </a>

                    </article>


                    <article class="summary-card">

                        <span class="eyebrow">
                            RESSURSER
                        </span>

                        <h3>
                            Tilgjengelig kapasitet
                        </h3>


                        @if (Model.Resources.Any())
                        {
                            @foreach (
                                var resourceItem
                                in Model.Resources
                                    .OrderByDescending(
                                        r => r.CreatedAt
                                    )
                                    .Take(2)
                            )
                            {
                                <div class="summary-item">

                                    <span class="summary-icon resource">
                                        R
                                    </span>

                                    <div>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(
                                                resourceItem.ResourceName
                                            )
                                                ? resourceItem.ResourceType.ToString()
                                                : resourceItem.ResourceName)
                                        </strong>

                                        <p>
                                            @resourceItem.Description
                                        </p>

                                        <small>
                                            @(string.IsNullOrWhiteSpace(
                                                resourceItem.Address
                                            )
                                                ? "Plassering registrert i kart"
                                                : resourceItem.Address)
                                        </small>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="empty-text">
                                Ingen registrerte ressurser.
                            </p>
                        }


                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview"
                            class="summary-link">

                            Se alle ressurser →

                        </a>

                    </article>

                </section>

            </main>

        </div>

    </div>
}


else if (userRole == "ResourceProvider")
{
    <!-- =========================================
         RESSURSLEVERANDØR
         ========================================= -->

    <div class="provider-shell">

        <!-- HEADER -->

        <header class="provider-header">

            <a
                asp-controller="Home"
                asp-action="Dashboard"
                class="provider-brand">

                <div class="brand-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path
                            d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7" />

                        <path
                            d="M8.5 12.5L11 15l4.8-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round" />

                    </svg>

                </div>


                <div>

                    <strong>
                        Beredskapsportal
                    </strong>

                    <span>
                        RESSURSLEVERANDØR
                    </span>

                </div>

            </a>


            <!-- SAMME NAVIGASJON SOM PÅ MINE RESSURSER -->

            <nav class="provider-navigation">

                <a
                    asp-controller="Home"
                    asp-action="Dashboard"
                    class="provider-nav-link active">

                    Oversikt

                </a>


                <a
                    asp-controller="Resource"
                    asp-action="ResourceOverview"
                    class="provider-nav-link">

                    Mine ressurser

                </a>


                <a
                    asp-controller="Resource"
                    asp-action="RegisterResource"
                    class="provider-nav-link">

                    Registrer ressurs

                </a>


                <a
                    asp-controller="Request"
                    asp-action="Index"
                    class="provider-nav-link">

                    Forespørsler

                </a>


                <a
                    asp-controller="Request"
                    asp-action="MatchingNeeds"
                    class="provider-nav-link">

                    Behov jeg kan hjelpe med

                </a>


                <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
                @await Component.InvokeAsync("NotificationBell")


                <a
                    asp-controller="Account"
                    asp-action="Profile"
                    class="provider-nav-link">

                    Profil

                </a>


                <form
                    asp-controller="Account"
                    asp-action="Logout"
                    method="post"
                    class="provider-nav-logout">

                    @Html.AntiForgeryToken()

                    <button
                        type="submit"
                        class="provider-nav-link provider-logout-button">

                        Logg ut

                    </button>

                </form>

            </nav>


            <div class="provider-user">

                <div>

                    <strong>
                        @userName
                    </strong>

                    <span>
                        Ressursleverandør
                    </span>

                </div>

            </div>

        </header>


        <!-- MAIN -->

        <main class="provider-main">

            <!-- HERO -->

            <!-- Skjold-symboler: tegnes én gang her og brukes flere steder med <use> -->
            <svg
                width="0"
                height="0"
                style="position: absolute"
                aria-hidden="true"
                focusable="false">

            <symbol id="rank-shield-bronse" viewBox="0 0 64 76">
                <linearGradient id="rim-bronse" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#f6c08a" />
                    <stop offset="0.5" stop-color="#c27a3a" />
                    <stop offset="1" stop-color="#6e3a14" />
                </linearGradient>
                <linearGradient id="face-bronse" x1="0" y1="0" x2="0.8" y2="1">
                    <stop offset="0" stop-color="#d78a43" />
                    <stop offset="1" stop-color="#8a4a1a" />
                </linearGradient>
                <path d="M32 2L58 12V36C58 54 46 68 32 74C18 68 6 54 6 36V12Z" fill="url(#rim-bronse)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="url(#face-bronse)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
                <path d="M22 39L29.5 46.5L43 30" fill="none" stroke="#fff1dd" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M32 2L58 12V30C44 27 22 21 6 31V12Z" fill="#ffffff" fill-opacity="0.2" />
            </symbol>

            <symbol id="rank-shield-solv" viewBox="0 0 64 76">
                <linearGradient id="rim-solv" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#ffffff" />
                    <stop offset="0.5" stop-color="#b7c1ce" />
                    <stop offset="1" stop-color="#6f7a89" />
                </linearGradient>
                <linearGradient id="face-solv" x1="0" y1="0" x2="0.8" y2="1">
                    <stop offset="0" stop-color="#dfe6ef" />
                    <stop offset="1" stop-color="#8793a3" />
                </linearGradient>
                <path d="M32 2L58 12V36C58 54 46 68 32 74C18 68 6 54 6 36V12Z" fill="url(#rim-solv)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="url(#face-solv)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
                <path d="M22 39L29.5 46.5L43 30" fill="none" stroke="#1f2a3a" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M32 2L58 12V30C44 27 22 21 6 31V12Z" fill="#ffffff" fill-opacity="0.2" />
            </symbol>

            <symbol id="rank-shield-gull" viewBox="0 0 64 76">
                <linearGradient id="rim-gull" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#fff3b8" />
                    <stop offset="0.5" stop-color="#e0b53a" />
                    <stop offset="1" stop-color="#9a6a05" />
                </linearGradient>
                <linearGradient id="face-gull" x1="0" y1="0" x2="0.8" y2="1">
                    <stop offset="0" stop-color="#f9dc78" />
                    <stop offset="1" stop-color="#c08a12" />
                </linearGradient>
                <path d="M32 2L58 12V36C58 54 46 68 32 74C18 68 6 54 6 36V12Z" fill="url(#rim-gull)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="url(#face-gull)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
                <path d="M32.0 24.0L35.4 33.3L45.3 33.7L37.5 39.8L40.2 49.3L32.0 43.8L23.8 49.3L26.5 39.8L18.7 33.7L28.6 33.3Z" fill="#5a3b00" />
                <path d="M32 2L58 12V30C44 27 22 21 6 31V12Z" fill="#ffffff" fill-opacity="0.2" />
            </symbol>

            <symbol id="rank-shield-platina" viewBox="0 0 64 76">
                <linearGradient id="rim-platina" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#f1f6ff" />
                    <stop offset="0.5" stop-color="#9fb0c8" />
                    <stop offset="1" stop-color="#4d5c72" />
                </linearGradient>
                <linearGradient id="face-platina" x1="0" y1="0" x2="0.8" y2="1">
                    <stop offset="0" stop-color="#243146" />
                    <stop offset="1" stop-color="#0c121d" />
                </linearGradient>
                <path d="M32 2L58 12V36C58 54 46 68 32 74C18 68 6 54 6 36V12Z" fill="url(#rim-platina)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="url(#face-platina)" />
                <path d="M32 8.5L52 16.5V36C52 50 43 61 32 66.5C21 61 12 50 12 36V16.5Z" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
                <circle cx="32" cy="38" r="19" fill="none" stroke="#9fb0c8" stroke-width="1.4" />
                <path d="M32.0 24.0L35.4 33.3L45.3 33.7L37.5 39.8L40.2 49.3L32.0 43.8L23.8 49.3L26.5 39.8L18.7 33.7L28.6 33.3Z" fill="#e8f1ff" />
                <path d="M32 2L58 12V30C44 27 22 21 6 31V12Z" fill="#ffffff" fill-opacity="0.2" />
            </symbol>

            </svg>


            <section class="provider-hero provider-hero-rank rank-@Model.RankKey">

                <div class="provider-hero-content">

                    <span class="provider-eyebrow">
                        MINE RESSURSER
                    </span>

                    <!-- Skjold med nivåfarge, navn og nivå-merke -->
                    <div class="rank-head">

                        <div
                            class="rank-badge"
                            aria-hidden="true">

                            <svg viewBox="0 0 64 76">

                                <use href="#rank-shield-@Model.RankKey" />

                            </svg>

                        </div>

                        <div class="rank-text">

                            <div class="rank-title-row">

                                <h1>
                                    Hei, @userName
                                </h1>

                                <span class="rank-pill">
                                    @Model.RankName
                                </span>

                            </div>

                            <!-- Poengstolpe: bredden er prosent av veien til neste nivå -->
                            <div class="rank-progress">

                                <div
                                    class="rank-bar"
                                    role="progressbar"
                                    aria-label="Fremdrift mot neste nivå"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    aria-valuenow="@Model.RankProgressPercent">

                                    <div
                                        class="rank-bar-fill"
                                        style="width: @Model.RankProgressPercent%">
                                    </div>

                                </div>

                                <span>
                                    @Model.RankXpText
                                </span>

                            </div>

                        </div>

                    </div>

                    <p>
                        Registrer ressurser du kan stille
                        til disposisjon dersom samfunnet
                        trenger bistand.
                    </p>


                    <a
                        asp-controller="Resource"
                        asp-action="RegisterResource"
                        class="provider-main-action">

                        <span>
                            +
                        </span>

                        Registrer ny ressurs

                    </a>

                </div>


                <!-- Boks med neste nivå -->
                <div class="provider-hero-info">

                    <div class="provider-info-icon">
                        →
                    </div>

                    <div>

                        <strong>
                            @Model.NextRankTitle
                        </strong>

                        <p>
                            @Model.NextRankHint
                        </p>

                        <p>
                            Du ser kun ressurser du selv har registrert.
                        </p>

                    </div>

                </div>

            </section>


            <!-- STATUS -->

            <section class="provider-status-grid">

                <article class="provider-stat">

                    <span>
                        Registrerte ressurser
                    </span>

                    <strong>
                        @Model.ResourceCount
                    </strong>

                    <small>
                        Fra dine registrerte ressurser
                    </small>

                </article>


                <article class="provider-stat">

                    <span>
                        Tilgjengelige nå
                    </span>

                    <strong class="provider-stat-success">
                        @Model.AvailableCount
                    </strong>

                    <small>
                        Fra dine registrerte ressurser
                    </small>

                </article>


                <article class="provider-stat">

                    <span>
                        Ikke tilgjengelig
                    </span>

                    <strong>
                        @Model.UnavailableCount
                    </strong>

                    <small>
                        Fra dine registrerte ressurser
                    </small>

                </article>

            </section>


            <!-- NIVÅER -->

            <details class="rank-levels"><summary>Slik stiger du i nivå</summary>

                <span class="provider-eyebrow">
                    NIVÅER
                </span>

                <h2>
                    Slik stiger du i nivå
                </h2>

                <p>
                    Hver ressurs du registrerer gir 100 poeng.
                    Jo flere ressurser, jo høyere nivå.
                </p>

                <ul class="rank-level-list">

                    @foreach (var level in Model.RankLevels)
                    {
                        <li class="rank-level-row rank-@level.Key @(level.IsCurrent ? "rank-level-current" : "")">

                            <div class="rank-level-icon">

                                <svg
                                    viewBox="0 0 64 76"
                                    aria-hidden="true">

                                    <use href="#rank-shield-@level.Key" />

                                </svg>

                            </div>

                            <div>

                                <div class="rank-level-title">

                                    <strong>
                                        @level.Name – @level.Title
                                    </strong>

                                    <span class="rank-level-pill">
                                        Nivå @level.Number
                                    </span>

                                    @if (level.IsCurrent)
                                    {
                                        <span class="rank-level-here">
                                            Du er her
                                        </span>
                                    }

                                </div>

                                <p>
                                    @level.Description
                                </p>

                            </div>

                        </li>
                    }

                </ul>

            </details>


            <!-- RESSURSER -->

            <section class="provider-resources">

                <div class="provider-section-header">

                    <div>

                        <span class="provider-eyebrow">
                            OVERSIKT
                        </span>

                        <h2>
                            Mine registrerte ressurser
                        </h2>

                        <p>
                            Her vil du kunne administrere
                            ressursene du selv har registrert.
                        </p>

                    </div>


                    <div class="provider-header-actions">
                        <span>@Model.ResourceCount ressurser</span>
                        <a asp-controller="Resource" asp-action="RegisterResource" class="provider-add-button">
                            + Registrer ressurs
                        </a>
                    </div>

                </div>


                @if (Model.UnspecifiedCount > 0)
                {
                    <p class="availability-warning">
                        Tilgjengelighet er ikke avklart for
                        @Model.UnspecifiedCount ressurser.
                    </p>
                }


                <div class="provider-resource-list">

                    @if (!Model.Resources.Any())
                    {
                        <div class="provider-empty">

                            <strong>
                                Ingen registrerte ressurser
                            </strong>

                            <p>
                                Du har ingen registrerte ressurser ennå.
                            </p>

                            <a
                                asp-controller="Resource"
                                asp-action="RegisterResource">

                                Registrer din første ressurs

                            </a>

                        </div>
                    }


                    @foreach (var resourceItem in Model.Resources)
                    {
                        var typeName =
                            Html.GetEnumSelectList<ResourceType>()
                                .FirstOrDefault(
                                    item =>
                                        item.Value
                                        ==
                                        ((int)resourceItem.ResourceType)
                                            .ToString()
                                )?.Text
                            ??
                            resourceItem.ResourceType.ToString();

                        var status =
                            string.IsNullOrWhiteSpace(
                                resourceItem.Availability
                            )
                                ? "Ikke oppgitt"
                                : resourceItem.Availability;

                        bool available =
                            string.Equals(
                                status,
                                "Tilgjengelig",
                                StringComparison.OrdinalIgnoreCase
                            );


                        <article class="provider-resource-card">

                            <div class="provider-resource-icon">
                                R
                            </div>


                            <div class="provider-resource-content">

                                <div class="provider-resource-heading">

                                    <div>

                                        <span class="provider-resource-type">
                                            @typeName
                                        </span>

                                        <h3>
                                            @(string.IsNullOrWhiteSpace(
                                                resourceItem.ResourceName
                                            )
                                                ? resourceItem.Description
                                                : resourceItem.ResourceName)
                                        </h3>

                                    </div>


                                    <span
                                        class="
                                            provider-resource-status
                                            @(available
                                                ? "available"
                                                : "unavailable")
                                        ">

                                        @status

                                    </span>

                                </div>


                                <p>
                                    @resourceItem.Description
                                </p>


                                <div class="provider-resource-meta">

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            resourceItem.Address
                                        )
                                    )
                                    {
                                        <span>
                                            @resourceItem.Address
                                        </span>
                                    }


                                    <span>
                                        Antall: @resourceItem.Quantity
                                    </span>


                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            resourceItem.Capacity
                                        )
                                    )
                                    {
                                        <span>
                                            @resourceItem.Capacity
                                        </span>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <a
                    asp-controller="Resource"
                    asp-action="ResourceOverview"
                    class="provider-overview-link">

                    Se hele ressursoversikten →

                </a>

            </section>


            <!-- HJELP -->

            <section class="provider-help">

                <div class="provider-help-item">

                    <span>
                        01
                    </span>

                    <div>

                        <strong>
                            Registrer ressurs
                        </strong>

                        <p>
                            Oppgi type, beskrivelse,
                            kontaktinformasjon og plassering.
                        </p>

                    </div>

                </div>


                <div class="provider-help-item">

                    <span>
                        02
                    </span>

                    <div>

                        <strong>
                            Hold informasjonen oppdatert
                        </strong>

                        <p>
                            Sørg for at ressursinformasjonen
                            er riktig.
                        </p>

                    </div>

                </div>


                <div class="provider-help-item">

                    <span>
                        03
                    </span>

                    <div>

                        <strong>
                            Offentlige aktører får oversikt
                        </strong>

                        <p>
                            Ressursen kan inngå i
                            situasjonsbildet ved behov.
                        </p>

                    </div>

                </div>

            </section>

        </main>

    </div>
}


else
{
    <main class="unknown-role">

        <h1>
            Ingen gyldig rolle
        </h1>

        <p>
            Brukeren mangler tilgang til dashboardet.
        </p>

        <form
            asp-controller="Account"
            asp-action="Logout"
            method="post">

            @Html.AntiForgeryToken()

            <button type="submit">
                Logg ut
            </button>

        </form>

    </main>
}



