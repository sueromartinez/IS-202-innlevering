@{
    Layout = null;

    ViewData["Title"] = "Oversikt";

    string userName =
        ViewBag.UserName ?? "Bruker";

    string userRole =
        ViewBag.UserRole ?? "";
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        @ViewData["Title"] - Beredskapsportal
    </title>


    @if (userRole == "PublicActor")
    {
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        />
    }

</head>

<body>


@if (userRole == "PublicActor")
{
    <!-- =========================================
         OFFENTLIG AKTØR
    ========================================== -->

    <div class="public-shell">


        <!-- =====================================
             HEADER
        ====================================== -->

        <header class="public-header">

            <a
                asp-controller="Home"
                asp-action="Dashboard"
                class="public-brand">

                <div class="brand-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path
                            d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                        />

                        <path
                            d="M8.5 12.5L11 15l4.8-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                    </svg>

                </div>


                <div>

                    <strong>
                        Beredskapsportal
                    </strong>

                    <span>
                        TOTALFORSVARET
                    </span>

                </div>

            </a>


            <div class="public-header-status">

                <span class="active-dot"></span>

                Situasjonsbilde aktivt

            </div>


            <div class="public-user">

                <div>

                    <strong>
                        @userName
                    </strong>

                    <span>
                        Offentlig aktør
                    </span>

                </div>


                <form
                    asp-controller="Account"
                    asp-action="Logout"
                    method="post">

                    <button
                        type="submit"
                        class="logout-button">

                        Logg ut

                    </button>

                </form>

            </div>

        </header>


        <!-- =====================================
             INNHOLD
        ====================================== -->

        <div class="public-layout">


            <!-- =================================
                 SIDEBAR
            ================================== -->

            <aside class="public-sidebar">


                <div class="sidebar-intro">

                    <span class="eyebrow">
                        OPERATIV OVERSIKT
                    </span>

                    <h1>
                        Situasjonsbilde
                    </h1>

                    <p>
                        Behov, ressurser og hendelser samlet
                        i ett geografisk bilde.
                    </p>

                </div>


                <!-- NAVIGASJON -->

                <nav class="public-navigation">

                    <a
                        href="#situationMap"
                        class="public-navigation-item active">

                        <span class="navigation-icon">
                            ◎
                        </span>

                        <span>

                            <strong>
                                Kartoversikt
                            </strong>

                            <small>
                                Aktiv visning
                            </small>

                        </span>

                    </a>


                    <button
                        type="button"
                        class="public-navigation-item disabled"
                        disabled>

                        <span class="navigation-icon">
                            !
                        </span>

                        <span>

                            <strong>
                                Behov
                            </strong>

                            <small>
                                Kommer snart
                            </small>

                        </span>

                    </button>


                    <a
                        asp-controller="Resource"
                        asp-action="ResourceOverview"
                        class="public-navigation-item">

                        <span class="navigation-icon">
                            ◆
                        </span>

                        <span>

                            <strong>
                                Ressurser
                            </strong>

                            <small>
                                Se registrerte ressurser
                            </small>

                        </span>

                    </a>

                </nav>


                <!-- HURTIGHANDLINGER -->

                <section class="quick-actions">

                    <span class="eyebrow">
                        HURTIGHANDLINGER
                    </span>


                    <button
                        type="button"
                        class="quick-action primary disabled-action"
                        disabled>

                        <span>
                            +
                        </span>

                        <div>

                            <strong>
                                Registrer behov
                            </strong>

                            <small>
                                Kommer snart
                            </small>

                        </div>

                    </button>


                    <a
                        asp-controller="Resource"
                        asp-action="ResourceOverview"
                        class="quick-action secondary">

                        <span>
                            ◆
                        </span>

                        <div>

                            <strong>
                                Se ressurser
                            </strong>

                            <small>
                                Åpne ressursoversikt
                            </small>

                        </div>

                    </a>

                </section>


                <!-- KARTFORKLARING -->

                <section class="sidebar-legend">

                    <span class="eyebrow">
                        KARTFORKLARING
                    </span>


                    <div class="legend-row">

                        <span class="legend-dot urgent"></span>

                        <span>
                            Akutt behov
                        </span>

                    </div>


                    <div class="legend-row">

                        <span class="legend-dot planned"></span>

                        <span>
                            Planlagt behov
                        </span>

                    </div>


                    <div class="legend-row">

                        <span class="legend-dot resource"></span>

                        <span>
                            Tilgjengelig ressurs
                        </span>

                    </div>


                    <div class="legend-row">

                        <span class="legend-dot actor"></span>

                        <span>
                            Offentlig aktør
                        </span>

                    </div>

                </section>

            </aside>


            <!-- =================================
                 HOVEDOMRÅDE
            ================================== -->

            <main class="public-workspace">


                <!-- TOPP -->

                <div class="workspace-heading">

                    <div>

                        <span class="eyebrow">
                            SITUASJONSOVERSIKT
                        </span>

                        <h2>
                            Kristiansand og omegn
                        </h2>

                        <p>
                            Samlet oversikt over behov,
                            tilgjengelige ressurser og relevante aktører.
                        </p>

                    </div>


                    <span class="demo-badge">
                        DEMO-DATA
                    </span>

                </div>


                <!-- STATUS -->

                <section class="public-status-grid">


                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Akutte behov
                            </span>

                            <span class="status-dot urgent"></span>

                        </div>

                        <strong>
                            2
                        </strong>

                        <small>
                            Krever oppfølging
                        </small>

                    </article>


                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Tilgjengelige ressurser
                            </span>

                            <span class="status-dot resource"></span>

                        </div>

                        <strong class="green-number">
                            7
                        </strong>

                        <small>
                            Registrert i området
                        </small>

                    </article>


                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Planlagte behov
                            </span>

                            <span class="status-dot planned"></span>

                        </div>

                        <strong>
                            2
                        </strong>

                        <small>
                            Kommende oppgaver
                        </small>

                    </article>

                </section>


                <!-- =================================
                     KART
                ================================== -->

                <section class="situation-card">


                    <div class="map-toolbar">

                        <div>

                            <span class="eyebrow">
                                VIS I KART
                            </span>

                            <h3>
                                Operativt kart
                            </h3>

                        </div>


                        <div class="map-filters">


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showResources"
                                    checked
                                />

                                <span class="filter-dot resource"></span>

                                Ressurser

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showUrgent"
                                    checked
                                />

                                <span class="filter-dot urgent"></span>

                                Akutte behov

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showPlanned"
                                    checked
                                />

                                <span class="filter-dot planned"></span>

                                Planlagte behov

                            </label>


                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showActors"
                                    checked
                                />

                                <span class="filter-dot actor"></span>

                                Aktører

                            </label>

                        </div>

                    </div>


                    <div id="situationMap"></div>

                </section>


                <!-- =================================
                     HURTIGOVERSIKT
                ================================== -->

                <section class="public-bottom-grid">


                    <article class="summary-card">

                        <span class="eyebrow">
                            PRIORITERT
                        </span>

                        <h3>
                            Aktive behov
                        </h3>


                        <div class="summary-item">

                            <span class="summary-icon urgent">
                                !
                            </span>

                            <div>

                                <strong>
                                    Strømbehov
                                </strong>

                                <p>
                                    Aggregat nødvendig ved
                                    midlertidig mottakssenter.
                                </p>

                                <small>
                                    Kristiansand · Akutt
                                </small>

                            </div>

                        </div>


                        <div class="summary-item">

                            <span class="summary-icon planned">
                                !
                            </span>

                            <div>

                                <strong>
                                    Transportkapasitet
                                </strong>

                                <p>
                                    Behov for kjøretøy til
                                    planlagt transport.
                                </p>

                                <small>
                                    Vennesla · Planlagt
                                </small>

                            </div>

                        </div>

                    </article>


                    <article class="summary-card">

                        <span class="eyebrow">
                            RESSURSER
                        </span>

                        <h3>
                            Tilgjengelig kapasitet
                        </h3>


                        <div class="summary-item">

                            <span class="summary-icon resource">
                                A
                            </span>

                            <div>

                                <strong>
                                    Aggregat 25 kVA
                                </strong>

                                <p>
                                    Midlertidig strømforsyning.
                                </p>

                                <small>
                                    Kristiansand · Tilgjengelig
                                </small>

                            </div>

                        </div>


                        <div class="summary-item">

                            <span class="summary-icon resource">
                                T
                            </span>

                            <div>

                                <strong>
                                    Transport
                                </strong>

                                <p>
                                    Kjøretøy tilgjengelig for
                                    transportoppdrag.
                                </p>

                                <small>
                                    Kristiansand · Tilgjengelig
                                </small>

                            </div>

                        </div>


                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview"
                            class="summary-link">

                            Se alle ressurser →

                        </a>

                    </article>

                </section>

            </main>

        </div>

    </div>
}


else if (userRole == "ResourceProvider")
{
    <!-- =========================================
         RESSURSLEVERANDØR
    ========================================== -->

    <div class="provider-shell">


        <!-- HEADER -->

        <header class="provider-header">

            <div class="provider-brand">

                <div class="brand-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path
                            d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                        />

                        <path
                            d="M8.5 12.5L11 15l4.8-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                    </svg>

                </div>


                <div>

                    <strong>
                        Beredskapsportal
                    </strong>

                    <span>
                        RESSURSLEVERANDØR
                    </span>

                </div>

            </div>


            <div class="provider-user">

                <div>

                    <strong>
                        @userName
                    </strong>

                    <span>
                        Ressursleverandør
                    </span>

                </div>


                <form
                    asp-controller="Account"
                    asp-action="Logout"
                    method="post">

                    <button
                        type="submit"
                        class="logout-button">

                        Logg ut

                    </button>

                </form>

            </div>

        </header>


        <!-- MAIN -->

        <main class="provider-main">


            <!-- HERO -->

            <section class="provider-hero">

                <div class="provider-hero-content">

                    <span class="provider-eyebrow">
                        MINE RESSURSER
                    </span>

                    <h1>
                        Hei, @userName
                    </h1>

                    <p>
                        Registrer ressurser du kan stille
                        til disposisjon dersom samfunnet
                        trenger bistand.
                    </p>


                    <a
                        asp-controller="Resource"
                        asp-action="RegisterResource"
                        class="provider-main-action">

                        <span>
                            +
                        </span>

                        Registrer ny ressurs

                    </a>

                </div>


                <div class="provider-hero-info">

                    <div class="provider-info-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            Dine ressurser
                        </strong>

                        <p>
                            Du vil kun få tilgang til ressurser
                            du selv har registrert.
                        </p>

                    </div>

                </div>

            </section>


            <!-- STATUS -->

            <section class="provider-status-grid">


                <article class="provider-stat">

                    <span>
                        Registrerte ressurser
                    </span>

                    <strong>
                        2
                    </strong>

                    <small>
                        Demo-data
                    </small>

                </article>


                <article class="provider-stat">

                    <span>
                        Tilgjengelige nå
                    </span>

                    <strong class="provider-stat-success">
                        1
                    </strong>

                    <small>
                        Demo-data
                    </small>

                </article>


                <article class="provider-stat">

                    <span>
                        Ikke tilgjengelig
                    </span>

                    <strong>
                        1
                    </strong>

                    <small>
                        Demo-data
                    </small>

                </article>

            </section>


            <!-- RESSURSER -->

            <section class="provider-resources">

                <div class="provider-section-header">

                    <div>

                        <span class="provider-eyebrow">
                            OVERSIKT
                        </span>

                        <h2>
                            Mine registrerte ressurser
                        </h2>

                        <p>
                            Her vil du kunne administrere
                            ressursene du selv har registrert.
                        </p>

                    </div>


                    <span class="demo-badge">
                        DEMO-DATA
                    </span>

                </div>


                <div class="provider-resource-list">


                    <article class="provider-resource-card">

                        <div class="provider-resource-icon">
                            A
                        </div>


                        <div class="provider-resource-content">

                            <div class="provider-resource-heading">

                                <div>

                                    <span class="provider-resource-type">
                                        STRØM / AGGREGAT
                                    </span>

                                    <h3>
                                        Aggregat 25 kVA
                                    </h3>

                                </div>


                                <span class="provider-resource-status available">
                                    Tilgjengelig
                                </span>

                            </div>


                            <p>
                                Dieseldrevet aggregat egnet
                                for midlertidig strømforsyning.
                            </p>


                            <div class="provider-resource-meta">

                                <span>
                                    Kristiansand
                                </span>

                                <span>
                                    ● Tilgjengelig nå
                                </span>

                            </div>

                        </div>

                    </article>


                    <article class="provider-resource-card">

                        <div class="provider-resource-icon">
                            M
                        </div>


                        <div class="provider-resource-content">

                            <div class="provider-resource-heading">

                                <div>

                                    <span class="provider-resource-type">
                                        MASKINER
                                    </span>

                                    <h3>
                                        Traktor med frontlaster
                                    </h3>

                                </div>


                                <span class="provider-resource-status unavailable">
                                    Ikke tilgjengelig
                                </span>

                            </div>


                            <p>
                                Traktor med frontlaster som kan
                                brukes til transport og rydding.
                            </p>


                            <div class="provider-resource-meta">

                                <span>
                                    Vennesla
                                </span>

                                <span>
                                    ○ Ikke tilgjengelig
                                </span>

                            </div>

                        </div>

                    </article>

                </div>


                <a
                    asp-controller="Resource"
                    asp-action="ResourceOverview"
                    class="provider-overview-link">

                    Se hele ressursoversikten →

                </a>

            </section>


            <!-- HJELP -->

            <section class="provider-help">

                <div class="provider-help-item">

                    <span>
                        01
                    </span>

                    <div>

                        <strong>
                            Registrer ressurs
                        </strong>

                        <p>
                            Oppgi type, beskrivelse,
                            kontaktinformasjon og plassering.
                        </p>

                    </div>

                </div>


                <div class="provider-help-item">

                    <span>
                        02
                    </span>

                    <div>

                        <strong>
                            Hold informasjonen oppdatert
                        </strong>

                        <p>
                            Sørg for at ressursinformasjonen
                            er riktig.
                        </p>

                    </div>

                </div>


                <div class="provider-help-item">

                    <span>
                        03
                    </span>

                    <div>

                        <strong>
                            Offentlige aktører får oversikt
                        </strong>

                        <p>
                            Ressursen kan inngå i
                            situasjonsbildet ved behov.
                        </p>

                    </div>

                </div>

            </section>

        </main>

    </div>
}


else
{
    <main class="unknown-role">

        <h1>
            Ingen gyldig rolle
        </h1>

        <p>
            Brukeren mangler tilgang til dashboardet.
        </p>

        <form
            asp-controller="Account"
            asp-action="Logout"
            method="post">

            <button type="submit">
                Logg ut
            </button>

        </form>

    </main>
}


<style>

    /* =========================================
       FELLES
    ========================================= */

    :root {
        --navy: #102d43;
        --navy-dark: #0a2234;

        --primary: #176b87;
        --primary-dark: #125770;

        --green: #23855b;
        --red: #d34b4b;
        --yellow: #d99a24;

        --background: #f4f6f8;
        --surface: #ffffff;

        --text: #17212b;
        --secondary: #667085;

        --border: #dfe4e8;
    }


    * {
        box-sizing: border-box;
    }


    html,
    body {
        margin: 0;

        min-height: 100%;

        color: var(--text);

        background: var(--background);

        font-family:
            Inter,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }


    body {
        min-height: 100vh;

        overflow-x: hidden;
    }


    a {
        color: inherit;

        text-decoration: none;
    }


    button {
        font: inherit;
    }


    .brand-icon {
        width: 41px;
        height: 41px;

        display: grid;
        place-items: center;

        flex-shrink: 0;

        border-radius: 11px;

        color: var(--primary);

        background:
            rgba(23, 107, 135, 0.08);
    }


    .brand-icon svg {
        width: 23px;
        height: 23px;
    }


    .logout-button {
        padding:
            9px 14px;

        border:
            1px solid var(--border);

        border-radius: 8px;

        color: #344054;

        background: white;

        font-size: 0.74rem;
        font-weight: 750;

        cursor: pointer;
    }


    .logout-button:hover {
        background: #f7f8f9;
    }


    .eyebrow,
    .provider-eyebrow {
        display: block;

        color: var(--primary);

        font-size: 0.61rem;
        font-weight: 850;

        letter-spacing: 0.11em;

        text-transform: uppercase;
    }


    .demo-badge {
        display: inline-flex;
        align-items: center;

        width: max-content;

        padding:
            7px 10px;

        border-radius: 7px;

        color: #966817;

        background: #fff4d6;

        font-size: 0.58rem;
        font-weight: 850;

        letter-spacing: 0.07em;
    }


    /* =========================================
       OFFENTLIG HEADER
    ========================================= */

    .public-header {
        height: 72px;

        display: grid;

        grid-template-columns:
            1fr auto 1fr;

        align-items: center;

        gap: 24px;

        padding:
            0 32px;

        border-bottom:
            1px solid var(--border);

        background: white;
    }


    .public-brand {
        display: flex;
        align-items: center;

        gap: 12px;

        justify-self: start;
    }


    .public-brand strong {
        display: block;

        color: var(--navy);

        font-size: 0.93rem;
    }


    .public-brand span {
        display: block;

        margin-top: 2px;

        color: #7b8794;

        font-size: 0.57rem;
        font-weight: 800;

        letter-spacing: 0.13em;
    }


    .public-header-status {
        display: flex;
        align-items: center;

        gap: 8px;

        color: #52606c;

        font-size: 0.67rem;
        font-weight: 700;
    }


    .active-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: var(--green);

        box-shadow:
            0 0 0 4px
            rgba(35, 133, 91, 0.1);
    }


    .public-user {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        gap: 17px;

        justify-self: end;
    }


    .public-user > div {
        text-align: right;
    }


    .public-user strong {
        display: block;

        font-size: 0.76rem;
    }


    .public-user span {
        display: block;

        margin-top: 2px;

        color: var(--secondary);

        font-size: 0.64rem;
    }


    .public-user form {
        margin: 0;
    }


    /* =========================================
       PUBLIC LAYOUT
    ========================================= */

    .public-layout {
        min-height:
            calc(100vh - 72px);

        display: grid;

        grid-template-columns:
            310px minmax(0, 1fr);
    }


    /* =========================================
       SIDEBAR
    ========================================= */

    .public-sidebar {
        padding:
            30px 24px;

        border-right:
            1px solid var(--border);

        background: white;
    }


    .sidebar-intro {
        padding:
            0 4px 25px;
    }


    .sidebar-intro h1 {
        margin:
            8px 0 8px;

        color: var(--navy);

        font-size: 1.65rem;

        letter-spacing: -0.04em;
    }


    .sidebar-intro p {
        margin: 0;

        color: var(--secondary);

        font-size: 0.69rem;

        line-height: 1.55;
    }


    /* NAV */

    .public-navigation {
        display: flex;
        flex-direction: column;

        gap: 6px;

        margin-bottom: 30px;
    }


    .public-navigation-item {
        width: 100%;

        display: grid;

        grid-template-columns:
            37px minmax(0, 1fr);

        gap: 11px;

        align-items: center;

        padding:
            11px;

        border: 0;

        border-radius: 10px;

        color: #52606c;

        background: transparent;

        text-align: left;
    }


    .public-navigation-item.active {
        color: var(--primary);

        background:
            rgba(23, 107, 135, 0.08);
    }


    .public-navigation-item:not(.disabled):hover {
        background: #f5f7f8;
    }


