</style>



@if (isOfficial)
{
    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script src="~/js/kartverket.js" asp-append-version="true"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const map =
                    L.map(
                        "situationMap"
                    )
                    .setView(
                        [
                            58.1467,
                            7.9956
                        ],
                        11
                    );


                addKartverketLayers(
                    map
                );


                const resourceLayer =
                    L.layerGroup()
                        .addTo(map);


                const urgentLayer =
                    L.layerGroup()
                        .addTo(map);


                const plannedLayer =
                    L.layerGroup()
                        .addTo(map);


                const actorLayer =
                    L.layerGroup()
                        .addTo(map);


                                // Kartsymboler: symbolFor() gir SVG-ikonet som passer til typen behov eller ressurs,
                // og createMarker() tegner kartpinnen med ikonet.
                function symbolFor(type) {
                    const icons = {
                        Transport: "<path d='M1 3h15v13H1z'/><path d='M16 8h4l3 3v5h-7z'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/>",
                        Drone: "<circle cx='12' cy='12' r='3'/><circle cx='5' cy='5' r='2.5'/><circle cx='19' cy='5' r='2.5'/><circle cx='5' cy='19' r='2.5'/><circle cx='19' cy='19' r='2.5'/><path d='M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3'/>",
                        Generator: "<polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/>",
                        Machinery: "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",
                        CommunicationEquipment: "<circle cx='12' cy='12' r='2'/><path d='M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14'/>",
                        Personnel: "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'/>",
                        Premises: "<path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/>",
                        SandAndGravel: "<polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/>",
                        Boat: "<circle cx='12' cy='5' r='3'/><line x1='12' y1='22' x2='12' y2='8'/><path d='M5 12H2a10 10 0 0 0 20 0h-3'/>",
                        Other: "<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>"
                    };
                    return icons[type] || icons.Other;
                }

                function createMarker(color, type) {
                    const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='" + color + "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>" + symbolFor(type) + "</svg>";
                    return L.divIcon({
                        className: "custom-map-marker",
                        html: "<div style='position:relative;width:50px;height:62px;'><div style='position:absolute;left:0;top:0;width:50px;height:50px;box-sizing:border-box;border:3px solid white;border-radius:50% 50% 50% 8px;transform:rotate(-45deg);background:" + color + ";box-shadow:0 5px 14px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;'><div style='transform:rotate(45deg);width:36px;height:36px;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;'>" + svg + "</div></div></div>",
                        iconSize: [50, 62],
                        iconAnchor: [25, 60],
                        popupAnchor: [0, -54]
                    });
                }


                const needs =
                    @Json.Serialize(
                        Model.Needs.Select(
                            n => new
                            {
                                description =
                                    n.Description,

                                type =
                                    n.ResourceType.ToString(),

                                quantity =
                                    n.Quantity,

                                acute =
                                    n.Priority == NeedPriority.Acute,

                                lat =
                                    n.Latitude,

                                lng =
                                    n.Longitude
                            }
                        )
                    );


                const resources =
                    @Json.Serialize(
                        Model.Resources.Select(
                            r => new
                            {
                                name =
                                    r.ResourceName,

                                type =
                                    r.ResourceType.ToString(),

                                description =
                                    r.Description,

                                lat =
                                    r.Latitude,

                                lng =
                                    r.Longitude
                            }
                        )
                    );


                function escapeHtml(
                    text
                ) {

                    const div =
                        document.createElement(
                            "div"
                        );

                    div.textContent =
                        text ?? "";

                    return div.innerHTML;

                }


                needs.forEach(
                    function (need) {

                        const layer =
                            need.acute
                                ? urgentLayer
                                : plannedLayer;


                        const color =
                            need.acute
                                ? "#d34b4b"
                                : "#d99a24";


                        L.marker(
                            [
                                need.lat,
                                need.lng
                            ],
                            {
                                icon:
                                    createMarker(color, need.type)
                            }
                        )
                        .bindPopup(
                            "<strong>"
                            +
                            escapeHtml(
                                need.type
                            )
                            +
                            " ("
                            +
                            need.quantity
                            +
                            ")</strong><br>"
                            +
                            escapeHtml(
                                need.description
                            )
                            +
                            "<br>"
                            +
                            (
                                need.acute
                                    ? "Prioritet: Akutt"
                                    : "Prioritet: Planlagt"
                            )
                        )
                        .addTo(
                            layer
                        );

                    }
                );


                resources.forEach(
                    function (resource) {

                        const title =
                            resource.name
                            ||
                            resource.type;


                        L.marker(
                            [
                                resource.lat,
                                resource.lng
                            ],
                            {
                                icon:
                                    createMarker("#23855b", resource.type)
                            }
                        )
                        .bindPopup(
                            "<strong>"
                            +
                            escapeHtml(
                                title
                            )
                            +
                            "</strong><br>"
                            +
                            escapeHtml(
                                resource.description
                            )
                            +
                            "<br>Registrert ressurs"
                        )
                        .addTo(
                            resourceLayer
                        );

                    }
                );


                setupToggle(
                    "showResources",
                    resourceLayer
                );


                setupToggle(
                    "showUrgent",
                    urgentLayer
                );


                setupToggle(
                    "showPlanned",
                    plannedLayer
                );


                setupToggle(
                    "showActors",
                    actorLayer
                );


                function setupToggle(
                    checkboxId,
                    layer
                ) {

                    const checkbox =
                        document.getElementById(
                            checkboxId
                        );


                    if (!checkbox)
                    {
                        return;
                    }


                    checkbox.addEventListener(
                        "change",
                        function () {

                            if (
                                checkbox.checked
                            )
                            {
                                if (
                                    !map.hasLayer(
                                        layer
                                    )
                                )
                                {
                                    layer.addTo(
                                        map
                                    );
                                }
                            }
                            else
                            {
                                if (
                                    map.hasLayer(
                                        layer
                                    )
                                )
                                {
                                    map.removeLayer(
                                        layer
                                    );
                                }
                            }

                        }
                    );

                }


                window.setTimeout(
                    function () {

                        map.invalidateSize();

                    },
                    100
                );

            }
        );

    </script>
}


