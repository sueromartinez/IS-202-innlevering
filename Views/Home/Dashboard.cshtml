
@* Importerer Data Annotations, som kan brukes til validering av data. *@
@using System.ComponentModel.DataAnnotations

@{
    // Angir at denne visningen ikke skal bruke en felles layoutfil.
    Layout = null;

    // Setter sidens tittel.
    ViewData["Title"] = "Oversikt";

    // Henter brukernavnet fra ViewBag.
    // Hvis det ikke finnes, brukes "Bruker" som standardverdi.
    string userName =
        ViewBag.UserName ?? "Bruker";

    // Henter brukerens rolle.
    // Hvis rollen ikke finnes, brukes en tom tekst.
    string userRole =
        ViewBag.UserRole ?? "";
}

<!DOCTYPE html>

<html lang="no">

<head>

    @* Angir tegnsett og tilpasser visningen til skjermstørrelsen. *@
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    @* Setter sidetittelen som vises i nettleseren. *@
    <title>
        @ViewData["Title"] - Beredskapsportal
    </title>

    @* Leaflet CSS lastes bare inn for offentlige aktører,
       fordi det er denne rollen som har kartvisningen. *@
    @if (userRole == "PublicActor")
    {
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        />
    }

</head>

<body>

@* =================================================
   DASHBOARD FOR OFFENTLIG AKTØR
   Denne delen vises bare dersom brukeren har rollen PublicActor.
================================================= *@

@if (userRole == "PublicActor")
{
    <!-- =========================================
         OFFENTLIG AKTØR
    ========================================== -->

    <div class="public-shell">

        @* HEADER: Viser portalens navn, status,
           innlogget bruker og utloggingsknapp. *@
        <header class="public-header">

            @* Lenke til dashboardet via HomeController. *@
            <a
                asp-controller="Home"
                asp-action="Dashboard"
                class="public-brand">

                @* Logo laget med SVG. *@
                <div class="brand-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path
                            d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                        />

                        <path
                            d="M8.5 12.5L11 15l4.8-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                    </svg>

                </div>

                @* Viser portalens navn og undertittel. *@
                <div>

                    <strong>
                        Beredskapsportal
                    </strong>

                    <span>
                        TOTALFORSVARET
                    </span>

                </div>

            </a>

            @* Viser at situasjonsbildet er aktivt. *@
            <div class="public-header-status">

                <span class="active-dot"></span>

                Situasjonsbilde aktivt

            </div>

            @* Viser innlogget bruker og brukerens rolle. *@
            <div class="public-user">

                <div>

                    <strong>
                        @userName
                    </strong>

                    <span>
                        Offentlig aktør
                    </span>

                </div>

                @* Skjema som sender en POST-forespørsel
                   til Logout-handlingen i AccountController. *@
                <form
                    asp-controller="Account"
                    asp-action="Logout"
                    method="post">

                    <button
                        type="submit"
                        class="logout-button">

                        Logg ut

                    </button>

                </form>

            </div>

        </header>

        @* Hovedoppsettet består av en sidemeny
           og et større arbeidsområde. *@
        <div class="public-layout">

            @* SIDEBAR: Navigasjon, hurtighandlinger
               og forklaring av symbolene i kartet. *@
            <aside class="public-sidebar">

                <div class="sidebar-intro">

                    <span class="eyebrow">
                        OPERATIV OVERSIKT
                    </span>

                    <h1>
                        Situasjonsbilde
                    </h1>

                    <p>
                        Behov, ressurser og hendelser samlet
                        i ett geografisk bilde.
                    </p>

                </div>

                @* Navigasjon mellom kartoversikten,
                   behov og ressursoversikten. *@
                <nav class="public-navigation">

                    <a
                        href="#situationMap"
                        class="public-navigation-item active">

                        <span class="navigation-icon">
                            ◎
                        </span>

                        <span>

                            <strong>
                                Kartoversikt
                            </strong>

                            <small>
                                Aktiv visning
                            </small>

                        </span>

                    </a>

<a
    asp-controller="Need"
    asp-action="RegisterNeed"
    class="quick-action primary">

                        <span>
                            +
                        </span>

                        <div>

                            <strong>
                                Registrer behov
                            </strong>

                            <small>
                                Ett eller flere behov
                            </small>

                        </div>

                    </a>

                    @* Lenke til ressursoversikten. *@
                    <a
                        asp-controller="Resource"
                        asp-action="ResourceOverview"
                        class="quick-action secondary">

                        <span>
                            ◆
                        </span>

                        <div>

                            <strong>
                                Se ressurser
                            </strong>

                            <small>
                                Åpne ressursoversikt
                            </small>

                        </div>

                    </a>

                </nav>

                @* Forklarer hva de ulike fargene
                   og symbolene på kartet representerer. *@
                <section class="sidebar-legend">

                    <span class="eyebrow">
                        KARTFORKLARING
                    </span>

                    <div class="legend-row">

                        <span class="legend-dot urgent"></span>

                        <span>
                            Akutt behov
                        </span>

                    </div>

                    <div class="legend-row">

                        <span class="legend-dot planned"></span>

                        <span>
                            Planlagt behov
                        </span>

                    </div>

                    <div class="legend-row">

                        <span class="legend-dot resource"></span>

                        <span>
                            Tilgjengelig ressurs
                        </span>

                    </div>

                    <div class="legend-row">

                        <span class="legend-dot actor"></span>

                        <span>
                            Offentlig aktør
                        </span>

                    </div>

                </section>

            </aside>

            @* HOVEDOMRÅDE: Viser status, kart
               og oppsummeringer for den offentlige aktøren. *@
            <main class="public-workspace">

                @* Overskrift og beskrivelse av kartområdet. *@
                <div class="workspace-heading">

                    <div>

                        <span class="eyebrow">
                            SITUASJONSOVERSIKT
                        </span>

                        <h2>
                            Kristiansand og omegn
                        </h2>

                        <p>
                            Samlet oversikt over behov,
                            tilgjengelige ressurser og relevante aktører.
                        </p>

                    </div>

                    @* Marker at innholdet foreløpig er eksempeldata. *@
                    <span class="demo-badge">
                        DEMO-DATA
                    </span>

                </div>

                @* STATUSKORT: Viser antall akutte behov,
                   tilgjengelige ressurser og planlagte behov. *@
                <section class="public-status-grid">

                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Akutte behov
                            </span>

                            <span class="status-dot urgent"></span>

                        </div>

                        <strong>
                            2
                        </strong>

                        <small>
                            Krever oppfølging
                        </small>

                    </article>

                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Tilgjengelige ressurser
                            </span>

                            <span class="status-dot resource"></span>

                        </div>

                        <strong class="green-number">
                            7
                        </strong>

                        <small>
                            Registrert i området
                        </small>

                    </article>

                    <article class="public-stat">

                        <div class="public-stat-heading">

                            <span>
                                Planlagte behov
                            </span>

                            <span class="status-dot planned"></span>

                        </div>

                        <strong>
                            2
                        </strong>

                        <small>
                            Kommende oppgaver
                        </small>

                    </article>

                </section>

                @* KART: Inneholder kartverktøy, filtervalg
                   og selve kartområdet som Leaflet bruker. *@
                <section class="situation-card">

                    <div class="map-toolbar">

                        <div>

                            <span class="eyebrow">
                                VIS I KART
                            </span>

                            <h3>
                                Operativt kart
                            </h3>

                        </div>

                        @* Hvert avkrysningsfelt styrer
                           synligheten til en kartkategori. *@
                        <div class="map-filters">

                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showResources"
                                    checked
                                />

                                <span class="filter-dot resource"></span>

                                Ressurser

                            </label>

                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showUrgent"
                                    checked
                                />

                                <span class="filter-dot urgent"></span>

                                Akutte behov

                            </label>

                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showPlanned"
                                    checked
                                />

                                <span class="filter-dot planned"></span>

                                Planlagte behov

                            </label>

                            <label class="filter-option">

                                <input
                                    type="checkbox"
                                    id="showActors"
                                    checked
                                />

                                <span class="filter-dot actor"></span>

                                Aktører

                            </label>

                        </div>

                    </div>

                    @* Leaflet-kartet opprettes i dette HTML-elementet. *@
                    <div id="situationMap"></div>

                </section>

                @* HURTIGOVERSIKT: Viser eksempler på
                   aktive behov og tilgjengelige ressurser. *@
                <section class="public-bottom-grid">

                    <article class="summary-card">

                        <span class="eyebrow">
                            PRIORITERT
                        </span>

                        <h3>
                            Aktive behov
                        </h3>

                        @* Eksempel på et akutt strømbehov. *@
                        <div class="summary-item">

                            <span class="summary-icon urgent">
                                !
                            </span>

                            <div>

                                <strong>
                                    Strømbehov
                                </strong>

                                <p>
                                    Aggregat nødvendig ved
                                    midlertidig mottakssenter.
                                </p>

                                <small>
                                    Kristiansand · Akutt
                                </small>

                            </div>

                        </div>

                        @* Eksempel på et planlagt transportbehov. *@
                        <div class="summary-item">

                            <span class="summary-icon planned">
                                !
                            </span>

                            <div>

                                <strong>
                                    Transportkapasitet
                                </strong>

                                <p>
                                    Behov for kjøretøy til
                                    planlagt transport.
                                </p>

                                <small>
                                    Vennesla · Planlagt
                                </small>

                            </div>

                        </div>

                    </article>

                    <article class="summary-card">

                        <span class="eyebrow">
                            RESSURSER
                        </span>

                        <h3>
                            Tilgjengelig kapasitet
                        </h3>

                        @* Eksempel på en tilgjengelig strømressurs. *@
                        <div class="summary-item">

                            <span class="summary-icon resource">
                                A
                            </span>

                            <div>

                                <strong>
                                    Aggregat 25 kVA
                                </strong>

                                <p>
                                    Midlertidig strømforsyning.
                                </p>

                                <small>
                                    Kristiansand · Tilgjengelig
                                </small>

                            </div>

                        </div>

                        @* Eksempel på en tilgjengelig transportressurs. *@
                        <div class="summary-item">

                            <span class="summary-icon resource">
                                T
                            </span>

                            <div>

                                <strong>
                                    Transport
                                </strong>

                                <p>
                                    Kjøretøy tilgjengelig for
                                    transportoppdrag.
                                </p>

                                <small>
                                    Kristiansand · Tilgjengelig
                                </small>

                            </div>

                        </div>

                        @* Lenke til alle registrerte ressurser. *@
                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview"
                            class="summary-link">

                            Se alle ressurser →

                        </a>

                    </article>

                </section>

            </main>

        </div>

    </div>
}

</body>
</html>
