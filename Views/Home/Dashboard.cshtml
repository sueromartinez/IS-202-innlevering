                    `
                )
                .addTo(
                    actorLayer
                );


                /*
                 * FILTERE
                 */

                setupToggle(
                    "showResources",
                    resourceLayer
                );


                setupToggle(
                    "showUrgent",
                    urgentLayer
                );


                setupToggle(
                    "showPlanned",
                    plannedLayer
                );


                setupToggle(
                    "showActors",
                    actorLayer
                );


                function setupToggle(
                    checkboxId,
                    layer
                ) {

                    const checkbox =
                        document.getElementById(
                            checkboxId
                        );


                    if (!checkbox)
                    {
                        return;
                    }


                    checkbox.addEventListener(
                        "change",
                        function () {

                            if (checkbox.checked)
                            {
                                if (
                                    !map.hasLayer(
                                        layer
                                    )
                                )
                                {
                                    layer.addTo(
                                        map
                                    );
                                }
                            }
                            else
                            {
                                if (
                                    map.hasLayer(
                                        layer
                                    )
                                )
                                {
                                    map.removeLayer(
                                        layer
                                    );
                                }
                            }

                        }
                    );

                }


                /*
                 * Leaflet trenger noen ganger en
                 * oppdatering når layouten er ferdig.
                 */

                window.setTimeout(
                    function () {

                        map.invalidateSize();

                    },
                    100
                );

            }
        );

    </script>
}


</body>

</html>