@model FirstWebAppInDocker.ViewModels.MatchNeedViewModel
@using FirstWebAppInDocker.Services
@*
    Koordinering av ett behov: finn ressurser i nærheten, send
    forespørsler og følg dem opp til behovet er løst.

    Stilen ligger i wwwroot/css/need-coord.css.
*@
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Koordinering – behov";

    var need = Model.Need;
    bool isResolved = need.Status == NeedStatus.Resolved;
    bool isAcute = need.Priority == NeedPriority.Acute;
    string typeName = EnumDisplay.Name(need.ResourceType);

    int totalRequests = Model.Assignments.Count;
    int pendingRequests = Model.Assignments.Count(a => a.Status == AssignmentStatus.Requested);
    int confirmedRequests = Model.Assignments.Count(a => a.Status == AssignmentStatus.Confirmed);

    // Hvor behovet står i flyten: 1 finn ressurs, 2 venter, 3 bekreftet, 4 løst.
    int stage =
        isResolved ? 4
        : confirmedRequests > 0 ? 3
        : pendingRequests > 0 ? 2
        : 1;

    string coordinationStatus = stage switch
    {
        4 => "Løst",
        3 => "Bekreftet",
        2 => "Venter på svar",
        _ => "Trenger matching"
    };

    string coordinationStatusClass = stage switch
    {
        4 => "resolved",
        3 => "confirmed",
        2 => "waiting",
        _ => "matching"
    };

    // Fanen som vises først. «Finn ressurser» står først så lenge behovet er åpent.
    string defaultTab = isResolved || (totalRequests > 0 && Model.Candidates.Count == 0)
        ? "requests"
        : "resources";

    string requestedTab = Context.Request.Query["tab"].ToString();

    if (!isResolved && (requestedTab == "requests" || requestedTab == "resources"))
    {
        defaultTab = requestedTab;
    }

    string NeedStatusClass(NeedStatus status) => status switch
    {
        NeedStatus.UnderReview => "status-review",
        NeedStatus.Assigned => "status-assigned",
        NeedStatus.Resolved => "status-resolved",
        _ => "status-new"
    };

    string AssignmentStatusClass(AssignmentStatus status) => status switch
    {
        AssignmentStatus.Confirmed => "status-confirmed",
        AssignmentStatus.Declined => "status-declined",
        AssignmentStatus.Cancelled => "status-cancelled",
        _ => "status-requested"
    };

    string AssignmentCardClass(AssignmentStatus status) => status switch
    {
        AssignmentStatus.Confirmed => "is-confirmed",
        AssignmentStatus.Declined => "is-declined",
        AssignmentStatus.Cancelled => "is-cancelled",
        _ => "is-pending"
    };

    // «for 3 timer siden», «for 11 dager siden»
    string TimeAgo(DateTime utc)
    {
        TimeSpan age = DateTime.UtcNow - utc;
        if (age.TotalMinutes < 1) return "akkurat nå";
        if (age.TotalHours < 1) return $"for {(int)age.TotalMinutes} min siden";
        if (age.TotalDays < 1) return $"for {(int)age.TotalHours} t siden";
        int days = (int)age.TotalDays;
        return days == 1 ? "for 1 dag siden" : $"for {days} dager siden";
    }

    // Hva brukeren bør gjøre nå.
    (string Label, string Text) nextStep = stage switch
    {
        1 when Model.Candidates.Count > 0 =>
            ("Neste steg:", "velg en ressurs og send forespørsel. Eieren får varsel og må bekrefte at hen kan stille."),
        1 =>
            ("Neste steg:", "ingen ledige ressurser i nærheten. Utvid søkeradiusen eller spør Sami om alternativer."),
        2 =>
            ("Neste steg:", "vent på svar. Du får varsel når eieren svarer, og kan sende til flere for å være sikker."),
        3 =>
            ("Neste steg:", "avtal detaljene med eieren (se Forespørsler), og marker behovet som løst når hjelpen er på plass."),
        _ =>
            ("Behovet er løst.", "Bekreftede ressurser er ledige igjen.")
    };

    bool deadlinePassed = need.Deadline.HasValue && need.Deadline.Value.Date < DateTime.Today && !isResolved;

    var radiusOptions = new[] { 10, 25, 50, 100, 200 };
    int? nextRadius = radiusOptions.Where(r => r > Model.RadiusKm + 0.1).Select(r => (int?)r).FirstOrDefault();

    // Posisjoner til kartet (settes i MatchController.Need).
    var positions = ViewData["CandidatePositions"] as Dictionary<int, double[]> ?? new();

    var mapCandidates = Model.Candidates
        .Select((candidate, index) => new
        {
            id = candidate.ResourceId,
            number = index + 1,
            name = candidate.ResourceName,
            distance = candidate.DistanceKm.ToString("0.0"),
            lat = positions.TryGetValue(candidate.ResourceId, out var p) ? p[0] : (double?)null,
            lng = positions.TryGetValue(candidate.ResourceId, out var q) ? q[1] : (double?)null
        })
        .Where(c => c.lat.HasValue)
        .ToList();

    string samiQuestion =
        $"Foreslå ressurser til behov #{need.Id} ({typeName}, {EnumDisplay.Name(need.Priority).ToLowerInvariant()}). "
        + "Se også om andre ressurstyper i nærheten kan hjelpe.";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/need-coord.css" asp-append-version="true" />
}

<div class="need-coord">

    <a asp-controller="Match" asp-action="Index" class="need-coord-back">← Tilbake til koordinering</a>

    <!-- ========================================
         TOPPKORT: HVA TRENGS
    ======================================== -->

    <section class="need-coord-card need-coord-hero @(isAcute ? "is-acute" : "is-planned")">

        <div class="need-coord-hero-top">

            <div>
                <span class="need-coord-eyebrow">Koordinering · Behov #@need.Id</span>

                <div class="need-coord-title-row">
                    <span class="need-coord-type-icon" aria-hidden="true">@Html.Raw(ResourceDisplay.Icon(need.ResourceType))</span>

                    <div>
                        <h1 class="need-coord-title">@typeName</h1>

                        <div class="need-coord-badges">
                            <span class="status-badge @(isAcute ? "priority-acute" : "priority-planned")">@EnumDisplay.Name(need.Priority)</span>
                            <span class="status-badge @NeedStatusClass(need.Status)">@EnumDisplay.Name(need.Status)</span>
                        </div>
                    </div>
                </div>

                <p class="need-coord-description">@need.Description</p>
            </div>

            <span class="need-coord-state @coordinationStatusClass">@coordinationStatus</span>

        </div>

        <dl class="need-coord-facts">

            <div class="need-coord-fact">
                <dt>Antall etterspurt</dt>
                <dd>@need.Quantity</dd>
            </div>

            <div class="need-coord-fact">
                <dt>Registrert</dt>
                <dd>
                    @need.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    <small>@TimeAgo(need.CreatedAt)</small>
                </dd>
            </div>

            @if (need.Deadline.HasValue)
            {
                <div class="need-coord-fact">
                    <dt>Frist</dt>
                    <dd class="@(deadlinePassed ? "need-coord-overdue" : "")">
                        @need.Deadline.Value.ToString("dd.MM.yyyy")
                        @if (deadlinePassed)
                        {
                            <small>Fristen er passert</small>
                        }
                    </dd>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(need.ContactName) || !string.IsNullOrWhiteSpace(need.ContactPhone))
            {
                <div class="need-coord-fact">
                    <dt>Kontaktpunkt</dt>
                    <dd>
                        @need.ContactName
                        @if (!string.IsNullOrWhiteSpace(need.ContactPhone))
                        {
                            <small><a href="tel:@need.ContactPhone">@need.ContactPhone</a></small>
                        }
                    </dd>
                </div>
            }

        </dl>

        @if (!isResolved)
        {
            <div class="need-coord-hero-actions">
                <form asp-controller="Match" asp-action="Resolve" method="post"
                      onsubmit="return confirm('Markere behovet som løst? Bekreftede ressurser blir ledige igjen.');">
                    <input type="hidden" name="needId" value="@need.Id" />
                    <button type="submit" class="need-coord-secondary">✓ Marker behovet som løst</button>
                </form>
            </div>
        }

    </section>

    <!-- ========================================
         FREMDRIFT: HVOR STÅR BEHOVET
    ======================================== -->

    <ol class="need-coord-card need-coord-steps" aria-label="Fremdrift for behovet">
        @{
            var steps = new[]
            {
                (Title: "Finn ressurs", Sub: Model.Candidates.Count == 1 ? "1 i nærheten" : $"{Model.Candidates.Count} i nærheten"),
                (Title: "Venter på svar", Sub: $"{pendingRequests} venter"),
                (Title: "Bekreftet", Sub: $"{confirmedRequests} bekreftet"),
                (Title: "Løst", Sub: isResolved ? "Ferdig" : "Ikke ennå")
            };
        }

        @for (int i = 0; i < steps.Length; i++)
        {
            int number = i + 1;
            string stepClass = number < stage || (number == 4 && isResolved) ? "is-done" : number == stage ? "is-current" : "";

            <li class="need-coord-step @stepClass" aria-current="@(number == stage ? "step" : null)">
                <span class="need-coord-step-dot">@(number < stage || (number == 4 && isResolved) ? "✓" : number.ToString())</span>
                <span class="need-coord-step-text">
                    <strong>@steps[i].Title</strong>
                    @steps[i].Sub
                </span>
            </li>
        }
    </ol>

    <p class="need-coord-next"><strong>@nextStep.Label</strong> @nextStep.Text</p>

    @if (TempData["MatchMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    @if (TempData["MatchError"] is string error)
    {
        <div class="alert alert-error" role="alert">@error</div>
    }

    <!-- ========================================
         FANER: FINN RESSURSER / FORESPØRSLER
    ======================================== -->

    <section class="need-coord-card need-coord-workspace">

        <div class="need-coord-tabs" role="tablist" aria-label="Behovshåndtering">

            @if (!isResolved)
            {
                <button type="button" role="tab" id="need-tab-resources" class="need-coord-tab"
                        data-need-tab="resources" aria-controls="need-panel-resources"
                        aria-selected="@(defaultTab == "resources" ? "true" : "false")"
                        tabindex="@(defaultTab == "resources" ? "0" : "-1")">
                    Finn ressurser
                    <span class="need-coord-tab-count">@Model.Candidates.Count</span>
                </button>
            }

            <button type="button" role="tab" id="need-tab-requests" class="need-coord-tab"
                    data-need-tab="requests" aria-controls="need-panel-requests"
                    aria-selected="@(defaultTab == "requests" ? "true" : "false")"
                    tabindex="@(defaultTab == "requests" ? "0" : "-1")">
                Forespørsler
                <span class="need-coord-tab-count">@totalRequests</span>
            </button>

        </div>

        <!-- ====================================
             FANE: FINN RESSURSER
        ==================================== -->

        @if (!isResolved)
        {
            <section id="need-panel-resources" class="need-coord-panel" role="tabpanel"
                     aria-labelledby="need-tab-resources" data-need-panel="resources"
                     hidden="@(defaultTab != "resources")">

                <div class="need-coord-panel-top">
                    <div>
                        <h2>Ledige ressurser i nærheten</h2>
                        <p class="need-coord-hint">
                            Ressurser av typen «@typeName», nærmeste først. Velg en eller flere og send forespørsel.
                        </p>
                    </div>

                    <button type="button" class="need-coord-secondary need-coord-sami-button" data-sami-ask="@samiQuestion">
                        Spør Sami om forslag
                    </button>
                </div>

                <nav class="need-coord-radius" aria-label="Søkeradius">
                    <span class="need-coord-radius-label">Søkeradius</span>
                    <span class="need-coord-radius-options">
                        @foreach (int radius in radiusOptions)
                        {
                            bool selected = Math.Abs(radius - Model.RadiusKm) < 0.1;
                            <a href="@Url.Action("Need", "Match", new { id = need.Id, radiusKm = radius, tab = "resources" })"
                               aria-current="@(selected ? "true" : null)">@radius km</a>
                        }
                    </span>
                </nav>

                @if (Model.Candidates.Count == 0)
                {
                    <div class="need-coord-empty">
                        <h3>Ingen ledige ressurser innen @Model.RadiusKm.ToString("0") km</h3>
                        <p>
                            Det finnes ingen tilgjengelige ressurser av typen «@typeName» i dette området
                            som ikke allerede har fått forespørsel.
                        </p>
                        <div class="need-coord-empty-actions">
                            @if (nextRadius.HasValue)
                            {
                                <a class="need-coord-send" href="@Url.Action("Need", "Match", new { id = need.Id, radiusKm = nextRadius.Value, tab = "resources" })">
                                    Utvid til @nextRadius.Value km
                                </a>
                            }
                            <button type="button" class="need-coord-secondary need-coord-sami-button" data-sami-ask="@samiQuestion">
                                Spør Sami om alternativer
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="need-coord-match">

                        <div class="need-coord-list">
                            @for (int i = 0; i < Model.Candidates.Count; i++)
                            {
                                var candidate = Model.Candidates[i];
                                int number = i + 1;
                                string messageId = $"melding-{candidate.ResourceId}";
                                string? address = ResourceDisplay.PrettyAddress(candidate.Address);

                                <article class="need-coord-resource" data-resource-id="@candidate.ResourceId">

                                    <div class="need-coord-resource-top">
                                        <span class="need-coord-resource-number" aria-hidden="true">@number</span>

                                        <div class="need-coord-resource-head">
                                            <h3 class="need-coord-resource-name">@candidate.ResourceName</h3>
                                            @if (!string.IsNullOrWhiteSpace(address))
                                            {
                                                <span class="need-coord-resource-address">@address</span>
                                            }
                                        </div>

                                        <span class="need-coord-distance">@candidate.DistanceKm.ToString("0.0") km</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(candidate.Description))
                                    {
                                        <p class="need-coord-resource-description">@candidate.Description</p>
                                    }

                                    <ul class="need-coord-chips">
                                        <li><strong>Antall</strong> @candidate.Quantity stk</li>
                                        @if (!string.IsNullOrWhiteSpace(candidate.Capacity))
                                        {
                                            <li><strong>Kapasitet</strong> @candidate.Capacity</li>
                                        }
                                        <li><strong>Tilgjengelig</strong> @(candidate.Availability ?? "Ikke oppgitt")</li>
                                    </ul>

                                    <form asp-controller="Match" asp-action="SendRequest" method="post" class="need-coord-resource-form">
                                        <input type="hidden" name="needId" value="@need.Id" />
                                        <input type="hidden" name="resourceId" value="@candidate.ResourceId" />

                                        <div class="need-coord-resource-actions">
                                            @if (mapCandidates.Any(c => c.id == candidate.ResourceId))
                                            {
                                                <button type="button" class="need-coord-ghost" data-show-on-map="@candidate.ResourceId">Vis i kart</button>
                                            }
                                            <button type="button" class="need-coord-ghost" data-toggle-message="@messageId" aria-expanded="false" aria-controls="@messageId">
                                                + Legg til melding
                                            </button>
                                            <button type="submit" class="need-coord-send">Send forespørsel</button>
                                        </div>

                                        <div class="need-coord-message" id="@messageId" hidden>
                                            <label for="@(messageId)-text">Melding til eieren (valgfritt)</label>
                                            <textarea id="@(messageId)-text" name="message" maxlength="500"
                                                      placeholder="F.eks. oppmøtested, tidspunkt eller hva ressursen skal brukes til."></textarea>
                                            <small>Maks 500 tegn. Eieren ser meldingen sammen med forespørselen.</small>
                                        </div>
                                    </form>

                                </article>
                            }
                        </div>

                        <div class="need-coord-map-wrap">
                            <div id="needCoordMap" class="need-coord-map" role="region" aria-label="Kart over behovet og ressursene"></div>
                            <div class="need-coord-map-legend">
                                <span><i style="background:@(isAcute ? "#d34b4b" : "#d99a24")"></i>Behovet</span>
                                <span><i style="background:#23855b"></i>Ledige ressurser</span>
                                <span>Sirkel = søkeradius @Model.RadiusKm.ToString("0") km</span>
                            </div>
                        </div>

                    </div>
                }

            </section>
        }

        <!-- ====================================
             FANE: FORESPØRSLER
        ==================================== -->

        <section id="need-panel-requests" class="need-coord-panel" role="tabpanel"
                 aria-labelledby="need-tab-requests" data-need-panel="requests"
                 hidden="@(defaultTab != "requests")">

            <div class="need-coord-panel-top">
                <div>
                    <h2>Sendte forespørsler</h2>
                    <p class="need-coord-hint">
                        Eierne får varsel i portalen og på e-post, og må bekrefte at de kan stille.
                        Kontaktinformasjonen deres står her.
                    </p>
                </div>
            </div>

            @if (Model.Assignments.Count == 0)
            {
                <div class="need-coord-empty">
                    <h3>Ingen forespørsler sendt ennå</h3>
                    <p>Finn en ledig ressurs i nærheten og send en forespørsel.</p>
                    @if (!isResolved)
                    {
                        <div class="need-coord-empty-actions">
                            <button type="button" class="need-coord-send" data-switch-to-resources>Finn ressurser</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="need-coord-list">
                    @foreach (var assignment in Model.Assignments)
                    {
                        <article class="need-coord-request @AssignmentCardClass(assignment.Status)">

                            <div class="need-coord-request-top">
                                <div>
                                    <h3 class="need-coord-request-name">@assignment.ResourceName</h3>
                                    <span class="need-coord-request-type">@EnumDisplay.Name(assignment.ResourceType)</span>
                                </div>
                                <span class="status-badge @AssignmentStatusClass(assignment.Status)">@EnumDisplay.Name(assignment.Status)</span>
                            </div>

                            <div class="need-coord-request-meta">
                                <div>
                                    <span class="need-coord-meta-label">E-post</span>
                                    <span class="need-coord-meta-value">
                                        @if (!string.IsNullOrWhiteSpace(assignment.ContactEmail))
                                        {
                                            <a href="mailto:@assignment.ContactEmail">@assignment.ContactEmail</a>
                                        }
                                        else
                                        {
                                            <text>Ikke oppgitt</text>
                                        }
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(assignment.ContactPhone))
                                {
                                    <div>
                                        <span class="need-coord-meta-label">Telefon</span>
                                        <span class="need-coord-meta-value"><a href="tel:@assignment.ContactPhone">@assignment.ContactPhone</a></span>
                                    </div>
                                }

                                <div>
                                    <span class="need-coord-meta-label">Sendt</span>
                                    <span class="need-coord-meta-value">@assignment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>

                                @if (assignment.RespondedAt.HasValue)
                                {
                                    <div>
                                        <span class="need-coord-meta-label">Besvart</span>
                                        <span class="need-coord-meta-value">@assignment.RespondedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(assignment.Message))
                            {
                                <p class="need-coord-request-message">«@assignment.Message»</p>
                            }

                            <div class="need-coord-request-footer">
                                <span>@(assignment.SuggestedByAssistant ? "✦ Foreslått av Sami" : "Sendt manuelt")</span>

                                @if (!isResolved && assignment.Status is AssignmentStatus.Requested or AssignmentStatus.Confirmed)
                                {
                                    <form asp-controller="Match" asp-action="Cancel" method="post"
                                          onsubmit="return confirm('Er du sikker på at du vil avbryte denne forespørselen?');">
                                        <input type="hidden" name="assignmentId" value="@assignment.Id" />
                                        <input type="hidden" name="needId" value="@need.Id" />
                                        <button type="submit" class="need-coord-cancel">Avbryt forespørsel</button>
                                    </form>
                                }
                            </div>

                        </article>
                    }
                </div>
            }

        </section>

    </section>

</div>

@section Scripts {
    @if (mapCandidates.Count > 0)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="~/js/kartverket.js" asp-append-version="true"></script>
    }

    <script>
        (function () {
            "use strict";

            // ---------- FANER ----------
            const tabs = Array.from(document.querySelectorAll("[data-need-tab]"));
            const panels = document.querySelectorAll("[data-need-panel]");
            let mapReady = null;

            function activateTab(name, moveFocus) {
                tabs.forEach(function (tab) {
                    const selected = tab.dataset.needTab === name;
                    tab.setAttribute("aria-selected", selected ? "true" : "false");
                    tab.tabIndex = selected ? 0 : -1;
                    if (selected && moveFocus) tab.focus();
                });

                panels.forEach(function (panel) {
                    panel.hidden = panel.dataset.needPanel !== name;
                });

                // Kartet må få vite at det har blitt synlig.
                if (name === "resources" && mapReady) {
                    mapReady();
                }
            }

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () { activateTab(tab.dataset.needTab, false); });

                tab.addEventListener("keydown", function (event) {
                    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                    event.preventDefault();
                    const index = tabs.indexOf(tab);
                    const next = (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
                    activateTab(tabs[next].dataset.needTab, true);
                });
            });

            document.querySelectorAll("[data-switch-to-resources]").forEach(function (button) {
                button.addEventListener("click", function () { activateTab("resources", true); });
            });

            // ---------- MELDING TIL EIEREN ----------
            document.querySelectorAll("[data-toggle-message]").forEach(function (button) {
                button.addEventListener("click", function () {
                    const box = document.getElementById(button.dataset.toggleMessage);
                    const open = box.hidden;
                    box.hidden = !open;
                    button.setAttribute("aria-expanded", open ? "true" : "false");
                    button.textContent = open ? "− Fjern melding" : "+ Legg til melding";

                    const textarea = box.querySelector("textarea");
                    if (open) {
                        textarea.focus();
                    } else {
                        textarea.value = "";
                    }
                });
            });

            // Hindrer dobbeltklikk som sender to forespørsler.
            document.querySelectorAll(".need-coord-resource-form").forEach(function (form) {
                form.addEventListener("submit", function () {
                    const button = form.querySelector("button[type=submit]");
                    button.disabled = true;
                    button.textContent = "Sender …";
                });
            });

            // ---------- KART ----------
            const mapElement = document.getElementById("needCoordMap");
            if (!mapElement || typeof L === "undefined") return;

            const need = {
                lat: @need.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
                lng: @need.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
                color: "@(isAcute ? "#d34b4b" : "#d99a24")",
                radiusKm: @Model.RadiusKm.ToString(System.Globalization.CultureInfo.InvariantCulture)
            };

            const candidates = @Json.Serialize(mapCandidates);

            // Kartet må ha et sentrum før noe legges på det (ellers kaster Leaflet en feil).
            // Zoom med musehjul eller to fingre på touchpaden når musen er over kartet.
            const map = L.map(mapElement, { scrollWheelZoom: true, wheelPxPerZoomLevel: 90 })
                .setView([need.lat, need.lng], 10);

            addKartverketLayers(map);

            const radius = L.circle([need.lat, need.lng], {
                radius: need.radiusKm * 1000,
                color: need.color,
                weight: 1.5,
                fillOpacity: 0.06,
                dashArray: "6 6"
            }).addTo(map);

            L.marker([need.lat, need.lng], {
                title: "Behovet",
                zIndexOffset: 1000,
                icon: L.divIcon({
                    className: "",
                    html: "<div class='need-coord-need-pin' style='background:" + need.color + ";'></div>",
                    iconSize: [40, 40],
                    iconAnchor: [20, 40]
                })
            }).addTo(map).bindTooltip("Behovet: " + @Json.Serialize(typeName), { direction: "top", offset: [0, -36] });

            const markers = {};

            // Området som skal vises: hele søkeradiusen pluss alle ressursene.
            const bounds = L.latLng(need.lat, need.lng).toBounds(need.radiusKm * 2000);

            candidates.forEach(function (c) {
                const marker = L.marker([c.lat, c.lng], {
                    title: c.name,
                    icon: L.divIcon({
                        className: "",
                        html: "<div class='need-coord-pin' data-pin='" + c.id + "' style='background:#23855b;'>" + c.number + "</div>",
                        iconSize: [30, 30],
                        iconAnchor: [15, 15]
                    })
                }).addTo(map);

                marker.bindTooltip(c.number + ". " + c.name + " · " + c.distance + " km", { direction: "top", offset: [0, -14] });
                marker.on("click", function () { highlight(c.id, true); });
                markers[c.id] = marker;
                bounds.extend([c.lat, c.lng]);
            });

            map.fitBounds(bounds, { padding: [24, 24] });

            function highlight(id, scrollToCard) {
                document.querySelectorAll(".need-coord-resource").forEach(function (card) {
                    card.classList.toggle("is-highlighted", card.dataset.resourceId === String(id));
                });
                document.querySelectorAll("[data-pin]").forEach(function (pin) {
                    pin.classList.toggle("is-highlighted", pin.dataset.pin === String(id));
                });

                if (scrollToCard) {
                    const card = document.querySelector(".need-coord-resource[data-resource-id='" + id + "']");
                    if (card) card.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            }

            document.querySelectorAll(".need-coord-resource").forEach(function (card) {
                card.addEventListener("mouseenter", function () { highlight(card.dataset.resourceId, false); });
            });

            document.querySelectorAll("[data-show-on-map]").forEach(function (button) {
                button.addEventListener("click", function () {
                    const id = button.dataset.showOnMap;
                    const marker = markers[id];
                    if (!marker) return;
                    map.setView(marker.getLatLng(), Math.max(map.getZoom(), 12));
                    marker.openTooltip();
                    highlight(id, false);
                    if (window.innerWidth <= 980) {
                        mapElement.scrollIntoView({ behavior: "smooth", block: "center" });
                    }
                });
            });

            // ---------- FULLSKJERM ----------
            // Bruker nettleserens fullskjerm. Der den ikke finnes (f.eks. iPhone),
            // fyller kartet hele vinduet i stedet.
            const expandIcon =
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>';
            const collapseIcon =
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6"/></svg>';

            let fullscreenButton = null;

            function isFullscreen() {
                return document.fullscreenElement === mapElement
                    || mapElement.classList.contains("is-fullscreen");
            }

            function updateFullscreenButton() {
                const on = isFullscreen();
                const label = on ? "Avslutt fullskjerm (Esc)" : "Vis kartet i fullskjerm";
                fullscreenButton.innerHTML = on ? collapseIcon : expandIcon;
                fullscreenButton.title = label;
                fullscreenButton.setAttribute("aria-label", label);
                fullscreenButton.setAttribute("aria-pressed", on ? "true" : "false");
                document.body.classList.toggle("need-coord-map-open", mapElement.classList.contains("is-fullscreen"));

                // Kartet må regne ut størrelsen sin på nytt.
                requestAnimationFrame(function () { map.invalidateSize(); });
            }

            function toggleFullscreen() {
                if (isFullscreen()) {
                    if (document.fullscreenElement) {
                        document.exitFullscreen();
                    } else {
                        mapElement.classList.remove("is-fullscreen");
                        updateFullscreenButton();
                    }
                    return;
                }

                if (mapElement.requestFullscreen) {
                    mapElement.requestFullscreen().catch(function () {
                        mapElement.classList.add("is-fullscreen");
                        updateFullscreenButton();
                    });
                } else {
                    mapElement.classList.add("is-fullscreen");
                    updateFullscreenButton();
                }
            }

            const FullscreenControl = L.Control.extend({
                options: { position: "topright" },
                onAdd: function () {
                    const control = L.DomUtil.create("div", "leaflet-bar need-coord-fullscreen-control");
                    fullscreenButton = L.DomUtil.create("button", "", control);
                    fullscreenButton.type = "button";
                    L.DomEvent.disableClickPropagation(control);
                    L.DomEvent.on(fullscreenButton, "click", toggleFullscreen);
                    return control;
                }
            });

            new FullscreenControl().addTo(map);
            updateFullscreenButton();

            document.addEventListener("fullscreenchange", updateFullscreenButton);

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && mapElement.classList.contains("is-fullscreen")) {
                    mapElement.classList.remove("is-fullscreen");
                    updateFullscreenButton();
                }
            });

            // Hvis kartet var skjult da siden lastet (annen fane), tegnes det på nytt når fanen åpnes.
            mapReady = function () {
                setTimeout(function () {
                    map.invalidateSize();
                    map.fitBounds(bounds, { padding: [24, 24] });
                }, 0);
            };
        })();
    </script>
}
