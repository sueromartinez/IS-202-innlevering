
@model List<FirstWebAppInDocker.ViewModels.AdminUserViewModel>
@using FirstWebAppInDocker.Data

@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Brukere";

    string RoleLabel(string role) => role switch
    {
        IdentitySeeder.AdminRole => "Administrator",
        IdentitySeeder.PublicActorRole => "Offentlig aktør",
        IdentitySeeder.ResourceProviderRole => "Ressursleverandør",
        _ => role
    };

    var roleOptions = new[]
    {
        IdentitySeeder.ResourceProviderRole,
        IdentitySeeder.PublicActorRole,
        IdentitySeeder.AdminRole
    };
}

<style>
    /* ========================================
       KLIKKBART BRUKERNAVN
    ======================================== */

    .admin-user-link {
        display: inline-block;
        color: #173954;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s;
    }

    .admin-user-link:hover {
        color: #0284c7;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .admin-user-link:focus-visible {
        outline: 2px solid #0284c7;
        outline-offset: 4px;
        border-radius: 2px;
    }

    .admin-user-link:after {
        content: " ↗";
        font-size: 12px;
        color: #6d91ac;
    }

    .admin-user-link:hover:after {
        color: #0284c7;
    }

    .admin-user-help {
        display: block;
        margin-top: 5px;
        font-size: 11px;
        color: #64809a;
    }

    /* ========================================
       RESSURSLENKE I HANDLINGER
    ======================================== */

    .admin-resource-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        min-height: 37px;
        padding: 9px 13px;
        border: 1px solid #92b9dd;
        border-radius: 8px;
        background: transparent;
        color: #245d85;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition:
            background 0.2s,
            color 0.2s;
    }

    .admin-resource-link:hover {
        background: #dcebf9;
        color: #075c95;
    }

    .admin-resource-link:focus-visible {
        outline: 2px solid #0284c7;
        outline-offset: 3px;
    }

    .admin-users-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
    }

    .admin-users-actions form {
        margin: 0;
    }
</style>

<!-- ========================================
     SIDEOVERSKRIFT
======================================== -->

<div class="page-top">

    <div>
        <span class="page-eyebrow">
            Administrasjon
        </span>

        <h1 class="page-heading">
            Brukere
        </h1>

        <p class="page-description">
            Opprett offentlige aktører, endre roller,
            deaktiver kontoer og se brukernes ressurser.

            Brukere deaktiveres i stedet for å slettes,
            slik at historikken beholdes.
        </p>
    </div>

    <div class="report-actions" style="display:flex;flex-wrap:wrap;gap:8px;">
        <a
            asp-controller="Admin"
            asp-action="AuditLog"
            class="secondary-action">

            Aktivitetslogg

        </a>

        <a
            asp-controller="Admin"
            asp-action="CreatePublicActor"
            class="primary-action">

            Opprett offentlig aktør

        </a>
    </div>

</div>

<!-- ========================================
     MELDINGER
======================================== -->

@if (TempData["AdminMessage"] is string message)
{
    <div
        class="alert alert-success"
        role="status">

        @message

    </div>
}

@if (TempData["AdminError"] is string error)
{
    <div
        class="alert alert-error"
        role="alert">

        @error

    </div>
}

<!-- ========================================
     BRUKEROVERSIKT
======================================== -->

<section class="app-card portal-section">

    <div class="table-wrap">

        <table class="portal-table">

            <thead>
                <tr>
                    <th scope="col">
                        Bruker
                    </th>

                    <th scope="col">
                        Rolle
                    </th>

                    <th scope="col">
                        Status
                    </th>

                    <th scope="col">
                        Opprettet
                    </th>

                    <th scope="col">
                        <span class="visually-hidden">
                            Handlinger
                        </span>
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <!-- ========================================
                             BRUKER
                        ======================================== -->

                        <td>

                            <!--
                                NYTT:
                                Klikk på brukernavnet
                                for å åpne ressursoversikten.
                            -->

                            <a
                                asp-controller="Admin"
                                asp-action="UserResources"
                                asp-route-userId="@user.Id"
                                class="admin-user-link"
                                title="Se ressurser for @user.Name">

                                @user.Name

                            </a>

                            <span class="cell-muted">
                                @user.Email
                            </span>

                            <span class="admin-user-help">
                                Klikk for å se brukerens ressurser
                            </span>

                        </td>

                        <!-- ========================================
                             ROLLE
                        ======================================== -->

                        <td>

                            @if (user.IsCurrentUser)
                            {
                                @RoleLabel(user.Role)

                                <span class="cell-muted">
                                    (deg)
                                </span>
                            }
                            else
                            {
                                <form
                                    asp-controller="Admin"
                                    asp-action="ChangeRole"
                                    method="post"
                                    class="inline-role-form">

                                    <input
                                        type="hidden"
                                        name="userId"
                                        value="@user.Id"
                                    />

                                    <label
                                        class="visually-hidden"
                                        for="role-@user.Id">

                                        Rolle for @user.Name

                                    </label>

                                    <select
                                        id="role-@user.Id"
                                        name="role"
                                        onchange="this.form.submit()">

                                        @foreach (string role in roleOptions)
                                        {
                                            <option
                                                value="@role"
                                                selected="@(role == user.Role)">

                                                @RoleLabel(role)

                                            </option>
                                        }

                                    </select>

                                    <noscript>
                                        <button
                                            type="submit"
                                            class="small-action">

                                            Lagre

                                        </button>
                                    </noscript>

                                </form>
                            }

                        </td>

                        <!-- ========================================
                             STATUS
                        ======================================== -->

                        <td>

                            @if (user.IsDeactivated)
                            {
                                <span
                                    class="status-badge status-locked">

                                    Deaktivert

                                </span>
                            }
                            else if (user.IsTemporarilyLocked)
                            {
                                <span
                                    class="status-badge status-requested">

                                    Midlertidig låst

                                </span>
                            }
                            else
                            {
                                <span
                                    class="status-badge status-available">

                                    Aktiv

                                </span>
                            }

                        </td>

                        <!-- ========================================
                             OPPRETTET
                        ======================================== -->

                        <td>
                            @user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                        </td>

                        <!-- ========================================
                             HANDLINGER
                        ======================================== -->

                        <td>

                            <div class="admin-users-actions">

                                <!--
                                    NYTT:
                                    Se ressurser-knapp.
                                -->

                                <a
                                    asp-controller="Admin"
                                    asp-action="UserResources"
                                    asp-route-userId="@user.Id"
                                    class="admin-resource-link">

                                    Se ressurser

                                </a>

                                <!-- ========================================
                                     REAKTIVER / LÅS OPP
                                ======================================== -->

                                @if (
                                    user.IsDeactivated
                                    || user.IsTemporarilyLocked
                                )
                                {
                                    <form
                                        asp-controller="Admin"
                                        asp-action="Reactivate"
                                        method="post">

                                        <input
                                            type="hidden"
                                            name="userId"
                                            value="@user.Id"
                                        />

                                        <button
                                            type="submit"
                                            class="small-action">

                                            @(user.IsDeactivated
                                                ? "Reaktiver"
                                                : "Lås opp")

                                        </button>

                                    </form>
                                }

                                <!-- ========================================
                                     DEAKTIVER
                                ======================================== -->

                                @if (
                                    !user.IsDeactivated
                                    && !user.IsCurrentUser
                                )
                                {
                                    <form
                                        asp-controller="Admin"
                                        asp-action="Deactivate"
                                        method="post"
                                        onsubmit="return confirm('Deaktivere denne brukeren? Brukeren blir logget ut og kan ikke logge inn.');">

                                        <input
                                            type="hidden"
                                            name="userId"
                                            value="@user.Id"
                                        />

                                        <button
                                            type="submit"
                                            class="danger-action">

                                            Deaktiver

                                        </button>

                                    </form>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>
