@using FirstWebAppInDocker.Data
@*
    Sami – hjelpeassistenten.
    Legges inn nederst på alle sider for innloggede brukere:
        <partial name="_Sami" />
    Partialen tar med sin egen CSS og JavaScript, slik at den fungerer
    både på sider med og uten felles layout.
*@
@if (User.Identity?.IsAuthenticated == true)
{
    string samiRole =
        User.IsInRole(IdentitySeeder.AdminRole) ? "admin"
        : User.IsInRole(IdentitySeeder.PublicActorRole) ? "public"
        : "volunteer";

    // Brukes bare til å holde samtalen adskilt mellom brukere i samme nettleser.
    string samiUserKey =
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "anon";

    <link rel="stylesheet" href="~/css/sami.css" asp-append-version="true" />

    <div class="sami"
         id="sami"
         data-role="@samiRole"
         data-user="@samiUserKey"
         data-chat-url="@Url.Action("Chat", "Sami")"
         data-request-url="@Url.Action("SendRequest", "Match")"
         data-register-resource-url="@(samiRole == "volunteer" ? Url.Action("RegisterResource", "Resource") : "")">

        @Html.AntiForgeryToken()

        @* Liten hilsen første gang, så folk ser at Sami finnes. *@
        <div class="sami-hint" id="samiHint" hidden>
            <p>Hei! Jeg er Sami. Spør meg hvis du lurer på noe i portalen.</p>
            <button type="button" class="sami-hint-close" aria-label="Lukk hilsenen">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
        </div>

        <button type="button"
                class="sami-launcher"
                id="samiLauncher"
                aria-controls="samiPanel"
                aria-expanded="false">
            <span class="sami-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5v-8Z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    <path d="M9.6 8.2a2.4 2.4 0 1 1 3.3 2.2c-.6.3-.9.7-.9 1.3v.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <circle cx="12" cy="14.1" r="1" fill="currentColor" />
                </svg>
            </span>
            <span class="sami-launcher-text">
                <strong>Spør Sami</strong>
                <span>Hjelpeassistent</span>
            </span>
        </button>

        <section class="sami-panel"
                 id="samiPanel"
                 role="dialog"
                 aria-modal="false"
                 aria-labelledby="samiTitle"
                 hidden>

            <header class="sami-header">
                <span class="sami-avatar sami-avatar-small" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5v-8Z"
                              stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M9.6 8.2a2.4 2.4 0 1 1 3.3 2.2c-.6.3-.9.7-.9 1.3v.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        <circle cx="12" cy="14.1" r="1" fill="currentColor" />
                    </svg>
                </span>
                <div class="sami-header-text">
                    <h2 id="samiTitle">Sami</h2>
                    <p>Hjelpeassistent i Beredskapsportalen</p>
                </div>
                <button type="button" class="sami-icon-button" id="samiReset" title="Start ny samtale" aria-label="Start ny samtale">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                        <path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button type="button" class="sami-icon-button" id="samiClose" aria-label="Lukk Sami">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </button>
            </header>

            <div class="sami-messages" id="samiMessages" aria-live="polite" aria-relevant="additions"></div>

            <div class="sami-starters" id="samiStarters" aria-label="Forslag til spørsmål"></div>

            <form class="sami-composer" id="samiForm">
                <label for="samiInput" class="sami-visually-hidden">Skriv til Sami</label>
                <textarea id="samiInput"
                          rows="1"
                          maxlength="2000"
                          placeholder="Skriv et spørsmål …"></textarea>
                <button type="submit" class="sami-send" id="samiSend" aria-label="Send">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                        <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </form>

            <p class="sami-footnote">Sami foreslår, du bestemmer. Sjekk viktige opplysninger selv. Ved fare for liv og helse: ring 112, 110 eller 113.</p>
        </section>
    </div>

    <script src="~/js/sami.js" asp-append-version="true"></script>
}
