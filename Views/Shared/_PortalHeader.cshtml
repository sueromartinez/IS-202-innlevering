@using FirstWebAppInDocker.Data
@* Felles toppmeny for alle innloggede sider: logo, meny og bruker *@
@{
    // Rollen hentes fra Identity, navnet fra økten
    string rolle = User.IsInRole(IdentitySeeder.AdminRole) ? "Administrator"
        : User.IsInRole(IdentitySeeder.PublicActorRole) ? "Offentlig aktør"
        : "Ressursleverandør";
}
<link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/portal-header.css" asp-append-version="true" />

<header class="pv-header">
    <a asp-controller="Home" asp-action="Dashboard" class="pv-brand">
        <img src="/images/logo.png" alt="Logo" class="pv-logo" />
        <span><strong>Beredskapsportal</strong><small>@rolle</small></span>
    </a>

    <partial name="_TopNavigation" />

    <div class="pv-user">
        <strong>@(Context.Session.GetString("UserName") ?? rolle)</strong>
        <small>@rolle</small>
    </div>
</header>
