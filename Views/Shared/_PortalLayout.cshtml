@using FirstWebAppInDocker.Data
@*
    Felles layout for de nye sidene (matching, forespørsler,
    varsler og admin). Bygger på designet i app.css og
    den felles menyen i _TopNavigation.
*@
@{
    string roleLabel =
        User.IsInRole(IdentitySeeder.AdminRole) ? "Administrator"
        : User.IsInRole(IdentitySeeder.PublicActorRole) ? "Offentlig aktør"
        : "Ressursleverandør";
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beredskapsportal</title>

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- Fargetema: lyst/mørkt tema -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <partial name="_PortalHeader" />

    <main class="app-main">
        @RenderBody()
    </main>

    <partial name="_Sami" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
