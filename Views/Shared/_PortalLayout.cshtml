@using FirstWebAppInDocker.Data
@*
    Felles layout for de nye sidene (matching, forespørsler,
    varsler og admin). Bygger på designet i app.css og
    den felles menyen i _TopNavigation.
*@
@{
    string roleLabel =
        User.IsInRole(IdentitySeeder.AdminRole) ? "Administrator"
        : User.IsInRole(IdentitySeeder.PublicActorRole) ? "Offentlig aktør"
        : "Ressursleverandør";
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beredskapsportal</title>

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="app-header portal-header">
        <a asp-controller="Home" asp-action="Dashboard" class="app-brand">
            <div class="app-brand-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2L4 5.5V11c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5.5L12 2Z"
                          fill="none" stroke="currentColor" stroke-width="1.7" />
                    <path d="M8.5 12.5L11 15l4.8-6" fill="none" stroke="currentColor"
                          stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <strong>Beredskapsportal</strong>
                <span>@roleLabel</span>
            </div>
        </a>

        <partial name="_TopNavigation" />
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <partial name="_Sami" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
