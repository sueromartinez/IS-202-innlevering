
@using FirstWebAppInDocker.Data

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var action =
        ViewContext.RouteData.Values["action"]?.ToString();

    var links = new List<(string Text, string Controller, string Action)>();

    bool isAdmin = User.IsInRole(IdentitySeeder.AdminRole);
    bool isPublicActor = User.IsInRole(IdentitySeeder.PublicActorRole);
    bool isProvider = User.IsInRole(IdentitySeeder.ResourceProviderRole);

    // OFFENTLIG AKTØR OG ADMINISTRATOR

    if (isPublicActor || isAdmin)
    {
        links.AddRange(new[]
        {
            ("Oversikt", "Home", "Dashboard"),
            ("Behov", "Need", "NeedOverview"),
            ("Registrer behov", "Need", "RegisterNeed"),
            ("Ressurser", "Resource", "ResourceOverview")
        });

        if (isAdmin)
        {
            links.Add(("Brukere", "Admin", "Users"));
        }

        // Matching og Tildelinger samles her.
        links.Add(("Koordinering", "Match", "Index"));

        // Situasjonsrapport, ressursliste per kommune og eksport.
        links.Add(("Rapporter", "Report", "Index"));

        // Profil skal være siste vanlige menyvalg.
        links.Add(("Profil", "Account", "Profile"));
    }

    // RESSURSLEVERANDØR – UENDRET

    else if (isProvider)
    {
        links.AddRange(new[]
        {
            ("Oversikt", "Home", "Dashboard"),
            ("Mine ressurser", "Resource", "ResourceOverview"),
            ("Registrer ressurs", "Resource", "RegisterResource"),
            ("Forespørsler", "Request", "Index"),
            ("Behov jeg kan hjelpe med", "Request", "MatchingNeeds"),
            ("Profil", "Account", "Profile")
        });
    }
}

@if (links.Count > 0)
{
    <nav class="portal-top-navigation" aria-label="Brukermeny">

        @foreach (var link in links)
        {
            bool sameController = string.Equals(
                controller,
                link.Controller,
                StringComparison.OrdinalIgnoreCase
            );

            bool sameAction = string.Equals(
                action,
                link.Action,
                StringComparison.OrdinalIgnoreCase
            );

            bool active =
                (sameController && sameAction)

                || (
                    link.Controller == "Need"
                    && link.Action == "NeedOverview"
                    && controller == "Need"
                    && action == "EditNeed"
                )

                || (
                    link.Controller == "Admin"
                    && controller == "Admin"
                )

                || (
                    link.Controller == "Report"
                    && controller == "Report"
                )

                || (
                    link.Controller == "Match"
                    && link.Action == "Index"
                    && controller == "Match"
                    && (
                        action == "Need"
                        || action == "Assignments"
                    )
                );

            <a
                asp-controller="@link.Controller"
                asp-action="@link.Action"
                aria-current="@(active ? "page" : null)">

                @link.Text

            </a>
        }

        @await Component.InvokeAsync("NotificationBell")

        <form
            asp-controller="Account"
            asp-action="Logout"
            method="post">

            <button type="submit">
                Logg ut
            </button>

        </form>

    </nav>
}
