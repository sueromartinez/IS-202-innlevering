@{
    string? userEmail = Context.Session.GetString("UserEmail");
    string? userRole = Context.Session.GetString("UserRole");

    bool isLoggedIn = !string.IsNullOrWhiteSpace(userEmail);
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        @ViewData["Title"] - Beredskapsportal
    </title>

    <link
        rel="stylesheet"
        href="~/css/site.css"
        asp-append-version="true"
    />

</head>

<body>

    <header class="site-header">

        <div class="site-header-inner">

            <a
                asp-controller="Home"
                asp-action="Index"
                class="site-logo">

                <span class="site-logo-icon">
                    ✓
                </span>

                <span class="site-logo-text">

                    <strong>
                        Beredskapsportal
                    </strong>

                    <small>
                        TOTALFORSVARET
                    </small>

                </span>

            </a>


            @if (!isLoggedIn)
            {
                <nav class="public-nav">

                    <a href="/#howItWorks">
                        Slik fungerer det
                    </a>

                    <a
                        href="/#loginSection"
                        class="nav-login-button">

                        Logg inn

                    </a>

                </nav>
            }
            else
            {
                <nav class="logged-nav">

                    <a
                        asp-controller="Home"
                        asp-action="Dashboard">

                        Oversikt

                    </a>


                    @if (userRole == "ResourceProvider")
                    {
                        <a
                            asp-controller="Resource"
                            asp-action="RegisterResource">

                            Registrer ressurs

                        </a>

                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview">

                            Mine ressurser

                        </a>

                        <a
                            asp-controller="Account"
                            asp-action="Profile">

                            Profil

                        </a>
                    }


                    @if (userRole == "PublicActor")
                    {
                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview">

                            Ressurser

                        </a>
                    }


                    <form
                        asp-controller="Account"
                        asp-action="Logout"
                        method="post">

                        <button
                            type="submit"
                            class="nav-logout-button">

                            Logg ut

                        </button>

                    </form>

                </nav>
            }

        </div>

    </header>


    <main>

        @RenderBody()

    </main>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>