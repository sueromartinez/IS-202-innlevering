@{
    string? userEmail =
        Context.Session.GetString("UserEmail");

    string? userRole =
        Context.Session.GetString("UserRole");

    bool isLoggedIn =
        !string.IsNullOrWhiteSpace(userEmail);
}

<!DOCTYPE html>

<html lang="no">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        @ViewData["Title"] - Beredskapsportal
    </title>


    <!-- Felles design fra recovered 8080-versjonen -->
    <link
        rel="stylesheet"
        href="~/css/app.css"
        asp-append-version="true"
    />

    <link
        rel="stylesheet"
        href="~/css/site.css"
        asp-append-version="true"
    />

</head>


<body>

    <header class="site-header">

        <div class="site-header-inner">

            <!-- LOGO -->
            <a
                asp-controller="Home"
                asp-action="Index"
                class="site-logo">

                <span class="site-logo-icon">

                    <svg
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true">

                        <path
                            d="M12 3L19 6V11C19 15.55 16.02 19.74 12 21C7.98 19.74 5 15.55 5 11V6L12 3Z"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                        />

                        <path
                            d="M9 12L11 14L15 10"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                    </svg>

                </span>


                <span class="site-logo-text">

                    <strong>
                        Beredskapsportal
                    </strong>

                    <small>
                        TOTALFORSVARET
                    </small>

                </span>

            </a>


            <!-- OFFENTLIG NAVIGASJON -->
            @if (!isLoggedIn)
            {
                <nav
                    class="public-nav"
                    aria-label="Hovedmeny">

                    <a href="/#howItWorks">
                        Slik fungerer det
                    </a>

                    <a
                        href="/#loginSection"
                        class="nav-login-button">

                        Logg inn

                    </a>

                </nav>
            }


            <!-- INNLOGGET NAVIGASJON -->
            @if (isLoggedIn)
            {
                <nav
                    class="logged-nav"
                    aria-label="Brukermeny">

                    <a
                        asp-controller="Home"
                        asp-action="Dashboard">

                        Oversikt

                    </a>


                    @if (userRole == "ResourceProvider")
                    {
                        <a
                            asp-controller="Resource"
                            asp-action="RegisterResource">

                            Registrer ressurs

                        </a>

                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview">

                            Mine ressurser

                        </a>

                        <a
                            asp-controller="Account"
                            asp-action="Profile">

                            Profil

                        </a>
                    }


                    @if (userRole == "PublicActor")
                    {
                        <a
                            asp-controller="Resource"
                            asp-action="ResourceOverview">

                            Ressurser

                        </a>
                    }


                    <form
                        asp-controller="Account"
                        asp-action="Logout"
                        method="post">

                        <button
                            type="submit"
                            class="nav-logout-button">

                            Logg ut

                        </button>

                    </form>

                </nav>
            }

        </div>

    </header>


    <main>

        @RenderBody()

    </main>


    <script
        src="~/js/site.js"
        asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>