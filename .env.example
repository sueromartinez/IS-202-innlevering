# .env.example – mal for .env
#
# Hva filen gjør: Kopier til .env og fyll inn egne passord og eventuelt API-nøkkel. .env
# ligger i .gitignore, så hemmeligheter aldri havner i Git.
#
# Oppgavekrav: 3


# ============================================================
# BEREDSKAPSPORTALEN – EKSEMPEL PÅ MILJØVARIABLER
# ============================================================
#
# Kopier denne filen til .env og fyll inn passordene.
#
# .env skal aldri legges til i Git.
# .env.example skal ikke inneholde ekte passord eller API-nøkler.
#
# Dette oppsettet gjelder lokal utvikling med Docker Compose.
# ============================================================

# MariaDB
# Bruk forskjellige, sterke passord for databasebruker og root.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Administrator
# Opprettes ved første oppstart dersom kontoen ikke finnes.
# Bruk et unikt passord på minst 16 tegn.
# Et senere passordbytte i .env endrer ikke eksisterende konto.
ADMIN_EMAIL=admin@beredskap.no
ADMIN_PASSWORD=Admin123!

# Sami AI-assistent
# Ollama kjører lokalt og trenger ingen API-nøkkel.
# Claude krever en egen API-nøkkel.
SAMI_PROVIDER=Ollama
SAMI_OLLAMA_MODEL=qwen2.5:7b


PUBLIC_ACTOR_PASSWORD=Test123!


# Valgfritt: Aktiver bare ved bruk av Claude.
# ANTHROPIC_API_KEY=